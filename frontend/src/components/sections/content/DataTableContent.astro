---
import type {DataTableData} from '@/types/sanity'

interface Props {
  data: DataTableData
}

const {data} = Astro.props

const headers = data.headers || []
const cellPadding = data.compact ? 'px-3 py-1.5' : 'px-4 py-3'
---

{
  headers.length > 0 && (
    <figure class="my-4">
      <div class="overflow-x-auto rounded-xl border border-border">
        <table class="w-full text-left text-sm">
          {data.caption && (
            <caption class="bg-card px-4 py-3 text-left text-sm font-medium text-foreground">
              {data.caption}
            </caption>
          )}

          <thead>
            <tr class="border-b border-border bg-foreground/5">
              {headers.map((header) => (
                <th
                  scope="col"
                  class={`${cellPadding} text-xs font-semibold uppercase tracking-wider text-muted`}
                >
                  {header.text}
                </th>
              ))}
            </tr>
          </thead>

          <tbody class="divide-y divide-border">
            {data.rows?.map((row, rowIndex) => (
              <tr class={data.striped && rowIndex % 2 === 1 ? 'bg-foreground/[0.02]' : 'bg-card'}>
                {headers.map((_, cellIndex) => (
                  <td class={`${cellPadding} text-card-foreground`}>
                    {row.cells?.[cellIndex]?.text ?? ''}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </figure>
  )
}
