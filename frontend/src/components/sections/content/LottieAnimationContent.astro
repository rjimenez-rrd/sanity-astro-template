---
import type {LottieAnimationData} from '@/types/sanity'

interface Props {
  data: LottieAnimationData
}

const {data} = Astro.props
---

{
  data.url && (
    <div class="my-4">
      <div
        class="flex min-h-[200px] items-center justify-center rounded-lg border border-dashed border-border bg-card"
        data-lottie
        data-url={data.url}
        data-loop={data.loop !== false ? 'true' : 'false'}
        data-autoplay={data.autoplay !== false ? 'true' : 'false'}
        data-speed={typeof data.speed === 'number' ? String(data.speed) : undefined}
      >
        {/* Placeholder shown until lottie-web loads (or permanently if not installed) */}
        <div class="text-center text-sm text-muted">
          <p class="mb-2">Lottie Animation</p>
          <p class="text-xs opacity-60">Install lottie-web to enable</p>
        </div>
      </div>
      {data.alt && <p class="mt-2 text-center text-sm text-muted">{data.alt}</p>}
    </div>
  )
}

<script>
  const containers = document.querySelectorAll<HTMLElement>('[data-lottie]')
  if (containers.length > 0) {
    // lottie-web stays an optional dependency: if it is not installed the
    // placeholder simply remains, exactly as before. The specifier is held in
    // a variable and marked @vite-ignore so the bundler does not try to
    // resolve a package that may not exist — the Vite counterpart to the
    // webpackIgnore comment this used to carry.
    const LOTTIE_MODULE = 'lottie-web'

    import(/* @vite-ignore */ LOTTIE_MODULE)
      .then(({default: lottie}) => {
        containers.forEach((container) => {
          const url = container.dataset.url
          if (!url) return

          container.innerHTML = ''

          const animation = lottie.loadAnimation({
            container,
            renderer: 'svg',
            loop: container.dataset.loop !== 'false',
            autoplay: container.dataset.autoplay !== 'false',
            path: url,
          })

          const speed = Number(container.dataset.speed)
          if (speed > 0) animation.setSpeed?.(speed)
        })
      })
      .catch(() => {
        /* lottie-web is not installed; placeholder remains */
      })
  }
</script>
