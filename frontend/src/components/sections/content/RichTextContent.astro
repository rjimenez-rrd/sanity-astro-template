---
import PortableTextRenderer from '@/components/shared/PortableTextRenderer.astro'
import type {RichTextBlockData} from '@/types/sanity'
import type {HTMLAttributes} from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  data: RichTextBlockData
}

const {data, class: className, ...attrs} = Astro.props

const classes = ['prose prose-slate max-w-none', className].filter(Boolean).join(' ')
---

{
  data.content && (
    <div {...attrs} class={classes}>
      <PortableTextRenderer value={data.content} />
    </div>
  )
}
