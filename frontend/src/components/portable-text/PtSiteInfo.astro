---
/**
 * The site's phone placed mid-sentence in rich text (studio site-info.ts):
 * as displayed, e.g. (833) SANDERS, or as the number. It comes from Site
 * Settings at render time, so changing it there updates every page, and it
 * takes the surrounding text's styling.
 */
import {stegaClean} from '@sanity/client/stega'
import type {Props as PtProps} from 'astro-portabletext/types'
import PhoneLink from '@/components/ui/PhoneLink.astro'
import {getSiteInfo, siteInfoText} from '@/sanity/lib/siteInfo'

type Props = PtProps<{_type: string; key?: string}>

const {node} = Astro.props
const info = await getSiteInfo(Astro.locals)
const text = siteInfoText(info, stegaClean(node.key))
---

<PhoneLink
  phone={info.phone}
  text={text}
  class="whitespace-nowrap underline underline-offset-2 hover:text-primary/80"
/>
