---
import {stegaClean} from '@sanity/client/stega'
import {slugify, blockText} from '@/lib/portableText'
import type {BlockProps} from 'astro-portabletext/types'

type Props = BlockProps

const {node} = Astro.props

// Margins, not padding: a heading opening or closing its block adds no space
// there, so the block's container decides it. Fonts and sizes are the
// original site's: Baskervville for H1, H2 and H4, Montserrat for H3.
const CLASSES: Record<string, string> = {
  h1: 'font-heading mt-12 mb-5 first:mt-0 last:mb-0 text-[40px] leading-none md:text-[68px] md:leading-[69px] font-semibold scroll-mt-20',
  h2: 'font-heading mt-12 mb-5 first:mt-0 last:mb-0 text-[30px] leading-none md:text-[52px] md:leading-[1.2] font-semibold scroll-mt-20',
  h3: 'font-display mt-12 mb-5 first:mt-0 last:mb-0 text-[25px] leading-none md:text-[36px] md:leading-[45px] font-semibold scroll-mt-20',
  h4: 'font-heading mt-12 mb-5 first:mt-0 last:mb-0 text-[28px] leading-[38px] font-semibold scroll-mt-20',
}

const style = stegaClean(node.style) ?? 'h2'
const Tag = (style in CLASSES ? style : 'h2') as 'h1' | 'h2' | 'h3' | 'h4'
const id = slugify(blockText(node))
---

<Tag id={id || undefined} class={CLASSES[Tag]}><slot /></Tag>
