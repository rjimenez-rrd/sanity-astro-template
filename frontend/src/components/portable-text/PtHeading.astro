---
import {stegaClean} from '@sanity/client/stega'
import {slugify, blockText} from '@/lib/portableText'
import type {BlockProps} from 'astro-portabletext/types'

type Props = BlockProps

const {node} = Astro.props

const CLASSES: Record<string, string> = {
  h1: 'mb-5 font-display text-5xl md:text-6xl lg:text-[90px] font-bold scroll-mt-20',
  h2: 'mb-4 text-3xl md:text-4xl lg:text-5xl font-bold scroll-mt-20',
  h3: 'mb-3 text-2xl md:text-3xl lg:text-4xl font-semibold scroll-mt-20',
  h4: 'mb-2 text-xl md:text-2xl lg:text-3xl font-semibold scroll-mt-20',
}

const style = stegaClean(node.style) ?? 'h2'
const Tag = (style in CLASSES ? style : 'h2') as 'h1' | 'h2' | 'h3' | 'h4'
const id = slugify(blockText(node))
---

<Tag id={id || undefined} class={CLASSES[Tag]}><slot /></Tag>
