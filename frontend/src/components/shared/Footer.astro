const siteName = settings?.siteName || 'Page Builder'
const columns = settings?.footerColumns ?? []
const socialLinks = (settings?.socialLinks ?? []).filter(
  (link) => typeof link.platform === 'string' && link.platform.length > 0,
)
const footerStyle = stegaClean(settings?.footerStyle) || 'default'

const styleClass = FOOTER_STYLES[footerStyle] || FOOTER_STYLES.default
const isDark = footerStyle === 'dark'
const textMuted = isDark ? 'text-background/60' : 'text-muted'
const textHeading = isDark ? 'text-background' : 'text-foreground'
const borderClass = isDark ? 'border-background/10' : 'border-border'
const hoverClass = isDark ? 'hover:text-background' : 'hover:text-foreground'
const year = new Date().getFullYear()
---

<footer class={styleClass}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_auto_auto_auto_1fr]">
      {/* Brand column */}
      <div>
        <a href="/" class={`inline-flex items-center gap-2 font-bold text-lg ${textHeading}`}>
          {
            settings?.logo?.asset ? (
              <SanityImage
                value={settings.logo}
                alt={stegaClean(settings.logo.alt) || siteName}
                width={120}
                height={40}
                class={`h-8 w-auto ${isDark ? 'brightness-0 invert' : ''}`}
              />
            ) : (
              <span>{siteName}</span>
            )
          }
        </a>
        {
          settings?.footerDescription && (
            <p class={`mt-4 max-w-xs text-sm leading-relaxed ${textMuted}`}>
              {settings.footerDescription}
            </p>
          )
        }

        {
          socialLinks.length > 0 && (
            <div class="mt-6 flex gap-3">
              {socialLinks.map((link) => {
                const platform = stegaClean(link.platform)!
                const path = SOCIAL_ICONS[platform]
                return (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`flex h-9 w-9 items-center justify-center rounded-lg border ${borderClass} ${textMuted} transition-colors ${hoverClass}`}
                    aria-label={platform}
                  >
                    {path ? (
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d={path} />
                      </svg>
                    ) : (
                      <span class="text-xs font-bold">{platform.slice(0, 2).toUpperCase()}</span>
                    )}
                  </a>
                )
              })}
            </div>
          )
        }
      </div>

      {/* Link columns */}
      {
        columns.map((column) => (
          <div class="min-w-[120px]">
            <h3 class={`text-sm font-semibold ${textHeading}`}>{column.title}</h3>
            {column.links && column.links.length > 0 && (
              <ul class="mt-4 space-y-3">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class={`text-sm ${textMuted} transition-colors ${hoverClass}`}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }

      {/* Newsletter */}
      <div>
        <h3 class={`text-sm font-semibold ${textHeading}`}>Stay up to date</h3>
        <p class={`mt-2 text-sm ${textMuted}`}>Subscribe to our newsletter for updates.</p>
        <form class="mt-4 flex gap-2" data-newsletter>
          <input
            type="email"
            placeholder="Enter your email"
            class={`flex-1 rounded-full border ${borderClass} bg-transparent px-4 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary`}
          />
          <button
            type="submit"
            class="rounded-full bg-primary px-5 py-2 text-sm font-medium text-primary-foreground transition-colors hover:opacity-90"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>

    {/* Bottom bar */}
    <div class={`mt-12 border-t ${borderClass} pt-6`}>
      <p class={`text-center text-xs ${textMuted}`}>
        &copy; {year} {siteName}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<script>
  // Placeholder, as in the original: the newsletter form has no endpoint yet
  // and simply swallows the submit instead of navigating.
  document
    .querySelectorAll<HTMLFormElement>('[data-newsletter]')
    .forEach((form) => form.addEventListener('submit', (event) => event.preventDefault()))
</script>
