---
import {stegaClean} from '@sanity/client/stega'
import Container from './sections/Container.astro'
import type {PageBuilderBlock} from '@/types/sanity'

interface Props {
  sections?: PageBuilderBlock[] | null
  /** Document coordinates, so a section can be selected in Presentation. */
  documentId?: string | null
  documentType?: string | null
}

const {sections, documentId, documentType} = Astro.props
---

{
  !sections || sections.length === 0 ? (
    <div class="flex min-h-[40vh] items-center justify-center text-muted">
      <p>No sections yet. Open the Studio to start building.</p>
    </div>
  ) : (
    sections.map((section) => {
      const type = stegaClean(section._type)
      if (type === 'gridRow') {
        return (
          <Container
            data={section as Extract<PageBuilderBlock, {_type: 'gridRow'}>}
            documentId={documentId}
            documentType={documentType}
          />
        )
      }
      return (
        <div class="border border-dashed border-border bg-card/50 p-8 text-center text-sm text-muted">
          Unknown section type: <code>{section._type}</code>
        </div>
      )
    })
  )
}
