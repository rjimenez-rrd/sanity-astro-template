---
import SanityImage from '@/components/sanity/SanityImage.astro'
import type {TestimonialQuoteData} from '@/types/sanity'
import {t} from '@/lib/i18n'

interface Props {
  data: TestimonialQuoteData
}

const {data} = Astro.props

const validRating =
  typeof data.rating === 'number' && data.rating >= 1 && data.rating <= 5 ? data.rating : 0
const stars = Math.max(0, Math.min(5, Math.round(validRating)))
const STAR_PATH =
  'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z'
---

{
  data.quote && (
    <blockquote class="my-6 text-center">
      <span
        class="block text-6xl leading-none text-primary opacity-40 select-none"
        aria-hidden="true"
      >
        &ldquo;
      </span>

      <p class="mx-auto max-w-2xl text-lg leading-relaxed text-foreground italic md:text-xl">
        {data.quote}
      </p>

      {validRating > 0 && (
        <div class="mt-4 flex justify-center">
          <div class="flex gap-1" aria-label={t(Astro.locals.language, 'stars', {rating: stars})}>
            {Array.from({length: 5}, (_, i) => (
              <svg
                class={`h-5 w-5 ${i < stars ? 'text-amber-400' : 'text-border'}`}
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path d={STAR_PATH} />
              </svg>
            ))}
          </div>
        </div>
      )}

      <footer class="mt-6 flex items-center justify-center gap-4">
        {data.avatar?.asset && (
          <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full">
            <SanityImage
              value={data.avatar}
              width={96}
              height={96}
              class="h-full w-full object-cover"
            />
          </div>
        )}

        {(data.name || data.title) && (
          <div class="text-left">
            {data.name && (
              <cite class="block text-sm font-semibold not-italic text-foreground">
                {data.name}
              </cite>
            )}
            {data.title && <span class="block text-sm text-muted">{data.title}</span>}
          </div>
        )}
      </footer>
    </blockquote>
  )
}
