---
import {stegaClean} from '@sanity/client/stega'
import SanityImage from '@/components/sanity/SanityImage.astro'
import type {TestimonialQuoteData} from '@/types/sanity'
import StarRating from '@/components/ui/StarRating.astro'

interface Props {
  data: TestimonialQuoteData
}

const {data} = Astro.props

const validRating =
  typeof data.rating === 'number' && data.rating >= 1 && data.rating <= 5 ? data.rating : 0
const stars = Math.max(0, Math.min(5, Math.round(validRating)))

/**
 * Style: Simple (just the text), Card (a panel with a small quote mark — the
 * Studio's default) or Large (big quote marks and larger text).
 */
const STYLES = {
  simple: {root: 'my-6 text-center', mark: '', quote: 'text-lg md:text-xl'},
  card: {
    root: 'my-6 rounded-xl border border-border bg-card px-6 py-8 text-center shadow-sm sm:px-10',
    mark: 'text-5xl',
    quote: 'text-lg md:text-xl',
  },
  large: {root: 'my-6 text-center', mark: 'text-8xl', quote: 'text-xl md:text-2xl'},
}
const style = STYLES[stegaClean(data.style) as keyof typeof STYLES] ?? STYLES.card
---

{
  data.quote && (
    <blockquote class={style.root}>
      {style.mark && (
        <span
          class={`block leading-none text-primary opacity-40 select-none ${style.mark}`}
          aria-hidden="true"
        >
          &ldquo;
        </span>
      )}

      <p class={`mx-auto max-w-2xl leading-relaxed text-foreground italic ${style.quote}`}>
        {data.quote}
      </p>

      {validRating > 0 && (
        <div class="mt-4 flex justify-center">
          <StarRating
            rating={stars}
            class="flex gap-1"
            starClass="h-5 w-5"
            onClass="text-amber-400"
            offClass="text-border"
          />
        </div>
      )}

      <footer class="mt-6 flex items-center justify-center gap-4">
        {data.avatar?.asset && (
          <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full">
            <SanityImage
              value={data.avatar}
              width={96}
              height={96}
              class="h-full w-full object-cover"
            />
          </div>
        )}

        {(data.name || data.title) && (
          <div class="text-left">
            {data.name && (
              <cite class="block text-sm font-semibold not-italic text-foreground">
                {data.name}
              </cite>
            )}
            {data.title && <span class="block text-sm text-muted">{data.title}</span>}
          </div>
        )}
      </footer>
    </blockquote>
  )
}
