---
/**
 * The Video block: YouTube, Vimeo, Dailymotion, VideoPress or a self-hosted
 * file, with Elementor's options. An Image Overlay covers the player until
 * clicked; the player only loads then, already playing.
 */
import {stegaClean} from '@sanity/client/stega'
import SanityImage from '@/components/sanity/SanityImage.astro'
import {aspectRatio, videoPlayer, type VideoSettings} from '@/lib/video'
import {cssFilter} from '@/lib/design'
import {urlFor} from '@/sanity/lib/image'
import type {VideoData} from '@/types/sanity'
import {t} from '@/lib/i18n'

/** The two video blocks this one replaced, until their content is moved over. */
type LegacyVideo = {
  _type: 'youtubeVideo' | 'externalVideo'
  url?: string | null
  autoplay?: boolean | null
  loop?: boolean | null
  muted?: boolean | null
}

interface Props {
  data: VideoData | LegacyVideo
}

const {data} = Astro.props
const type = stegaClean(data._type)

const settings: VideoSettings =
  type === 'youtubeVideo'
    ? {source: 'youtube', url: stegaClean((data as LegacyVideo).url), privacyMode: true}
    : type === 'externalVideo'
      ? {
          source: 'hosted',
          hostedExternal: true,
          hostedUrl: stegaClean((data as LegacyVideo).url),
          autoplay: (data as LegacyVideo).autoplay,
          loop: (data as LegacyVideo).loop,
          mute: (data as LegacyVideo).muted,
        }
      : (stegaClean(data) as VideoSettings)

const video = type === 'video' ? (data as VideoData) : undefined
const overlay = video?.imageOverlay?.enabled && video.imageOverlay.image?.asset ? video.imageOverlay : undefined

// With an overlay the player waits for the click, then starts playing.
const player = videoPlayer(settings, {play: Boolean(overlay)})

const style = stegaClean(video?.videoStyle)
const ratio = aspectRatio(style?.aspectRatio)
const filter = cssFilter(style?.cssFilters)
// A self-hosted file keeps its own shape unless a ratio is picked.
const boxed = player?.kind === 'embed' || Boolean(style?.aspectRatio)
const boxStyle = [boxed && `aspect-ratio:${ratio}`, filter && `filter:${filter}`].filter(Boolean).join(';')

const controls = settings.controls !== false
// Self Hosted -> Poster: the picture shown before the video plays.
const poster = video?.poster?.asset ? urlFor(video.poster as never).width(1600).auto('format').url() : undefined
const fileSrc =
  player?.kind === 'file' && player.start ? `${player.src}#t=${player.start}${player.end ? `,${player.end}` : ''}` : player?.src
---

{
  player && (
    <div class="pb-video" data-pb-video data-boxed={boxed ? '' : undefined} style={boxStyle || undefined}>
      {player.kind === 'embed' ? (
        <iframe
          src={overlay ? undefined : player.src}
          data-src={overlay ? player.src : undefined}
          title={player.title}
          loading={settings.lazyLoad && !overlay ? 'lazy' : undefined}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          allowfullscreen
        />
      ) : (
        <video
          src={overlay ? undefined : fileSrc}
          data-src={overlay ? fileSrc : undefined}
          data-start={player.start}
          data-end={player.end}
          data-loop={settings.loop ? '' : undefined}
          controls={controls}
          autoplay={!overlay && Boolean(settings.autoplay)}
          muted={Boolean(settings.mute)}
          loop={Boolean(settings.loop) && !player.end}
          playsinline
          preload={overlay ? 'none' : 'metadata'}
          poster={poster}
          controlslist={settings.download ? undefined : 'nodownload'}
        />
      )}

      {overlay && (
        <button type="button" class="pb-video-overlay" data-pb-video-play aria-label={t(Astro.locals.language, 'playVideo')}>
          <SanityImage value={overlay.image} fill sizes="(max-width: 768px) 100vw, 800px" alt={overlay.image?.alt ?? ''} />
          {overlay.playIcon !== false && (
            <span class="pb-video-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="100%" height="100%" fill="currentColor">
                <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.98-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z" />
              </svg>
            </span>
          )}
        </button>
      )}
    </div>
  )
}

<style>
  .pb-video {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #000;
    /* Style -> Border -> Border Radius (BlockRenderer sets --pb-radius). */
    border-radius: var(--pb-radius, 0);
  }
  .pb-video iframe,
  .pb-video[data-boxed] video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .pb-video[data-boxed] video {
    object-fit: contain;
  }
  .pb-video:not([data-boxed]) video {
    display: block;
    width: 100%;
  }
  .pb-video-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: #000;
  }
  .pb-video-icon {
    position: relative;
    width: 72px;
    height: 72px;
    color: #fff;
    filter: drop-shadow(0 2px 8px rgb(0 0 0 / 0.5));
    transition: transform 0.2s ease;
  }
  .pb-video-overlay:hover .pb-video-icon {
    transform: scale(1.1);
  }
</style>

<script>
  /**
   * Image Overlay: the click loads the player (already set to play) and lifts
   * the image. Self-hosted files with an End Time: stop there, or loop back
   * to the Start Time.
   */
  document.querySelectorAll<HTMLElement>('[data-pb-video]').forEach((box) => {
    const player = box.querySelector<HTMLIFrameElement | HTMLVideoElement>('iframe, video')
    const cover = box.querySelector<HTMLButtonElement>('[data-pb-video-play]')

    cover?.addEventListener('click', () => {
      if (!player?.dataset.src) return
      player.src = player.dataset.src
      if (player instanceof HTMLVideoElement) void player.play().catch(() => {})
      cover.remove()
    })

    if (player instanceof HTMLVideoElement && player.dataset.end) {
      const start = Number(player.dataset.start) || 0
      const end = Number(player.dataset.end)
      player.addEventListener('timeupdate', () => {
        if (player.currentTime < end) return
        if (!player.hasAttribute('data-loop')) return player.pause()
        // The #t=start,end address pauses at the end by itself, so play again.
        player.currentTime = start
        void player.play().catch(() => {})
      })
    }
  })
</script>
