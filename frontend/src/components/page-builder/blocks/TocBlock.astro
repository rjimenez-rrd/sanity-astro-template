---
/**
 * Table of Contents: a white card with a header (a chevron that collapses the
 * list, and the title in Baskervville) over a numbered list of the page's h2s.
 */
import type {TocBlockData} from '@/types/sanity'
import {fontStack} from '@/lib/fonts'

interface Props {
  data: TocBlockData
}

const {data} = Astro.props

const title = data.title || 'Table of Contents'
const titleFont = fontStack('Baskervville')
---

{/* Headings are discovered from the rendered document, so the list is filled
    on the client. The nav is hidden until it finds at least one heading. */}
<nav class="bg-white" data-toc hidden>
  <div class="flex items-center gap-6 border-b border-border px-5 py-4">
    <button
      type="button"
      class="shrink-0 rounded-full text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      aria-expanded="true"
      aria-label={`Collapse ${title}`}
      data-toc-toggle
    >
      <svg class="h-6 w-6 transition-transform duration-200" viewBox="0 0 24 24" aria-hidden="true" data-toc-chevron>
        <circle cx="12" cy="12" r="12" fill="currentColor" />
        <path d="M7.5 14 12 9.5l4.5 4.5" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <h3 class="text-[27px] leading-tight text-foreground" style={`font-family:${titleFont}`}>{title}</h3>
  </div>
  <ol
    class="list-decimal space-y-[22px] pt-5 pb-10 pl-14 pr-6 font-display text-[17px] leading-7 text-foreground marker:text-primary"
    data-toc-list
  ></ol>
</nav>

<script>
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[data-toc-list]')
    if (!list) return

    // Only the page's h2s: the TOC lists sections, not their sub-headings.
    const headings = Array.from(document.querySelectorAll<HTMLElement>('h2[id]'))
    if (headings.length === 0) return

    for (const heading of headings) {
      const li = document.createElement('li')
      li.className = 'pl-1.5'

      // Full text, wrapped as needed: a long heading takes more than one line rather than being cut.
      const a = document.createElement('a')
      a.href = `#${heading.id}`
      a.textContent = heading.textContent || ''
      a.className = 'transition-colors hover:text-primary'

      li.appendChild(a)
      list.appendChild(li)
    }

    root.hidden = false

    // The chevron collapses the list; pointing down while it's closed.
    const toggle = root.querySelector<HTMLButtonElement>('[data-toc-toggle]')
    const chevron = root.querySelector<SVGElement>('[data-toc-chevron]')
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true'
      toggle.setAttribute('aria-expanded', String(open))
      toggle.setAttribute('aria-label', toggle.getAttribute('aria-label')!.replace(/^\w+/, open ? 'Collapse' : 'Expand'))
      list.hidden = !open
      chevron?.classList.toggle('rotate-180', !open)
    })
  })
</script>
