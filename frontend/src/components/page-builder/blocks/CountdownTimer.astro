---
/**
 * Countdown Timer, in one of three Display Styles:
 * - large:   centered, big number boxes (a banner)
 * - compact: one strip — heading, smaller boxes and the button side by side
 * - inline:  left-aligned plain numbers that sit within surrounding content
 */
import {stegaClean} from '@sanity/client/stega'
import CallToAction from './CallToAction.astro'
import {safeColor} from '@/lib/cssValues'
import {t} from '@/lib/i18n'
import type {CountdownTimerData} from '@/types/sanity'

interface Props {
  data: CountdownTimerData
}

const {data} = Astro.props
const language = Astro.locals.language

const expiredMessage = data.expiredMessage || t(language, 'eventEnded')
const hideWhenExpired = data.hideWhenExpired === true

function computeTimeRemaining(targetDate: string) {
  const difference = new Date(targetDate).getTime() - Date.now()
  if (difference <= 0) return {days: 0, hours: 0, minutes: 0, seconds: 0, isExpired: true}
  return {
    days: Math.floor(difference / (1000 * 60 * 60 * 24)),
    hours: Math.floor((difference / (1000 * 60 * 60)) % 24),
    minutes: Math.floor((difference / (1000 * 60)) % 60),
    seconds: Math.floor((difference / 1000) % 60),
    isExpired: false,
  }
}

// Rendered server-side so the first paint already shows a countdown; the
// script then corrects for the gap between build and page view.
const initial = data.targetDate
  ? computeTimeRemaining(data.targetDate)
  : {days: 0, hours: 0, minutes: 0, seconds: 0, isExpired: true}

const UNITS = [
  {key: 'days', label: t(language, 'days')},
  {key: 'hours', label: t(language, 'hours')},
  {key: 'minutes', label: t(language, 'minutes')},
  {key: 'seconds', label: t(language, 'seconds')},
] as const

const style = (['large', 'compact', 'inline'] as const).find((s) => s === stegaClean(data.style)) ?? 'large'

// The block's own colors. With a Text Color, every part takes it (muted parts
// a little lighter) instead of the theme's colors; with a Background Color the
// block gets padding so the text doesn't touch the edge.
const background = safeColor(stegaClean(data.backgroundColor))
const textColor = safeColor(stegaClean(data.textColor))
const colorStyle =
  [background && `background-color:${background}`, textColor && `color:${textColor}`]
    .filter(Boolean)
    .join(';') || undefined
const ink = {
  heading: textColor ? '' : 'text-foreground',
  muted: textColor ? 'opacity-75' : 'text-muted',
  number: textColor ? '' : 'text-primary',
  box: textColor ? 'bg-current/10' : 'bg-primary/10',
}

const LAYOUT = {
  large: {
    root: 'text-center',
    padding: 'rounded-lg px-6 py-10',
    body: 'flex flex-col items-center',
    units: 'flex items-center justify-center gap-3 sm:gap-4',
    box: 'h-16 w-16 rounded-lg text-2xl sm:h-20 sm:w-20 sm:text-3xl',
    separator: 'text-2xl',
    cta: 'mt-8',
  },
  compact: {
    root: 'text-center sm:text-left',
    padding: 'rounded-lg px-6 py-4',
    body: 'flex flex-wrap items-center justify-center gap-x-8 gap-y-4 sm:justify-between',
    units: 'flex items-center gap-2',
    box: 'h-12 w-12 rounded-md text-xl',
    separator: 'text-xl',
    cta: '',
  },
  inline: {
    root: 'text-left',
    padding: 'rounded-lg px-5 py-4',
    body: 'flex flex-col items-start',
    units: 'flex flex-wrap items-baseline gap-x-4 gap-y-1',
    box: 'text-2xl',
    separator: '',
    cta: 'mt-4',
  },
}[style]

const hasHeading = Boolean(data.title || data.subtitle)
const visible = !(hideWhenExpired && initial.isExpired)
---

{
  data.targetDate && visible && (
    <div
      class={[LAYOUT.root, background && LAYOUT.padding].filter(Boolean).join(' ')}
      style={colorStyle}
      data-countdown
      data-target={data.targetDate}
      data-hide-expired={hideWhenExpired ? '' : undefined}
    >
      <div class={LAYOUT.body}>
        {hasHeading && (
          <div class={style === 'large' ? 'mb-6' : style === 'inline' ? 'mb-3' : ''}>
            {data.title && <h3 class={`text-xl font-semibold ${ink.heading}`}>{data.title}</h3>}
            {data.subtitle && <p class={`mt-1 ${ink.muted}`}>{data.subtitle}</p>}
          </div>
        )}

        <p class={`text-lg ${ink.muted}`} data-countdown-expired hidden={!initial.isExpired}>
          {expiredMessage}
        </p>

        <div class={LAYOUT.units} data-countdown-units hidden={initial.isExpired}>
          {UNITS.map((unit, index) =>
            style === 'inline' ? (
              <span>
                <span class={`font-bold tabular-nums ${LAYOUT.box} ${ink.number}`} data-unit={unit.key}>
                  {String(initial[unit.key]).padStart(2, '0')}
                </span>{' '}
                <span class={`text-sm ${ink.muted}`}>{unit.label}</span>
              </span>
            ) : (
              <>
                {index > 0 && <span class={`font-bold ${LAYOUT.separator} ${ink.muted}`}>:</span>}
                <div class="flex flex-col items-center">
                  <div
                    class={`flex items-center justify-center font-bold tabular-nums ${LAYOUT.box} ${ink.box} ${ink.number}`}
                    data-unit={unit.key}
                  >
                    {String(initial[unit.key]).padStart(2, '0')}
                  </div>
                  <span class={`mt-2 text-xs font-medium uppercase tracking-wider ${ink.muted}`}>
                    {unit.label}
                  </span>
                </div>
              </>
            ),
          )}
        </div>

        {data.cta?.label && (
          <div class={LAYOUT.cta}>
            <CallToAction data={data.cta} />
          </div>
        )}
      </div>
    </div>
  )
}

<script>
  function compute(target: string) {
    const difference = new Date(target).getTime() - Date.now()
    if (difference <= 0) return {days: 0, hours: 0, minutes: 0, seconds: 0, isExpired: true}
    return {
      days: Math.floor(difference / (1000 * 60 * 60 * 24)),
      hours: Math.floor((difference / (1000 * 60 * 60)) % 24),
      minutes: Math.floor((difference / (1000 * 60)) % 60),
      seconds: Math.floor((difference / 1000) % 60),
      isExpired: false,
    }
  }

  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
    const target = root.dataset.target
    if (!target) return

    const expired = root.querySelector<HTMLElement>('[data-countdown-expired]')
    const units = root.querySelector<HTMLElement>('[data-countdown-units]')

    const tick = () => {
      const time = compute(target)

      if (time.isExpired) {
        // Hide When Expired: the whole block goes, not just the numbers.
        if (root.hasAttribute('data-hide-expired')) root.hidden = true
        if (expired) expired.hidden = false
        if (units) units.hidden = true
        clearInterval(interval)
        return
      }

      if (expired) expired.hidden = true
      if (units) units.hidden = false

      for (const key of ['days', 'hours', 'minutes', 'seconds'] as const) {
        const el = root.querySelector<HTMLElement>(`[data-unit="${key}"]`)
        if (el) el.textContent = String(time[key]).padStart(2, '0')
      }
    }

    const interval = setInterval(tick, 1000)
    tick()
  })
</script>
