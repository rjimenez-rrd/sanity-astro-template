---
/**
 * Accordion: expandable panels with an optional heading. The rows are the
 * shared Disclosure (also the FAQ's); one panel open at a time unless "Allow
 * multiple open" is on.
 */
import Disclosure from '@/components/ui/Disclosure.astro'
import type {AccordionData} from '@/types/sanity'
import {t} from '@/lib/i18n'

interface Props {
  data: AccordionData
}

const {data} = Astro.props

const items = (data.panels || []).map((panel) => ({
  key: panel._key,
  title: panel.title ?? '',
  content: panel.content,
  icon: panel.icon,
}))
---

{
  items.length > 0 && (
    <div>
      {data.title && <h3 class="text-xl font-semibold text-foreground">{data.title}</h3>}
      {data.subtitle && <p class="mt-1 text-muted">{data.subtitle}</p>}
      <div class={data.title || data.subtitle ? 'mt-4' : undefined}>
        <Disclosure
          items={items}
          exclusive={data.allowMultipleOpen !== true}
          firstOpen={data.firstOpenByDefault === true}
          emptyText={t(Astro.locals.language, 'noContent')}
          variant="cards"
        />
      </div>
    </div>
  )
}
