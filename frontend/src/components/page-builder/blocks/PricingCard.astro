---
import {stegaClean} from '@sanity/client/stega'
import CallToAction from './CallToAction.astro'
import type {PricingCardData} from '@/types/sanity'

interface Props {
  data: PricingCardData
}

const {data} = Astro.props

const features = data.features || []
const highlightBorder = data.isHighlighted
  ? 'border-primary shadow-lg shadow-primary/10'
  : 'border-border'
/**
 * The card's button, drawn by the Button block's own component across the
 * card's width. Without a Variant picked it keeps the card's look: filled on
 * the highlighted card, outlined on the others.
 */
const cta = data.cta?.label
  ? {
      ...data.cta,
      variant: stegaClean(data.cta.variant) || (data.isHighlighted ? 'primary' : 'outline'),
      fullWidthOn: ['desktop', 'tablet', 'mobile'],
    }
  : null
const CHECK_PATH = 'M5 13l4 4L19 7'
const X_PATH = 'M6 18L18 6M6 6l12 12'
---

{
  (data.title || data.price) && (
    <div class={`relative my-4 flex flex-col rounded-2xl border-2 bg-card p-6 ${highlightBorder}`}>
      {data.badge && (
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground">
          {data.badge}
        </span>
      )}

      {data.title && <h3 class="text-lg font-semibold text-card-foreground">{data.title}</h3>}

      {data.price && (
        <div class="mt-4">
          <span class="text-4xl font-bold tracking-tight text-card-foreground">{data.price}</span>
          {data.priceSubtext && <span class="ml-1 text-sm text-muted">{data.priceSubtext}</span>}
        </div>
      )}

      {features.length > 0 && (
        <ul class="mt-6 flex flex-col gap-3" role="list">
          {features.map((feature) => (
            <li class="flex items-center gap-3">
              <svg
                class={
                  feature.included
                    ? 'h-5 w-5 shrink-0 text-green-500'
                    : 'h-5 w-5 shrink-0 text-muted opacity-40'
                }
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width={2}
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={feature.included ? CHECK_PATH : X_PATH}
                />
              </svg>
              <span
                class={`text-sm ${feature.included ? 'text-card-foreground' : 'text-muted line-through'}`}
              >
                {feature.text}
              </span>
            </li>
          ))}
        </ul>
      )}

      {cta && (
        <div class="mt-8 pt-2">
          <CallToAction data={cta} />
        </div>
      )}
    </div>
  )
}
