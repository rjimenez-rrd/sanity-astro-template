---
import {stegaClean} from '@sanity/client/stega'
import {t} from '@/lib/i18n'
import {SOCIAL_ICONS} from '@/lib/socialIcons'
import type {SocialEmbedData} from '@/types/sanity'

interface Props {
  data: SocialEmbedData
}

const {data} = Astro.props

const PLATFORM_CONFIG: Record<
  string,
  {label: string; color: string; bgColor: string; icon: string}
> = {
  instagram: {
    label: 'Instagram',
    color: 'text-pink-600',
    bgColor: 'bg-gradient-to-br from-pink-50 to-purple-50',
    icon: SOCIAL_ICONS.instagram,
  },
  tiktok: {
    label: 'TikTok',
    color: 'text-foreground',
    bgColor: 'bg-gradient-to-br from-gray-50 to-gray-100',
    icon: SOCIAL_ICONS.tiktok,
  },
  twitter: {
    label: 'X (Twitter)',
    color: 'text-foreground',
    bgColor: 'bg-gradient-to-br from-gray-50 to-blue-50',
    icon: SOCIAL_ICONS.twitter,
  },
  facebook: {
    label: 'Facebook',
    color: 'text-blue-600',
    bgColor: 'bg-gradient-to-br from-blue-50 to-blue-100',
    icon: SOCIAL_ICONS.facebook,
  },
  other: {
    label: 'Social',
    color: 'text-foreground',
    bgColor: 'bg-gradient-to-br from-gray-50 to-gray-100',
    icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z',
  },
}

// stegaClean before the lookup, same reason as logoRow.
const platformKey = stegaClean(data.platform)
const config =
  platformKey && platformKey in PLATFORM_CONFIG
    ? PLATFORM_CONFIG[platformKey]
    : PLATFORM_CONFIG.twitter
const EXTERNAL_PATH =
  'M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14'

// Aspect Ratio shapes the card's body (the link stays centered in it); Auto
// sizes it to its content.
const ASPECT_RATIOS: Record<string, string> = {
  square: 'aspect-square',
  portrait: 'aspect-[4/5]',
  landscape: 'aspect-video',
}
const aspectClass = ASPECT_RATIOS[stegaClean(data.aspectRatio) ?? ''] ?? ''
---

{
  data.embedUrl && (
    <div class="my-4">
      <div class={`overflow-hidden rounded-xl border border-border ${config.bgColor}`}>
        <div class="flex items-center gap-3 border-b border-border px-4 py-3">
          <svg class={`h-5 w-5 shrink-0 ${config.color}`} viewBox="0 0 24 24" fill="currentColor">
            <path d={config.icon} />
          </svg>
          <span class="text-sm font-medium text-foreground">{config.label}</span>
        </div>

        <div class={`flex flex-col items-center justify-center gap-4 px-6 py-8 ${aspectClass}`}>
          <p class="max-w-md break-all text-center text-xs text-muted">{data.embedUrl}</p>
          <a
            href={data.embedUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
          >
            {t(Astro.locals.language, 'viewOn', {platform: config.label})}
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
              <path stroke-linecap="round" stroke-linejoin="round" d={EXTERNAL_PATH} />
            </svg>
          </a>
        </div>
      </div>

      {data.caption && <p class="mt-2 text-center text-sm text-muted">{data.caption}</p>}
    </div>
  )
}
