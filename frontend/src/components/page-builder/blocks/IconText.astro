---
import {stegaClean} from '@sanity/client/stega'
import SanityImage from '@/components/sanity/SanityImage.astro'
import type {IconTextData} from '@/types/sanity'

interface Props {
  data: IconTextData
}

const {data} = Astro.props

const LAYOUT_CLASSES: Record<string, {container: string; text: string}> = {
  left: {container: 'flex flex-row items-start gap-4', text: 'text-left'},
  center: {container: 'flex flex-col items-center gap-3', text: 'text-center'},
  right: {container: 'flex flex-row-reverse items-start gap-4', text: 'text-right'},
}

const alignment = data.alignment || 'left'
const layout = LAYOUT_CLASSES[stegaClean(alignment)!] || LAYOUT_CLASSES.left
---

<div class={layout.container}>
  {
    data.icon?.asset && (
      <div class="shrink-0">
        <SanityImage value={data.icon} width={48} height={48} class="h-12 w-12 object-contain" />
      </div>
    )
  }
  <div class={layout.text}>
    {data.title && <h4 class="text-lg font-semibold text-foreground">{data.title}</h4>}
    {data.description && (
      <p class="mt-1 text-sm leading-relaxed text-muted">{data.description}</p>
    )}
  </div>
</div>
