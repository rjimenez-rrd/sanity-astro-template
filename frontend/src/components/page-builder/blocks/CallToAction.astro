---
import {stegaClean} from '@sanity/client/stega'
import {resolveHref, type LinkItem} from '@/lib/links'
import type {CallToActionData} from '@/types/sanity'
import MissingLinkBadge from '@/components/ui/MissingLinkBadge.astro'

interface Props {
  data: CallToActionData
}

const {data} = Astro.props

const VARIANT_CLASSES: Record<string, string> = {
  primary: 'bg-primary text-primary-foreground hover:bg-foreground',
  secondary: 'bg-white text-primary hover:bg-secondary-hover hover:text-white',
  outline: 'border border-foreground/20 text-foreground hover:bg-foreground/5',
  ghost: 'text-foreground hover:bg-foreground/5',
}

const {href, isExternal, missing} = resolveHref((data.link || []) as unknown as LinkItem[])

/**
 * Editor colors are free text, so only a recognisable color reaches the style
 * attribute: hex, rgb()/rgba(), hsl()/hsla() — all three are what the Studio's
 * picker can write — or a bare keyword. Anything else is dropped rather than
 * risk a stray `;` smuggling in other declarations.
 */
const COLOR = /^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\([\d\s.,%/]+\)|[a-zA-Z]+)$/
const color = (raw?: string | null) => {
  const v = stegaClean(raw)?.trim()
  return v && COLOR.test(v) ? v : undefined
}

/**
 * Normal and Hover colors, as custom properties that the [style*='--btn-…']
 * rules in global.css apply. Each one only takes effect when it is set, so an
 * unset color falls back to the Variant rather than to nothing — and the rules
 * are unlayered, so they beat the Variant's Tailwind classes, hover included.
 * An inline style couldn't do this: it can't target :hover at all, which is
 * why the old hover color was set and never applied.
 */
const colorVars = [
  ['--btn-bg', color(data.color)],
  ['--btn-fg', color(data.textColor)],
  ['--btn-hover-bg', color(data.hoverColor)],
  ['--btn-hover-fg', color(data.hoverTextColor)],
]
  .filter(([, v]) => v)
  .map(([k, v]) => `${k}:${v}`)
  .join(';')

const cleanVariant = stegaClean(data.variant) || 'primary'

/**
 * A plain inline-block link sizes to its label and ignores the width around
 * it, so stretching is opt-in: either Full Width, or a width set in Block
 * Styles -> Size & Alignment, which the button then fills instead of sitting
 * at its natural size inside a wider wrapper. Untouched, it still hugs the
 * label as it always has.
 */
const hasWidth = Boolean(stegaClean(data.blockStyles?.size?.width))
// Full Width, per device: the devices checked in the Studio.
const fullOn = new Set(stegaClean(data.fullWidthOn) ?? [])
const fills = (device: 'desktop' | 'tablet' | 'mobile') => hasWidth || fullOn.has(device)

/**
 * Per device, the site's breakpoints (desktop > 1024px, tablet 768–1024px,
 * mobile < 768px) as Tailwind variants. Written out in full so Tailwind finds
 * every class in the source.
 */
const WIDTH_CLASSES = {
  desktop: {fill: 'min-[1025px]:block min-[1025px]:w-full', fit: 'min-[1025px]:inline-block min-[1025px]:w-fit'},
  tablet: {
    fill: 'min-[768px]:max-[1024px]:block min-[768px]:max-[1024px]:w-full',
    fit: 'min-[768px]:max-[1024px]:inline-block min-[768px]:max-[1024px]:w-fit',
  },
  mobile: {fill: 'max-[767px]:block max-[767px]:w-full', fit: 'max-[767px]:inline-block max-[767px]:w-fit'},
}
const widthClasses = (['desktop', 'tablet', 'mobile'] as const)
  .map((device) => WIDTH_CLASSES[device][fills(device) ? 'fill' : 'fit'])
  .join(' ')

/**
 * w-fit, not just inline-block: a button with no Block Styles sits directly in
 * its column, which is a flex container — and flex stretches its items across
 * the column regardless of display. A fit-content width opts out of that
 * stretch while still following the column's own alignment, so Full Width off
 * really does mean sized to the label.
 */
const baseClasses = `relative ${widthClasses} px-6 py-3 rounded-[3px] font-semibold transition-colors duration-200 text-center text-lg`
// Always the Variant's classes: the custom colors above override only the
// parts that are set, so the rest still comes from the Variant.
const colorClasses = VARIANT_CLASSES[cleanVariant] || VARIANT_CLASSES.primary
---

{
  data.label && (
    <a
      href={href}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      class={`${baseClasses} ${colorClasses}`}
      style={colorVars || undefined}
    >
      {data.label}
      {missing && <MissingLinkBadge />}
    </a>
  )
}
