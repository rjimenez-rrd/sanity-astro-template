---
/**
 * Practice Area Grid: every practice area (or a picked set) as a grid of
 * cards, a fixed number per page, with page numbers underneath. Not a
 * carousel — that's Practice Area Cards.
 *
 * The page number comes from the route: /<slug> is page 1, and
 * pages/[slug]/page/[page].astro sets Astro.locals.listPage for the rest (and
 * 404s a page past the end).
 */
import {stegaClean} from '@sanity/client/stega'
import Pagination from '@/components/ui/Pagination.astro'
import PracticeAreaCard from '@/components/practice-areas/PracticeAreaCard.astro'
import {listBasePath, pageCount, perPageOf} from '@/lib/pagination'
import type {PracticeAreaGridData, PracticeAreaListItem} from '@/types/sanity'

interface Props {
  data: PracticeAreaGridData
}

const {data} = Astro.props

const areas = (data.practiceAreas ?? []).filter((area) => area?.slug?.current)
const titleAlign = stegaClean(data.titleAlign) === 'left' ? 'left' : 'center'
const stackWords = data.stackTitleWords === true

const perPage = perPageOf(data.perPage)
const totalPages = pageCount(areas.length, perPage)
// Clamped both ways, so a bad page number can never slice an empty page.
const currentPage = Math.min(Math.max(1, Math.trunc(Astro.locals.listPage ?? 1)), totalPages)
const pageAreas = areas.slice((currentPage - 1) * perPage, currentPage * perPage)
const base = listBasePath(Astro.url.pathname)

// Literal class names, so Tailwind generates each one. Tablet is two across,
// phones one, whatever the desktop column count.
const GRID_COLUMNS: Record<string, string> = {
  '2': 'lg:grid-cols-2',
  '3': 'lg:grid-cols-3',
  '4': 'lg:grid-cols-4',
  '5': 'lg:grid-cols-5',
}
const gridColumns = GRID_COLUMNS[stegaClean(data.columns) ?? '5'] ?? GRID_COLUMNS['5']
---

{
  areas.length > 0 && (
    <div class="w-full min-w-0">
      {data.title && <h2 class="mb-2 font-display text-3xl font-bold md:text-4xl">{data.title}</h2>}
      {data.subtitle && <p class="mb-8 max-w-2xl text-muted">{data.subtitle}</p>}
      <ul class={`grid grid-cols-1 gap-6 md:grid-cols-2 ${gridColumns}`}>
        {pageAreas.map((area) => (
          <li>
            <PracticeAreaCard
              area={area as unknown as PracticeAreaListItem}
              align={titleAlign}
              stackWords={stackWords}
              mobileAspect="wide"
              fillHeight
            />
          </li>
        ))}
      </ul>
      <Pagination current={currentPage} total={totalPages} base={base} />
    </div>
  )
}
