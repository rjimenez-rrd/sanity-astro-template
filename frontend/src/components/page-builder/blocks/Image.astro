---
import SanityImage from '@/components/sanity/SanityImage.astro'
import type {ImageBlockData} from '@/types/sanity'

interface Props {
  data: ImageBlockData
}

const {data} = Astro.props
// "Load First" in the Studio: eager and high priority for an image visible
// without scrolling; lazy (the default) everywhere else.
const priority = Boolean(data.priority)
// Corners from Block Styles → Border Radius when set (--pb-radius, see
// lib/blockStyles.ts), else the usual 0.5rem.
const imageClass = 'w-full rounded-[var(--pb-radius,0.5rem)] object-cover'
---

{/* <figure> only earns its place when there is a caption to pair with the image. */}
{
  data.image?.asset &&
    (data.caption ? (
      <figure>
        <SanityImage value={data.image} class={imageClass} priority={priority} />
        <figcaption class="mt-3 text-center text-sm text-muted">{data.caption}</figcaption>
      </figure>
    ) : (
      <SanityImage value={data.image} class={imageClass} priority={priority} />
    ))
}
