---
/**
 * Button Group: up to four Buttons side by side or stacked. Each is drawn by
 * the Button block's own component, so variants, colors, hover colors and
 * links behave exactly as a single Button does.
 */
import {stegaClean} from '@sanity/client/stega'
import CallToAction from './CallToAction.astro'
import type {ButtonGroupData} from '@/types/sanity'

interface Props {
  data: ButtonGroupData
}

const {data} = Astro.props

const GAP: Record<string, string> = {small: 'gap-2', medium: 'gap-3', large: 'gap-6'}
// Side by side, alignment moves the row along its line; stacked, it moves
// each button across (left/center/right).
const ROW_ALIGN: Record<string, string> = {left: 'justify-start', center: 'justify-center', right: 'justify-end'}
const STACK_ALIGN: Record<string, string> = {left: 'items-start', center: 'items-center', right: 'items-end'}

const buttons = (data.buttons || []).filter((button) => button.label)
const vertical = stegaClean(data.direction) === 'vertical'
const alignment = stegaClean(data.alignment) || 'left'
const layout = vertical
  ? `flex-col ${STACK_ALIGN[alignment] ?? STACK_ALIGN.left}`
  : `flex-row flex-wrap ${ROW_ALIGN[alignment] ?? ROW_ALIGN.left}`
const gap = GAP[stegaClean(data.gap) ?? 'medium'] ?? GAP.medium
---

{
  buttons.length > 0 && (
    <div class={`flex ${layout} ${gap}`}>
      {buttons.map((button) => (
        <CallToAction data={button} />
      ))}
    </div>
  )
}
