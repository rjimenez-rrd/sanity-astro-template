---
/**
 * Form CTA: eyebrow, heading, description and a form on the left; a cut-out
 * image on the bottom edge on the right, with large outlined words behind it.
 * The form is a Form block rendered in its On Dark style.
 *
 * The content comes from the Form CTA document the block picks, so the same
 * CTA can sit on many pages. Blocks made before that carry their own content,
 * used only while nothing is picked.
 */
import {stegaClean} from '@sanity/client/stega'
import SanityImage from '@/components/sanity/SanityImage.astro'
import FormBlock from './FormBlock.astro'
import type {FormCtaData} from '@/types/sanity'

interface Props {
  data: FormCtaData
}

const {data: block} = Astro.props
const data = block.cta ?? block

/**
 * The fonts a Form CTA can pick (studio form-cta.ts), each bundled in
 * global.css so nothing is fetched from Google Fonts. Anything else, such as
 * a name typed before these were a list, falls back to the default.
 */
const SERIF = 'ui-serif, Georgia, serif'
const CONDENSED = 'Impact, sans-serif'
const FONTS: Record<string, string> = {
  'Libre Baskerville': `'Libre Baskerville', ${SERIF}`,
  'Playfair Display': `'Playfair Display', ${SERIF}`,
  Lora: `'Lora', ${SERIF}`,
  Montserrat: 'var(--font-montserrat)',
  Inter: 'var(--font-inter)',
  'Bebas Neue': `'Bebas Neue', ${CONDENSED}`,
  Oswald: `'Oswald', ${CONDENSED}`,
  Anton: `'Anton', ${CONDENSED}`,
}
const fontStack = (value: string | null | undefined, fallback: string) =>
  FONTS[stegaClean(value)?.trim() ?? ''] ?? FONTS[fallback]
const headingFont = fontStack(data.headingFont, 'Libre Baskerville')
const outlineFont = fontStack(data.outlineFont, 'Bebas Neue')

// Empty means no color of its own, so the container's background (color,
// image, overlay) shows through.
const background = stegaClean(data.backgroundColor)
---

<section class="relative w-full overflow-hidden text-white" style={background ? `background-color:${background}` : undefined}>
  {/* px-5: the Container sets the width, but the text and form still keep
      20px off the blue edge when the window narrows to that width. */}
  <div
    class="mx-auto grid grid-cols-1 gap-10 px-5 lg:grid-cols-2"
  >
    <div class="py-12 font-display lg:py-14">
      {data.eyebrow && <p class="text-lg">{data.eyebrow}</p>}
      {
        data.heading && (
          <h2
            class="mt-1 max-w-[9em] whitespace-pre-line text-[clamp(2.5rem,4.5vw,3.875rem)] leading-[1.02]"
            style={`font-family:${headingFont}`}
          >
            {data.heading}
          </h2>
        )
      }
      {data.description && <p class="mt-7 text-lg leading-relaxed">{data.description}</p>}
      {
        data.form && (
          <div class="mt-7">
            <FormBlock data={data.form} formStyle="dark" />
          </div>
        )
      }
    </div>

    {/* The image sits on the section's bottom edge; the outlined words sit
        behind it, so a cut-out's edges overlap them the way the design does. */}
    <div class="relative flex min-h-[380px] items-end justify-center lg:min-h-0 lg:justify-start">
      {
        data.outlineText && (
          <p
            aria-hidden="true"
            class="pointer-events-none absolute top-8 right-0 whitespace-pre-line text-right text-[clamp(3.5rem,7vw,6.5rem)] uppercase leading-[0.85] text-transparent [-webkit-text-stroke:1.5px_rgba(255,255,255,0.55)] lg:top-[20%]"
            style={`font-family:${outlineFont}`}
          >
            {data.outlineText}
          </p>
        )
      }
      {
        data.image?.asset && (
          <SanityImage
            value={data.image}
            alt={stegaClean(data.image.alt) || ''}
            width={900}
            sizes="100vw, 600px"
            class="relative z-10 block max-h-[720px] w-auto lg:max-h-full"
          />
        )
      }
    </div>
  </div>
</section>
