---
/**
 * Phone block: the site's phone (Site Settings → Branding) with its label,
 * styled per block. The number and words are shared; only the look is set
 * here, through each Text Style. Block Styles (padding, alignment, ...) are
 * applied around it by BlockRenderer.
 */
import {stegaClean} from '@sanity/client/stega'
import PhoneLink from '@/components/ui/PhoneLink.astro'
import {phoneText} from '@/lib/phone'
import {textStyleAttr} from '@/lib/textStyle'
import {getSiteInfo} from '@/sanity/lib/siteInfo'
import type {PhoneBlockData} from '@/types/sanity'

interface Props {
  data: PhoneBlockData
}

const {data} = Astro.props
const info = await getSiteInfo(Astro.locals)
const text = phoneText(info, stegaClean(data.show) === 'number' ? 'number' : 'display')
const label = data.showLabel === false ? undefined : data.label?.trim() || info.phoneLabel
---

{
  text && (
    <div>
      {label && (
        <p class="text-sm uppercase" style={textStyleAttr(data.labelStyle)}>
          {label}
        </p>
      )}
      {/* The defaults below apply until a Text Style sets its own. */}
      <PhoneLink
        phone={info.phone}
        text={text}
        class="inline-block font-display text-3xl transition-opacity hover:opacity-80"
        style={textStyleAttr(data.numberStyle)}
      />
    </div>
  )
}
