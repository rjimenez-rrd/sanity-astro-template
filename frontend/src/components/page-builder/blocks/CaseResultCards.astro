---
import CardCarousel from '@/components/ui/CardCarousel.astro'
import type {CaseResultCardsData} from '@/types/sanity'

interface Props {
  data: CaseResultCardsData
}

const {data} = Astro.props

const showResultType = data.showResultType === true
const results = (data.caseResults ?? []).filter((result) => result?.amount)
---

<CardCarousel
  items={results}
  columns={data.columns}
  title={data.title}
  subtitle={data.subtitle}
  autoPlay={data.autoPlay}
  autoPlayInterval={data.autoPlayInterval}
>
  {
    (result: (typeof results)[number]) => (
      // h-full: the carousel stretches each slot to the tallest card, and the
      // card has to fill its slot for the row to line up.
      <article class="flex h-full flex-col items-center justify-center border border-border bg-card px-8 py-14 text-center">
        {showResultType && result.resultType && (
          <p class="font-display mb-3 text-xs font-semibold uppercase tracking-widest text-muted">
            {result.resultType}
          </p>
        )}
        <p class="font-display text-5xl font-extrabold leading-none text-primary md:text-6xl">
          {result.amount}
        </p>
        <p class="font-display mt-6 text-balance text-lg text-primary md:text-xl">
          {result.summary}
        </p>
      </article>
    )
  }
</CardCarousel>
