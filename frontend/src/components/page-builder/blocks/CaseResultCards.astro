---
import {stegaClean} from '@sanity/client/stega'
import type {CaseResultCardsData} from '@/types/sanity'

interface Props {
  data: CaseResultCardsData
}

const {data} = Astro.props

/**
 * Card width per breakpoint, written as custom properties and promoted to real
 * widths by the rules in global.css — the same mechanism the lawyer cards and
 * the testimonial carousel use, so no generated class names are needed. Each
 * width subtracts the card's share of the 1.5rem gap, or the cards overflow the
 * track. Mobile is always one card, forced by global.css.
 */
const CARD_WIDTH: Record<number, string> = {
  1: '100%',
  2: 'calc(50% - 0.75rem)',
  3: 'calc(33.333% - 1rem)',
  4: 'calc(25% - 1.125rem)',
}

const columns = Number(stegaClean(data.columns) ?? '3')
const perViewDesktop = CARD_WIDTH[columns] ? columns : 3
// Tablet halves a 3- or 4-up row; 1 and 2 stay as they are.
const perViewTablet = Math.min(perViewDesktop, 2)

const cardStyle = [
  `--card-w:${CARD_WIDTH[perViewDesktop]}`,
  `--card-w-tablet:${CARD_WIDTH[perViewTablet]}`,
].join(';')

const showResultType = data.showResultType === true
const results = (data.caseResults ?? []).filter((result) => result?.amount)

/**
 * Looping needs more cards in the track than are on screen, so the set is
 * repeated and the runtime rewinds out of the copies. Two passes cover a full
 * row; below that it takes three to avoid a gap appearing at the wrap.
 * The copies render hidden and are revealed only when the results don't all
 * fit — so they never flash before the script runs, and with no JS at all the
 * block degrades to a plain row of the real cards.
 */
const loops = results.length < 2 ? 1 : results.length >= perViewDesktop ? 2 : 3
const loopedResults = Array.from({length: loops}, () => results).flat()
---

{
  results.length > 0 && (
    <div data-card-carousel data-count={String(results.length)}>
      {data.title && (
        <h2 class="mb-2 font-display text-3xl font-bold md:text-4xl">{data.title}</h2>
      )}
      {data.subtitle && <p class="mb-8 max-w-2xl text-muted">{data.subtitle}</p>}

      {/* No scroll-smooth class: the rewind out of the copies uses
          behavior:'auto', which follows CSS scroll-behavior — with smooth set
          there, the seam would animate instead of being instant. */}
      <div
        data-card-carousel-track
        class="flex snap-x snap-mandatory gap-6 overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {loopedResults.map((result, i) => (
          <article
            style={cardStyle}
            class="flex shrink-0 snap-start flex-col items-center justify-center border border-border bg-card px-8 py-14 text-center"
            aria-hidden={i >= results.length ? 'true' : undefined}
            {...(i >= results.length ? {hidden: true} : {})}
          >
            {showResultType && result.resultType && (
              <p class="font-display mb-3 text-xs font-semibold uppercase tracking-widest text-muted">
                {result.resultType}
              </p>
            )}
            <p class="font-display text-5xl font-extrabold leading-none text-primary md:text-6xl">
              {result.amount}
            </p>
            <p class="font-display mt-6 text-balance text-lg text-primary md:text-xl">{result.summary}</p>
          </article>
        ))}
      </div>

      {/* Filled by the runtime: one dot per page, and a page is however many
          cards fit at the current breakpoint. */}
      <div class="mt-6 flex justify-center gap-2" data-card-carousel-dots hidden />
    </div>
  )
}

<script>
  import {initCardCarousels} from '@/lib/cardCarousel'
  initCardCarousels()
</script>
