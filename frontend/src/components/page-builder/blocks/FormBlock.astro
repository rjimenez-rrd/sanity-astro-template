---
import {stegaClean} from '@sanity/client/stega'
import type {FormBlockData} from '@/types/sanity'
import {t} from '@/lib/i18n'

interface Props {
  /** Only the form's own fields, so Form CTA can pass its embedded form (no _key, and its styles are the renderer's job). */
  data: Omit<FormBlockData, '_key' | 'blockStyles'>
  /** Set by a block that owns the background, e.g. Form CTA, overriding the form's own choice. */
  formStyle?: 'default' | 'dark'
}

const {data, formStyle} = Astro.props
const language = Astro.locals.language
const dark = (formStyle ?? stegaClean(data.formStyle)) === 'dark'

const fields = data.fields || []
const submitLabel = data.submitLabel || t(language, 'submit')
const cleanAction = stegaClean(data.submitAction) || 'webhook'
const successMessage = data.successMessage || t(language, 'formSuccess')
const errorMessage = data.errorMessage || t(language, 'formError')
const endpoint =
  cleanAction === 'webhook' ? '/api/form-submit' : data.customEndpoint || '/api/form-submit'

/**
 * Default is the light form. On Dark matches a form set on a brand-colored
 * section: small white labels, square white fields, a white button.
 */
const ui = dark
  ? {
      field:
        'w-full border-0 bg-white px-3 text-[17px] text-foreground placeholder:text-foreground/70 focus:outline-none focus:ring-2 focus:ring-secondary-hover',
      input: 'h-[50px]',
      select: 'h-[58px]',
      textarea: 'min-h-[100px] py-3',
      label: 'mb-2 block text-sm text-white',
      required: 'ml-1.5 text-xs text-white',
      // Text flows under the box, as in the design, rather than hanging beside it.
      check: 'block px-3 text-sm leading-relaxed text-white',
      checkbox: 'mr-2 inline-block h-4 w-4 rounded-none border-0 align-[-2px]',
      title: 'text-xl font-semibold text-white',
      description: 'mt-1 text-sm text-white/80',
      footnote: 'px-3 text-sm text-white',
      error: 'text-sm text-red-300',
      button:
        'inline-flex items-center bg-white px-8 py-3.5 text-lg font-semibold text-primary transition-colors hover:bg-secondary-hover hover:text-white disabled:opacity-50',
      success: 'border border-white/30 bg-white/10 p-6 text-center font-medium text-white',
    }
  : {
      field:
        'w-full rounded-lg border border-border bg-background px-3 text-sm text-foreground placeholder:text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary',
      input: 'py-2.5',
      select: 'py-2.5',
      textarea: 'py-2.5',
      label: 'mb-1.5 block text-sm font-medium text-foreground',
      required: 'ml-0.5 text-red-500',
      check: 'flex items-center gap-2 text-sm text-foreground',
      checkbox: 'h-4 w-4 shrink-0 rounded border-border text-primary focus:ring-primary',
      title: 'text-xl font-semibold text-foreground',
      description: 'mt-1 text-sm text-muted',
      footnote: 'text-xs text-muted',
      error: 'text-sm text-red-500',
      button:
        'inline-flex items-center rounded-lg px-6 py-3 text-sm font-medium text-primary-foreground transition-colors hover:opacity-90 disabled:opacity-50',
      success: 'rounded-xl border border-secondary/30 bg-secondary/5 p-6 text-center font-medium text-secondary',
    }

// On Dark has its own white button; a Button Color still wins when set.
const buttonColor = stegaClean(data.buttonColor) || (dark ? undefined : 'var(--primary)')
---

<div data-form-block>
  <div data-form-success hidden>
    <p class={ui.success}>{successMessage}</p>
  </div>

  <div data-form-body>
    {data.formTitle && <h3 class={ui.title}>{data.formTitle}</h3>}
    {data.formDescription && <p class={ui.description}>{data.formDescription}</p>}

    <form
      class={`${data.formTitle || data.formDescription ? 'mt-6' : ''} space-y-4`}
      data-form
      data-endpoint={endpoint}
      data-action={cleanAction}
      data-webhook={stegaClean(data.webhookUrl) || undefined}
    >
      <div class={`grid grid-cols-1 sm:grid-cols-2 ${dark ? 'gap-x-3 gap-y-4' : 'gap-4'}`}>
        {
          fields.map((field) => {
            const fieldType = stegaClean(field.type)
            const isHalf = stegaClean(field.width) === 'half'
            return (
              <div class={isHalf ? '' : 'sm:col-span-2'}>
                {/* A checkbox carries its text beside the box instead. */}
                {fieldType !== 'checkbox' && (
                  <label class={ui.label}>
                    {field.label}
                    {field.required && <span class={ui.required}>*</span>}
                  </label>
                )}
                {fieldType === 'textarea' ? (
                  <textarea
                    name={field.name}
                    placeholder={field.placeholder}
                    required={field.required}
                    rows={4}
                    class={`${ui.field} ${ui.textarea} resize-y`}
                  />
                ) : fieldType === 'select' ? (
                  <div class="relative">
                    {/* The browser's own arrow differs everywhere and can't be
                        styled, so it's hidden and drawn here instead. */}
                    <select
                      name={field.name}
                      required={field.required}
                      class={`${ui.field} ${ui.select} appearance-none pr-10`}
                    >
                      <option value="">{field.placeholder || 'Select...'}</option>
                      {(field.options || []).map((opt) => (
                        <option value={opt}>{opt}</option>
                      ))}
                    </select>
                    <svg
                      class="pointer-events-none absolute right-4 top-1/2 h-3 w-3 -translate-y-1/2 text-foreground"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width={3}
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 9l7 7 7-7" />
                    </svg>
                  </div>
                ) : fieldType === 'checkbox' ? (
                  <label class={ui.check}>
                    <input
                      type="checkbox"
                      name={field.name}
                      required={field.required}
                      class={ui.checkbox}
                    />
                    <span>
                      {field.placeholder || field.label}
                      {/* Consent text often ends in its own asterisk already. */}
                      {field.required && !stegaClean(field.placeholder || field.label)?.trim().endsWith('*') && '*'}
                    </span>
                  </label>
                ) : (
                  <input
                    type={fieldType || 'text'}
                    name={field.name}
                    placeholder={field.placeholder}
                    required={field.required}
                    class={`${ui.field} ${ui.input}`}
                  />
                )}
              </div>
            )
          })
        }
      </div>

      {data.footnote && <p class={ui.footnote}>{data.footnote}</p>}

      <p class={ui.error} data-form-error hidden>{errorMessage}</p>

      <button
        type="submit"
        class={ui.button}
        style={buttonColor ? `background-color:${buttonColor}` : undefined}
        data-form-submit
        data-label={submitLabel}
        data-sending={t(language, 'sending')}
      >
        {submitLabel}
      </button>
    </form>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-form-block]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')
    const body = root.querySelector<HTMLElement>('[data-form-body]')
    const success = root.querySelector<HTMLElement>('[data-form-success]')
    const error = root.querySelector<HTMLElement>('[data-form-error]')
    const button = root.querySelector<HTMLButtonElement>('[data-form-submit]')
    if (!form || !button) return

    const label = button.dataset.label || 'Submit'

    form.addEventListener('submit', async (event) => {
      event.preventDefault()

      button.disabled = true
      button.textContent = button.dataset.sending || 'Sending...'
      if (error) error.hidden = true

      const payload: Record<string, string> = {}
      new FormData(form).forEach((value, key) => {
        payload[key] = value.toString()
      })

      const endpoint = form.dataset.endpoint || '/api/form-submit'
      const body_ =
        form.dataset.action === 'webhook'
          ? JSON.stringify({webhookUrl: form.dataset.webhook, data: payload})
          : JSON.stringify(payload)

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: body_,
        })
        if (!res.ok) throw new Error('Submit failed')

        if (body) body.hidden = true
        if (success) success.hidden = false
      } catch {
        if (error) error.hidden = false
        button.disabled = false
        button.textContent = label
      }
    })
  })
</script>
