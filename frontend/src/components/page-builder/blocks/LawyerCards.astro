---
import {stegaClean} from '@sanity/client/stega'
import SanityImage from '@/components/sanity/SanityImage.astro'
import type {LawyerCardsData} from '@/types/sanity'

interface Props {
  data: LawyerCardsData
}

const {data} = Astro.props

/**
 * Card width per breakpoint, written as custom properties and promoted to real
 * widths by the rules in global.css — the same mechanism the testimonial
 * carousel uses, so no generated class names are needed. Each width subtracts
 * the card's share of the 1.5rem gap, or the cards overflow the track.
 * Mobile is always one card, forced by global.css.
 */
const CARD_WIDTH: Record<number, string> = {
  1: '100%',
  2: 'calc(50% - 0.75rem)',
  3: 'calc(33.333% - 1rem)',
  4: 'calc(25% - 1.125rem)',
}

const columns = Number(stegaClean(data.columns) ?? '3')
const perViewDesktop = CARD_WIDTH[columns] ? columns : 3
// Tablet halves a 3- or 4-up row; 1 and 2 stay as they are.
const perViewTablet = Math.min(perViewDesktop, 2)

const cardStyle = [
  `--card-w:${CARD_WIDTH[perViewDesktop]}`,
  `--card-w-tablet:${CARD_WIDTH[perViewTablet]}`,
].join(';')

// The name bar: solid dark navy on the left, fading to a half-transparent brand
// blue by 56%, so the photo reads through on the right as in the design.
const BAR_GRADIENT = 'linear-gradient(90deg, #07083d 15%, #0A108C80 56%)'

const showRole = data.showRole !== false
const lawyers = (data.lawyers ?? []).filter((lawyer) => lawyer?.name)

/**
 * Looping needs more cards in the track than are on screen, so the set is
 * repeated and the script rewinds out of the copies. Two passes cover a full
 * row; below that it takes three to avoid a gap appearing at the wrap.
 * The copies render hidden and the script reveals them only when the lawyers
 * don't all fit — so they never flash before it runs, and with no JS at all
 * the block degrades to a plain row of the real cards.
 */
const loops = lawyers.length < 2 ? 1 : lawyers.length >= perViewDesktop ? 2 : 3
const loopedLawyers = Array.from({length: loops}, () => lawyers).flat()
---

{
  lawyers.length > 0 && (
    <div data-lawyers data-count={String(lawyers.length)}>
      {data.title && (
        <h2 class="mb-2 font-display text-3xl font-bold md:text-4xl">{data.title}</h2>
      )}
      {data.subtitle && <p class="mb-8 max-w-2xl text-muted">{data.subtitle}</p>}

      {/* No scroll-smooth class: the rewind out of the copies uses
          behavior:'auto', which follows CSS scroll-behavior — with smooth set
          there, the seam would animate instead of being instant. */}
      <div
        data-lawyers-track
        class="flex snap-x snap-mandatory gap-6 overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {loopedLawyers.map((lawyer, i) => (
          <article
            style={cardStyle}
            class="group relative shrink-0 snap-start overflow-hidden border border-border bg-surface"
            aria-hidden={i >= lawyers.length ? 'true' : undefined}
            {...(i >= lawyers.length ? {hidden: true} : {})}
          >
            <div class="aspect-3/4 w-full">
              <SanityImage
                value={lawyer.photo}
                alt={lawyer.photo?.alt ?? lawyer.name ?? ''}
                width={600}
                height={800}
                class="h-full w-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-105"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              />
            </div>

            <div
              class="absolute inset-x-0 bottom-0 px-5 py-4"
              style={`background-image:${BAR_GRADIENT}`}
            >
              <h3 class="font-display text-xl font-bold text-white">{lawyer.name}</h3>
              {showRole && lawyer.role && (
                <p class="mt-0.5 text-sm text-white/85">{lawyer.role}</p>
              )}
            </div>
          </article>
        ))}
      </div>

      {/* Filled by the script: one dot per page, and a page is however many
          cards fit at the current breakpoint. */}
      <div class="mt-6 flex justify-center gap-2" data-lawyers-dots hidden />
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-lawyers]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-lawyers-track]')
    const dotsBox = root.querySelector<HTMLElement>('[data-lawyers-dots]')
    if (!track || !dotsBox) return

    const slides = Array.from(track.children) as HTMLElement[]
    // How many lawyers there really are; anything past this is a copy that
    // exists so the track can always scroll forward.
    const count = Number(root.dataset.count) || slides.length
    const canLoop = slides.length > count
    if (slides.length === 0) return

    let current = 0
    let pages = 1
    let perView = 1

    const offsetOf = (index: number) =>
      slides[Math.min(index, slides.length - 1)]!.offsetLeft - track.offsetLeft

    /** Measured, not assumed: the width comes from CSS and changes per breakpoint. */
    function measurePerView() {
      const card = slides[0]!.getBoundingClientRect().width
      const gap = parseFloat(getComputedStyle(track!).columnGap || '0') || 0
      if (card <= 0) return 1
      return Math.max(1, Math.round((track!.clientWidth + gap) / (card + gap)))
    }

    function paint() {
      const active = Math.floor(current / perView) % pages
      Array.from(dotsBox!.children).forEach((dot, i) => {
        const on = i === active
        dot.classList.toggle('w-6', on)
        dot.classList.toggle('bg-primary', on)
        dot.classList.toggle('w-2', !on)
        dot.classList.toggle('bg-border', !on)
      })
    }

    /**
     * Recomputed whenever the visible card count can change. When every lawyer
     * fits at once there is nothing to page through: the dots go away, the
     * copies are hidden and the track stops scrolling, so it behaves like a
     * plain row instead of a carousel that can be swiped off its only page.
     */
    function layout() {
      perView = measurePerView()

      /**
       * Two-up (tablet) takes a second row before it becomes a carousel, so
       * four lawyers read as a 2x2 block rather than a page with one card
       * hidden off-screen. Every other width carousels as soon as the cards
       * outgrow a single row.
       */
      const capacity = perView === 2 ? perView * 2 : perView
      const fits = count <= capacity
      pages = fits ? 1 : Math.max(1, Math.ceil(count / perView))

      slides.slice(count).forEach((copy) => {
        copy.hidden = fits
      })
      // Wrapping is what lets the second row exist; a carousel must not wrap.
      track!.style.flexWrap = fits ? 'wrap' : 'nowrap'
      track!.style.overflowX = fits ? 'hidden' : 'auto'
      if (fits) {
        current = 0
        track!.scrollTo({left: 0, behavior: 'auto'})
      }

      dotsBox!.replaceChildren()
      dotsBox!.hidden = fits
      if (fits) return
      for (let i = 0; i < pages; i++) {
        const dot = document.createElement('button')
        dot.type = 'button'
        dot.className = 'h-2 w-2 rounded-full bg-border transition-all'
        dot.setAttribute('aria-label', `Go to slide ${i + 1}`)
        dot.addEventListener('click', () => goTo(i * perView))
        dotsBox!.append(dot)
      }
      paint()
    }

    /**
     * Once a smooth scroll into the copies has settled, jump instantly to the
     * identical real card. It looks the same, so the seam is invisible — that
     * is what makes the loop endless.
     */
    function settle(then: () => void) {
      if ('onscrollend' in window) track!.addEventListener('scrollend', then, {once: true})
      else setTimeout(then, 500)
    }

    function normalize(target: number) {
      current = ((target % count) + count) % count
      if (target !== current) track!.scrollTo({left: offsetOf(current), behavior: 'auto'})
      paint()
    }

    function goTo(index: number) {
      if (!canLoop) {
        current = Math.max(0, Math.min(index, count - perView))
        track!.scrollTo({left: offsetOf(current), behavior: 'smooth'})
        paint()
        return
      }

      if (index < 0) {
        // Nothing exists to the left of the first card, so hop to its copy a
        // full set ahead and animate left from there instead.
        const from = current + count
        track!.scrollTo({left: offsetOf(from), behavior: 'auto'})
        const target = from + (index - current)
        requestAnimationFrame(() => {
          track!.scrollTo({left: offsetOf(target), behavior: 'smooth'})
          settle(() => normalize(target))
        })
        current = ((index % count) + count) % count
        paint()
        return
      }

      track!.scrollTo({left: offsetOf(index), behavior: 'smooth'})
      current = index % count
      paint()
      settle(() => normalize(index))
    }

    // A swipe moves the track without going through goTo, so read the position
    // back and keep the dots — and the loop — in step.
    let scrollTimer: number | undefined
    track.addEventListener('scroll', () => {
      window.clearTimeout(scrollTimer)
      scrollTimer = window.setTimeout(() => {
        if (pages < 2) return
        const nearest = slides.reduce(
          (best, _, i) =>
            Math.abs(offsetOf(i) - track.scrollLeft) < Math.abs(offsetOf(best) - track.scrollLeft)
              ? i
              : best,
          0,
        )
        if (canLoop && nearest >= count) normalize(nearest)
        else {
          current = nearest
          paint()
        }
      }, 120)
    })

    layout()

    // The number of visible cards changes with the breakpoint, so the number
    // of dots does too.
    let resizeTimer: number | undefined
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer)
      resizeTimer = window.setTimeout(layout, 150)
    })
  })
</script>
