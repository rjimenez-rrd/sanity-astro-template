---
import CardCarousel from '@/components/ui/CardCarousel.astro'
import SanityImage from '@/components/sanity/SanityImage.astro'
import type {LawyerCardsData} from '@/types/sanity'

interface Props {
  data: LawyerCardsData
}

const {data} = Astro.props

// The name bar: solid dark navy on the left, fading to a half-transparent brand
// blue by 56%, so the photo reads through on the right as in the design.
const BAR_GRADIENT = 'linear-gradient(90deg, #07083d 15%, #0A108C80 56%)'

const showRole = data.showRole !== false
const lawyers = (data.lawyers ?? []).filter((lawyer) => lawyer?.name)
---

<CardCarousel
  items={lawyers}
  columns={data.columns}
  title={data.title}
  subtitle={data.subtitle}
  autoPlay={data.autoPlay}
  autoPlayInterval={data.autoPlayInterval}
  wrapRows
>
  {
    (lawyer: (typeof lawyers)[number]) => (
      <article class="group relative overflow-hidden border border-border bg-surface">
        {/* A 3:4 portrait is ~630px tall at full phone width, so below 768px —
            the same breakpoint the carousel switches to one card per view —
            the crop goes square. Square rather than a letterbox because a
            headshot can't lose that much head room. */}
        <div class="aspect-square w-full md:aspect-3/4">
          <SanityImage
            value={lawyer.photo}
            alt={lawyer.photo?.alt ?? lawyer.name ?? ''}
            width={600}
            height={800}
            class="h-full w-full object-cover object-top transition-transform duration-500 ease-out motion-safe:group-hover:scale-105 md:object-center"
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          />
        </div>

        <div class="absolute inset-x-0 bottom-0 px-5 py-4" style={`background-image:${BAR_GRADIENT}`}>
          <h3 class="font-display text-xl font-bold text-white">{lawyer.name}</h3>
          {showRole && lawyer.role && <p class="mt-0.5 text-sm text-white/85">{lawyer.role}</p>}
        </div>
      </article>
    )
  }
</CardCarousel>
