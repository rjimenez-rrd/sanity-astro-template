---
import {stegaClean} from '@sanity/client/stega'
import type {SpacerDividerData} from '@/types/sanity'

interface Props {
  data: SpacerDividerData
}

const {data} = Astro.props

const HEIGHT_MAP: Record<string, string> = {
  xs: 'h-2 md:h-3',
  sm: 'h-4 md:h-6',
  md: 'h-8 md:h-12',
  lg: 'h-12 md:h-16',
  xl: 'h-16 md:h-24',
  xxl: 'h-24 md:h-32',
}

const height = stegaClean(data.height) || 'md'
const heightClass = HEIGHT_MAP[height] || HEIGHT_MAP.md
---

{
  data.showDivider ? (
    <div class={`${heightClass} flex items-center`}>
      <hr class="w-full border-t border-border" />
    </div>
  ) : (
    <div class={heightClass} aria-hidden="true" />
  )
}
