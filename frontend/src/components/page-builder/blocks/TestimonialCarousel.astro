---
import {stegaClean} from '@sanity/client/stega'
import type {TestimonialCarouselData} from '@/types/sanity'
import {t as translate} from '@/lib/i18n'
import CardCarousel from '@/components/ui/CardCarousel.astro'
import StarRating from '@/components/ui/StarRating.astro'

interface Props {
  data: TestimonialCarouselData
}

const {data} = Astro.props

// Resolved by the query from the Reviews documents: the editor's picks, or
// every review when none are picked. A review needs text to be worth a card.
const testimonials = (data.reviews ?? []).filter((review) => review?.reviewText)

// Never more columns than reviews: one review fills the row, two share it.
const shown = Math.max(testimonials.length, 1)
const perViewDesktop = Math.min(Number(stegaClean(data.perViewDesktop ?? 3)) || 3, shown)
const perViewTablet = Math.min(Number(stegaClean(data.perViewTablet ?? 2)) || 2, shown)

// Text sizes below are in em, relative to the block's own size: the same as
// before by default (1.125em of 16px = text-lg), and Block Styles ->
// Typography -> Size scales the whole carousel. rem sizes ignored it.
---

{
  testimonials.length > 0 && (
    <div data-testimonials class="w-full min-w-0">
      {/* The title is the block's own, not CardCarousel's: it is sized in em
          like the cards, so Block Styles scales it with them. */}
      {data.title && (
        <h2 class="mb-8 text-[1.5em] font-bold leading-[1.333] tracking-tight text-foreground sm:text-[1.875em] sm:leading-[1.2]">
          {data.title}
        </h2>
      )}

      {/* Tablet stays two-up unless the editor picked otherwise, even for a
          one-up desktop: CardCarousel would otherwise follow desktop down. */}
      <CardCarousel
        items={testimonials}
        columns={perViewDesktop}
        tabletColumns={perViewTablet}
        autoPlay={data.autoPlay}
        autoPlayInterval={data.autoPlayInterval}
        arrows={data.showArrows !== false}
        showDots={data.showDots !== false}
      >
        {/* The testimonial card: CardCarousel calls this once per review and
            lays the results out, so this decides only how one card looks. It
            lives here because this block is its only user. When a second place
            needs it, move it to components/testimonials/TestimonialCard.astro
            (taking one review as a prop) along with the Show More script below,
            which works off its data-review-text / data-review-toggle — as
            PracticeAreaCard and NewsCard were. */}
        {(t: (typeof testimonials)[number]) => (
          <div class="flex h-full flex-col bg-card px-8 py-10 sm:px-12 sm:py-12">
            {/* h-full: CardCarousel's slide box is what stretches to the
                tallest card, so the card fills it to keep the rules and the
                names aligned across cards. */}
            {t.rating && (
              <StarRating
                rating={t.rating}
                class="mb-8 flex gap-1"
                starClass="h-9 w-9"
                onClass="text-practice-card"
                offClass="text-border"
              />
            )}

            {/* Clamped to five lines; the script reveals Show More only when
                the text actually overflows, so short reviews get no button. */}
            <p
              data-review-text
              class="line-clamp-5 font-display text-[1.125em] italic leading-relaxed text-foreground md:text-[1.25em]"
            >
              {t.reviewText}
            </p>
            <button
              type="button"
              data-review-toggle
              data-show-more={translate(Astro.locals.language, 'showMore')}
              data-show-less={translate(Astro.locals.language, 'showLess')}
              aria-expanded="false"
              class="mt-4 self-start font-display text-[1.125em] leading-[1.556] text-practice-card hover:underline md:text-[1.25em] md:leading-[1.4]"
              hidden
            >
              {translate(Astro.locals.language, 'showMore')}
            </button>

            {/* mt-auto pins the rule and the name to the bottom, so they line
                up across cards whatever the length of each review. */}
            <div class="mt-auto pt-8">
              <hr class="border-t border-primary" />
              {t.clientName && (
                <p class="mt-6 font-display text-[1.125em] font-bold leading-[1.556] text-foreground">{t.clientName}</p>
              )}
            </div>
          </div>
        )}
      </CardCarousel>
    </div>
  )
}

<script>
  /**
   * Show More / Show Less. The carousel itself is CardCarousel's; this is only
   * the card content. The button starts hidden and is revealed only for a
   * review that actually overflows its five-line clamp — measured, since
   * whether it overflows depends on the card width at this breakpoint.
   *
   * Measured by a ResizeObserver rather than once plus on window resize: the
   * looping copies render hidden and are revealed by the carousel runtime
   * later, and a hidden review measures zero, so each one is measured again
   * whenever its own box changes — when it is revealed and at every width.
   */
  document.querySelectorAll<HTMLElement>('[data-testimonials]').forEach((root) => {
    const toggleFor = (text: HTMLElement) => text.nextElementSibling as HTMLButtonElement | null

    function measure(text: HTMLElement) {
      const button = toggleFor(text)
      if (!button) return
      // An expanded review keeps its button so it can be collapsed again.
      if (button.getAttribute('aria-expanded') === 'true') return
      button.hidden = text.scrollHeight <= text.clientHeight + 1
    }

    const observer = new ResizeObserver((entries) =>
      entries.forEach((entry) => measure(entry.target as HTMLElement)),
    )

    root.querySelectorAll<HTMLElement>('[data-review-text]').forEach((text) => {
      const button = toggleFor(text)
      button?.addEventListener('click', () => {
        const expand = button.getAttribute('aria-expanded') !== 'true'
        text.classList.toggle('line-clamp-5', !expand)
        button.setAttribute('aria-expanded', String(expand))
        // The words come from the page's language (lib/i18n.ts), set on the button.
        button.textContent = (expand ? button.dataset.showLess : button.dataset.showMore) ?? ''
      })
      observer.observe(text)
    })
  })
</script>
