---
/**
 * Renders one block in a column: picks its component (blockRegistry.ts) and
 * applies what an editor set on it — Block Styles, the Style / Advanced /
 * Visibility tabs, Custom CSS, motion. The style logic lives in
 * lib/blockRender.ts; this file only decides how the block is drawn:
 *
 * - nested:       an inner Column, drawn as a Container (no block wrapper)
 * - self-styled:  styles go on the block's own root (Rich Text)
 * - wrapped:      styles go on a <div> around the block
 * - bare:         nothing set, so the block sits directly in its column
 * - unsupported:  a type with no component yet
 */
import {stegaClean} from '@sanity/client/stega'
import BlockStylesWrapper from '@/components/ui/BlockStylesWrapper.astro'
import Container from './sections/Container.astro'
import {BLOCK_COMPONENTS, SELF_STYLED} from './blockRegistry'
import {elementStyle, hasBlockStyles} from '@/lib/blockStyles'
import {animationAttrs} from '@/lib/animation'
import {safeKey, type ContainerSettings} from '@/lib/container'
import {blockCss, blockTabs, layoutMarkers, resolveBlockStyles} from '@/lib/blockRender'
import type {ContentBlock, NestedContainerData} from '@/types/sanity'

interface Props {
  block: ContentBlock
  /** How many columns share this block's row (a map fills its row's height only beside another column). */
  columnCount?: number
  /** Document coordinates and the column's path, passed on to an Inner Container. */
  documentId?: string | null
  documentType?: string | null
  parentPath?: string
  /** The column's own settings, so an inner Column can size itself inside it. */
  parentContainer?: ContainerSettings | null
}

const {block, columnCount, documentId, documentType, parentPath, parentContainer} = Astro.props

const type = stegaClean(block._type)!
const Component = BLOCK_COMPONENTS[type]
const blockKey = safeKey(stegaClean(block._key))

// What the editor set, resolved.
const tabs = blockTabs(block)
const styles = resolveBlockStyles(block, type, tabs, columnCount)
const {cssId, cssClasses, attributes, css} = blockCss(blockKey, styles, tabs)
const animation = animationAttrs(tabs.advanced?.motion ?? styles?.motion)

// A wrapper (or styled root) only exists to carry styles, an animation,
// attributes or a hook for CSS.
const needsWrapper =
  hasBlockStyles(styles) ||
  Object.keys(animation).length > 0 ||
  Object.keys(attributes).length > 0 ||
  Boolean(cssId || cssClasses || css)

/**
 * An Inner Container renders as a container, not a block: Container applies
 * its own styles, Style tab and Custom CSS, so it skips the block wrapper —
 * which would apply them twice, and its [data-pb-h] fill rules would stretch
 * every image and iframe inside it.
 */
const mode =
  type === 'nestedContainer'
    ? 'nested'
    : !Component
      ? 'unsupported'
      : !needsWrapper
        ? 'bare'
        : SELF_STYLED.has(type)
          ? 'self-styled'
          : 'wrapped'

const nestedPath = parentPath && blockKey ? `${parentPath}.content[_key=="${blockKey}"]` : undefined
const selfStyle = mode === 'self-styled' ? elementStyle(styles, {radiusVar: true}) : null
const markers = layoutMarkers(styles)
---

{
  mode === 'nested' && (
    <Container
      data={block as NestedContainerData}
      parentContainer={parentContainer ?? undefined}
      documentId={documentId}
      documentType={documentType}
      basePath={nestedPath}
      nested
    />
  )
}

{mode !== 'nested' && css && <Fragment set:html={`<style>${css}</style>`} />}

{
  mode === 'self-styled' && (
    <Component
      data={block}
      data-pb={blockKey}
      id={cssId}
      class={cssClasses}
      style={selfStyle?.style}
      data-pb-overlay={selfStyle?.overlay ? '' : undefined}
      {...markers}
      {...animation}
      {...attributes}
    />
  )
}

{
  mode === 'wrapped' && (
    <BlockStylesWrapper
      blockStyles={styles}
      radiusVar
      data-pb={blockKey}
      id={cssId}
      class={cssClasses}
      {...markers}
      {...animation}
      {...attributes}
    >
      <Component data={block} />
    </BlockStylesWrapper>
  )
}

{mode === 'bare' && <Component data={block} />}

{
  mode === 'unsupported' && (
    <div class="my-2 rounded-lg border border-dashed border-border p-4 text-center text-xs text-muted">
      Unsupported: <code>{block._type}</code>
    </div>
  )
}
