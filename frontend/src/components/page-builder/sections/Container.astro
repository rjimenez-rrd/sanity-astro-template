---
import {stegaClean} from '@sanity/client/stega'
import {getPublishedId} from '@sanity/client/csm'
import {createDataAttribute} from '@sanity/visual-editing/create-data-attribute'
import {projectId, dataset} from '@/sanity/lib/env'
import BlockRenderer from '../BlockRenderer.astro'
import SectionMedia from './SectionMedia.astro'
import {
  safeCssClasses,
  safeCssId,
  safeKey,
  type ContainerSettings,
  type VisibilitySettings,
} from '@/lib/container'
import {
  buildContainerStyles,
  clean,
  mergeStyles,
  type ContainerAdvanced,
} from '@/lib/containerStyles'
import {elementStyle} from '@/lib/blockStyles'
import {animationAttrs} from '@/lib/animation'
import {resolveHref, type LinkItem} from '@/lib/links'
import {parseAttributes} from '@/lib/advancedCss'
import {type DesignSettings} from '@/lib/design'
import type {ContainerBlockData, NestedContainerData} from '@/types/sanity'

/** A top-level Container, or an Inner Container placed in a column. */
type ContainerData = ContainerBlockData | NestedContainerData

interface Props {
  data: ContainerData
  /** Document coordinates, so Presentation can select a container on click. */
  documentId?: string | null
  documentType?: string | null
  /**
   * This container's path in the document, for Presentation. Top-level rows
   * sit at pageBuilder[_key==…]; an Inner Container is several levels down,
   * so its caller passes the full path.
   */
  basePath?: string
  /** Rendered inside a column rather than as a page section. */
  nested?: boolean
  /** When nested: the settings of the column it sits in, to size it as an item. */
  parentContainer?: ContainerSettings | null
}

const {data, documentId, documentType, basePath, nested = false, parentContainer} = Astro.props

type Advanced = ContainerAdvanced | null

type Column = ContainerData['columns'][number] & {
  label?: string | null
  design?: DesignSettings | null
  container?: ContainerSettings | null
  advanced?: Advanced
  visibility?: VisibilitySettings | null
}

type Row = ContainerData & {
  label?: string | null
  design?: DesignSettings | null
  container?: ContainerSettings | null
  advanced?: Advanced
  visibility?: VisibilitySettings | null
}

const row = data as Row



// --- Container settings (Elementor-style Layout / Style / Advanced / Visibility) ---

/**
 * Draft requests are the Presentation preview. Container names and the empty
 * placeholder are editing aids, so they are rendered only here — a published
 * page never gets the markup at all.
 */
const editing = Astro.locals.isDraft === true
const rowLabel = editing ? stegaClean(row.label)?.trim() || undefined : undefined

/**
 * Tells Presentation which field a clicked element maps to, so tapping a
 * container selects it. Draft-only: a published page carries no such markup.
 * Keys are validated by safeKey before reaching the path.
 */
const docId = documentId ? getPublishedId(stegaClean(documentId)) : undefined
const docType = stegaClean(documentType ?? '') || undefined
const sanityAttr = (path: string): string | undefined =>
  editing && docId && docType
    ? createDataAttribute({projectId, dataset, id: docId, type: docType, path}).toString()
    : undefined

const rowContainer = clean(row.container) ?? undefined
const rowKey = safeKey(stegaClean(row._key))
const rowPath = basePath ?? (rowKey ? `pageBuilder[_key=="${rowKey}"]` : undefined)

/** The chosen HTML tag if it's one of the offered ones, else the default. */
const TAGS = new Set(['div', 'section', 'article', 'aside', 'header', 'footer', 'main', 'nav'])
const htmlTag = (value: string | null | undefined, fallback: string) =>
  (value && TAGS.has(value) ? value : fallback) as 'div'

const columns = ((row.columns ?? []) as Column[]).map((column) => {
  const key = safeKey(stegaClean(column._key))
  const advanced = clean(column.advanced)
  const design = clean(column.design)
  const path = key && rowPath ? `${rowPath}.columns[_key=="${key}"]` : undefined
  // Advanced -> Link: the whole column clickable (see the overlay link below).
  const linkItems = ((column as {link?: unknown[]}).link ?? []) as LinkItem[]
  const link = resolveHref(linkItems, Astro.locals.language)
  const linkTitle = stegaClean((linkItems[0] as {title?: string} | undefined)?.title)?.trim()
  return {
    design,
    column,
    key,
    path,
    // Layout -> Additional Options -> HTML Tag; Advanced -> Attributes.
    tag: htmlTag(clean(column.container)?.htmlTag, 'div'),
    attributes: parseAttributes(advanced?.attributes),
    label: editing ? stegaClean(column.label)?.trim() || undefined : undefined,
    sanity: path ? sanityAttr(path) : undefined,
    container: clean(column.container) ?? undefined,
    ...elementStyle(mergeStyles(column.blockStyles, advanced ?? null, design)),
    id: safeCssId(advanced?.cssId),
    classes: safeCssClasses(advanced?.cssClasses),
    zIndex: advanced?.zIndex,
    visibility: clean(column.visibility),
    animation: animationAttrs(advanced?.motion),
    href: link.missing ? undefined : link.href,
    external: link.isExternal,
    linkLabel: linkTitle || stegaClean(column.label)?.trim() || undefined,
  }
})

const rowAdvanced = clean(row.advanced)
const rowDesign = clean(row.design)

const cssText = buildContainerStyles({
  itemOf: nested ? (parentContainer ?? {}) : undefined,
  key: rowKey,
  container: rowContainer,
  layout: row.layout,
  design: rowDesign,
  visibility: row.visibility,
  advanced: rowAdvanced ?? null,
  blockStyles: row.blockStyles,
  columns: columns.map((col) => ({
    key: col.key,
    container: col.container,
    design: col.design,
    visibility: col.visibility,
    zIndex: col.zIndex,
    advanced: col.column.advanced ?? null,
    blockStyles: col.column.blockStyles,
  })),
})

const rowStyle = elementStyle(
  mergeStyles(row.blockStyles, rowAdvanced ?? null, rowDesign),
)

// A page section at the top level, inside a column just a box — unless Layout
// -> Additional Options -> HTML Tag picks another.
const Element = htmlTag(clean(row.container)?.htmlTag, nested ? 'div' : 'section')

---

{cssText && <Fragment set:html={`<style>${cssText}</style>`} />}

{/*
  One element per level. A column is simultaneously the row's flex/grid item,
  its own styled box, and the flex container for its blocks — as in Elementor.
*/}
<Element
  {...parseAttributes(rowAdvanced?.attributes)}
  data-pb={rowKey}
  id={safeCssId(rowAdvanced?.cssId)}
  class={safeCssClasses(rowAdvanced?.cssClasses)}
  style={rowStyle.style}
  data-sanity={rowPath ? sanityAttr(rowPath) : undefined}
  data-pb-label={rowLabel}
  data-pb-overlay={rowStyle.overlay ? '' : undefined}
  data-pb-hfont={rowStyle.headingFont ? '' : undefined}
  data-pb-nested={nested ? '' : undefined}
  {...animationAttrs(rowAdvanced?.motion)}
>
  <SectionMedia elementKey={rowKey} design={rowDesign} />
  <div data-pb-inner={rowKey}>
    {
      columns.map((col) => {
        const content = col.column.content ?? []
        const ColumnTag = col.tag
        return (
          <ColumnTag
            {...col.attributes}
            class={[col.classes, col.href && 'relative cursor-pointer'].filter(Boolean).join(' ') || undefined}
            id={col.id}
            data-pb-link={col.href ? '' : undefined}
            data-pb={col.key}
            data-sanity={col.sanity}
            data-pb-label={col.label}
            data-pb-col={editing ? '' : undefined}
            data-pb-inner={col.container ? col.key : undefined}
            data-pb-overlay={col.overlay ? '' : undefined}
            data-pb-hfont={col.headingFont ? '' : undefined}
            style={col.style}
            {...col.animation}
          >
            <SectionMedia elementKey={col.key} design={col.design} />
            {/* A linked column: an empty link stretched over it, so the whole
                column is clickable without wrapping its buttons and links in
                another link (not allowed in HTML). global.css lifts those above
                it, so they still go to their own pages. In the Studio preview
                it lets clicks through, so the column's blocks stay editable. */}
            {col.href && (
              <a
                href={col.href}
                target={col.external ? '_blank' : undefined}
                rel={col.external ? 'noopener noreferrer' : undefined}
                aria-label={col.linkLabel}
                class={`absolute inset-0 z-[1] cursor-pointer ${editing ? 'pointer-events-none' : ''}`}
                data-pb-link-overlay
              />
            )}
            {content.map((block) => (
              <BlockRenderer
                block={block}
                columnCount={columns.length}
                documentId={documentId}
                documentType={documentType}
                parentPath={col.path}
                parentContainer={col.container}
              />
            ))}
            {editing && content.length === 0 && (
              <div class="flex min-h-[100px] items-center justify-center rounded-lg border border-dashed border-border text-sm text-muted">
                Empty column
              </div>
            )}
          </ColumnTag>
        )
      })
    }
  </div>
</Element>
