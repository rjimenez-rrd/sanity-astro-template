---
import {stegaClean} from '@sanity/client/stega'
import BlockStylesWrapper from '@/components/ui/BlockStylesWrapper.astro'
import SanityImage from '@/components/sanity/SanityImage.astro'
import CallToAction from '../blocks/CallToAction.astro'
import BadgePill from '@/components/ui/BadgePill.astro'
import type {HeroSectionData} from '@/types/sanity'

interface Props {
  data: HeroSectionData
}

const {data} = Astro.props

const MAX_WIDTH_MAP: Record<string, string> = {
  narrow: 'max-w-3xl',
  default: 'max-w-7xl',
  wide: 'max-w-[1400px]',
}

const ALIGN_MAP: Record<string, string> = {
  left: 'text-left items-start',
  center: 'text-center items-center',
  right: 'text-right items-end',
}

function buildBackground(hero: HeroSectionData): string | undefined {
  const parts: string[] = []
  const bgType = stegaClean(hero.backgroundType)

  if (bgType === 'gradient' && hero.gradientFrom && hero.gradientTo) {
    const direction = stegaClean(hero.gradientDirection) || 'to bottom right'
    parts.push(
      `background:linear-gradient(${direction}, ${stegaClean(hero.gradientFrom)}, ${stegaClean(hero.gradientTo)})`,
    )
  } else if (bgType === 'color' && hero.backgroundColor) {
    parts.push(`background-color:${stegaClean(hero.backgroundColor)}`)
  }

  const minHeight = stegaClean(hero.minHeight)
  if (minHeight && minHeight !== 'auto') parts.push(`min-height:${minHeight}`)

  if (hero.textColor) parts.push(`color:${stegaClean(hero.textColor)}`)

  return parts.length > 0 ? parts.join(';') : undefined
}

const isSplit = stegaClean(data.layout) === 'split'
const backgroundStyle = buildBackground(data)
const maxWidthClass = MAX_WIDTH_MAP[stegaClean(data.maxWidth) || 'default']
const buttons = data.buttons ?? []

// Full-width variant
const alignClass = ALIGN_MAP[stegaClean(data.alignment) || 'center'] || ALIGN_MAP.center
const bgType = stegaClean(data.backgroundType)
const hasMediaBg = bgType === 'image' || bgType === 'video'
const overlayOpacity = (data.overlay ?? 0) / 100

// Split variant
const isMediaLeft = stegaClean(data.mediaPosition) === 'left'
---

<BlockStylesWrapper blockStyles={data.blockStyles}>
  {
    isSplit ? (
      <section style={backgroundStyle}>
        <div class={`mx-auto px-4 py-16 sm:px-6 lg:px-8 ${1500}`}>
          <div class="grid items-center gap-8 md:grid-cols-2 lg:gap-16">
            {/* Text column */}
            <div class={isMediaLeft ? 'order-2' : 'order-1 md:order-1'}>
              {data.badge && <BadgePill badge={data.badge} badgeLink={data.badgeLink} />}

              {data.heading && (
                <h1 class="text-4xl font-bold tracking-tighter sm:text-5xl lg:text-6xl">
                  {data.heading}
                </h1>
              )}

              {data.subtitle && (
                <p class="mt-6 text-lg leading-relaxed opacity-80">{data.subtitle}</p>
              )}

              {buttons.length > 0 && (
                <div class="mt-8 flex flex-wrap gap-4">
                  {buttons.map((btn) => (
                    <CallToAction data={btn} />
                  ))}
                </div>
              )}
            </div>

            {/* Media column */}
            <div class={isMediaLeft ? 'order-1' : 'order-2 md:order-2'}>
              {data.mediaImage?.asset && (
                <SanityImage
                  value={data.mediaImage}
                  width={data.mediaImage.asset.metadata?.dimensions?.width || 1200}
                  height={data.mediaImage.asset.metadata?.dimensions?.height || 750}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  class="w-full rounded-2xl"
                  priority
                />
              )}
            </div>
          </div>
        </div>
      </section>
    ) : (
      <section class="relative flex items-center overflow-hidden" style={backgroundStyle}>
        {/* Background image */}
        {bgType === 'image' && data.backgroundImage?.asset && (
          <SanityImage
            value={data.backgroundImage}
            alt=""
            width={1920}
            fill
            sizes="100vw"
            quality={80}
            class="object-cover"
            priority
          />
        )}

        {/* Background video */}
        {bgType === 'video' && data.backgroundVideo && (
          <video autoplay muted loop playsinline class="absolute inset-0 h-full w-full object-cover">
            <source src={data.backgroundVideo} type="video/mp4" />
          </video>
        )}

        {/* Overlay */}
        {hasMediaBg && overlayOpacity > 0 && (
          <div class="absolute inset-0 bg-black" style={`opacity:${overlayOpacity}`} />
        )}

        <div class={`relative z-10 mx-auto w-full px-4 py-20 sm:px-6 lg:px-8 ${maxWidthClass}`}>
          <div class={`flex flex-col ${alignClass}`}>
            {data.badge && <BadgePill badge={data.badge} badgeLink={data.badgeLink} />}

            {data.heading && (
              <h1 class="text-4xl font-bold tracking-tighter sm:text-5xl md:text-6xl lg:text-7xl">
                {data.heading}
              </h1>
            )}

            {data.subtitle && (
              <p class="mt-6 max-w-2xl text-lg leading-relaxed opacity-80 sm:text-xl">
                {data.subtitle}
              </p>
            )}

            {buttons.length > 0 && (
              <div class="mt-8 flex flex-wrap justify-center gap-4">
                {buttons.map((btn) => (
                  <CallToAction data={btn} />
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }
</BlockStylesWrapper>
