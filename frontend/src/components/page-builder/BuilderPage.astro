---
/**
 * A builder page (Page or Practice Area) as its routes render it: breadcrumbs
 * when it sits under a Parent Page, then its sections. Shared by
 * [...slug].astro and es/[...slug].astro.
 */
import Site from '@/layouts/Site.astro'
import SectionRenderer from '@/components/page-builder/SectionRenderer.astro'
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro'
import {buildSeo} from '@/lib/seo'
import type {Language} from '@/lib/i18n'
import type {PageData, SiteSettings} from '@/types/sanity'

interface Props {
  page: PageData
  settings: SiteSettings | null
  language: Language
  /** Page 2+ of a paginated card list on this page. */
  listPage?: number
}

const {page, settings, language, listPage} = Astro.props

const seo = buildSeo(page.seo, {title: page.title})
// Each list page gets its own title, so search results don't show identical ones.
const title = listPage ? (seo.title ? `${seo.title} – Page ${listPage}` : `Page ${listPage}`) : seo.title
---

<Site settings={settings} {...seo} title={title}>
  <Breadcrumbs page={page} language={language} />
  <SectionRenderer sections={page.pageBuilder} documentId={page._id} documentType={page._type} />
</Site>
