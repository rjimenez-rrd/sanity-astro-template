---
import {stegaClean} from '@sanity/client/stega'
import SanityImage from '@/components/shared/SanityImage.astro'
import PortableTextRenderer from '@/components/shared/PortableTextRenderer.astro'
import type {BlogPostData} from '@/types/sanity'

interface Props {
  post: BlogPostData
}

const {post} = Astro.props

const publishedAt = stegaClean(post.publishedAt)
const formattedDate = publishedAt
  ? new Date(publishedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null
const dims = post.coverImage?.asset?.metadata?.dimensions
---

<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
  {/* Header */}
  <header class="mb-8">
    <div class="flex items-center gap-2 text-sm text-muted">
      {formattedDate && <time datetime={publishedAt}>{formattedDate}</time>}
      {
        post.author && (
          <>
            <span>&middot;</span>
            <span>{post.author}</span>
          </>
        )
      }
    </div>
    <h1 class="mt-4 text-3xl font-bold tracking-tighter text-foreground sm:text-4xl lg:text-5xl">
      {post.title}
    </h1>
  </header>

  {/* Cover image */}
  {
    post.coverImage?.asset && (
      <div class="mb-10 overflow-hidden rounded-2xl">
        <SanityImage
          value={post.coverImage}
          alt={stegaClean(post.coverImage.alt) || post.title || ''}
          width={dims?.width || 1200}
          height={dims?.height || 675}
          sizes="(max-width: 768px) 100vw, 768px"
          quality={80}
          class="w-full"
          priority
        />
      </div>
    )
  }

  {/* Body */}
  {
    post.body && post.body.length > 0 && (
      <div class="prose prose-slate prose-lg max-w-none">
        <PortableTextRenderer value={post.body} />
      </div>
    )
  }
</article>
