---
import {stegaClean} from '@sanity/client/stega'
import SanityImage from '@/components/sanity/SanityImage.astro'
import type {BlogPostListItem} from '@/types/sanity'

interface Props {
  post: BlogPostListItem
}

const {post} = Astro.props

const slug = post.slug?.current
const publishedAt = stegaClean(post.publishedAt)
const formattedDate = publishedAt
  ? new Date(publishedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null
---

{
  slug && (
    <article class="group">
      <a href={`/blog/${slug}`} class="block">
        {post.coverImage?.asset && (
          <div class="overflow-hidden rounded-xl">
            <SanityImage
              value={post.coverImage}
              alt={stegaClean(post.coverImage.alt) || post.title || ''}
              width={600}
              height={340}
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
              class="aspect-[16/9] w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
        )}
        <div class="mt-4">
          <div class="flex items-center gap-2 text-xs text-muted">
            {formattedDate && <time datetime={publishedAt}>{formattedDate}</time>}
            {post.author && (
              <>
                <span>&middot;</span>
                <span>{post.author}</span>
              </>
            )}
          </div>
          <h2 class="mt-2 text-lg font-semibold text-foreground transition-colors group-hover:text-primary">
            {post.title}
          </h2>
          {post.excerpt && <p class="mt-1 line-clamp-2 text-sm text-muted">{post.excerpt}</p>}
        </div>
      </a>
    </article>
  )
}
