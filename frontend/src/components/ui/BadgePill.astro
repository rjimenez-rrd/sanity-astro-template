---
interface Props {
  badge: string
  badgeLink?: string | null
}

const {badge, badgeLink} = Astro.props

const classes =
  'mb-6 inline-flex items-center rounded-full border border-current/10 bg-foreground/5 px-4 py-1.5 text-sm font-medium backdrop-blur-sm'
const ARROW_PATH = 'M9 5l7 7-7 7'
---

{
  badgeLink ? (
    <a href={badgeLink} class={`${classes} transition-colors hover:bg-foreground/10`}>
      {badge}
      <svg class="ml-2 h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
        <path stroke-linecap="round" stroke-linejoin="round" d={ARROW_PATH} />
      </svg>
    </a>
  ) : (
    <span class={classes}>{badge}</span>
  )
}
