---
/**
 * The shared card carousel. It owns everything a card block would otherwise
 * repeat — per-breakpoint card widths, the looping copies, the track, the dots
 * and the runtime in lib/cardCarousel.ts — so a block only says how one card
 * looks, as a function child:
 *
 *   <CardCarousel items={lawyers} columns={3}>
 *     {(lawyer) => <article>…</article>}
 *   </CardCarousel>
 *
 * The extras one block needs and the rest don't (arrows, no dots) are props
 * that default to off, so adding one never changes the blocks that don't ask.
 *
 * A fix or a new option here reaches every card carousel at once.
 */
import {stegaClean} from '@sanity/client/stega'
import {t} from '@/lib/i18n'
import StrokeIcon from '@/components/icons/StrokeIcon.astro'

interface Props {
  items: unknown[]
  /** Cards per view on desktop, 1–4. */
  columns?: string | number | null
  /** Cards per view on tablet (768–1024px), 1–4. Unset keeps the default. */
  tabletColumns?: string | number | null
  title?: string | null
  subtitle?: string | null
  autoPlay?: boolean | null
  autoPlayInterval?: number | null
  /** At two-up (tablet), take a second row before paging, so four cards read as a 2x2. */
  wrapRows?: boolean
  /** On phones, stack every card instead of paging through them. */
  stackOnMobile?: boolean | null
  /** Previous / next buttons either side of the track, a page at a time. Off by default. */
  arrows?: boolean | null
  /** The page dots under the track. On by default; false leaves them out. */
  showDots?: boolean | null
}

const {
  items,
  columns,
  tabletColumns,
  title,
  subtitle,
  autoPlay,
  autoPlayInterval,
  wrapRows = false,
  stackOnMobile = false,
  arrows = false,
  showDots = true,
} = Astro.props

/**
 * Card width per breakpoint, written as custom properties and promoted to real
 * widths by the rules in global.css, so no generated class names are needed.
 * Each width subtracts the card's share of the 1.5rem gap, or the cards
 * overflow the track. Mobile is always one card, forced by global.css.
 */
const CARD_WIDTH: Record<number, string> = {
  1: '100%',
  2: 'calc(50% - 0.75rem)',
  3: 'calc(33.333% - 1rem)',
  4: 'calc(25% - 1.125rem)',
}

const requested = Number(stegaClean(columns ?? '3'))
const perViewDesktop = CARD_WIDTH[requested] ? requested : 3
// An explicit tablet count wins; otherwise tablet halves a 3- or 4-up row and
// leaves 1 and 2 as they are.
const requestedTablet = Number(stegaClean(tabletColumns ?? ''))
const perViewTablet = CARD_WIDTH[requestedTablet]
  ? requestedTablet
  : Math.min(perViewDesktop, 2)

const cardStyle = [
  `--card-w:${CARD_WIDTH[perViewDesktop]}`,
  `--card-w-tablet:${CARD_WIDTH[perViewTablet]}`,
].join(';')

/**
 * Each real card is rendered once, then repeated for the loop: the runtime
 * scrolls into the copies and rewinds out of them, which is what makes the
 * loop seamless. Two passes cover a full row; below that it takes three to
 * avoid a gap at the wrap. Copies render hidden and are revealed only when the
 * cards don't all fit, so they never flash before the script runs — and with
 * no JS the block is a plain row of the real cards.
 */
const cards = await Promise.all(items.map((item, i) => Astro.slots.render('default', [item, i])))
const loops = cards.length < 2 ? 1 : cards.length >= perViewDesktop ? 2 : 3
const looped = Array.from({length: loops}, () => cards).flat()

// The arrows sit on the track's edges, so with them the track needs a
// positioned box to hang them on. Without them it gets none, and the markup is
// what it always was.
const TrackBox = arrows ? 'div' : Fragment
---

{
  cards.length > 0 && (
    <div
      data-card-carousel
      class="w-full min-w-0 "
      data-card-carousel-wrap={wrapRows ? '' : undefined}
      data-card-carousel-stack-mobile={stackOnMobile ? '' : undefined}
      data-count={String(cards.length)}
      data-autoplay={autoPlay ? 'true' : 'false'}
      data-interval={String(autoPlayInterval || 5)}
      data-dot-label={t(Astro.locals.language, 'goToSlide')}
    >
      {title && <h2 class="mb-2 font-display text-3xl font-bold md:text-4xl">{title}</h2>}
      {subtitle && <p class="mb-8 max-w-2xl text-muted">{subtitle}</p>}

      {/* No scroll-smooth class: the rewind out of the copies must be an
          instant jump (cardCarousel.ts asks for behavior:'instant'), and a
          smooth CSS scroll-behavior here would be one more thing able to
          animate the seam. */}
      <TrackBox {...(arrows ? {class: 'relative'} : {})}>
        <div
          data-card-carousel-track
          class="flex snap-x snap-mandatory gap-6 overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {looped.map((html, i) => (
            <div
              style={cardStyle}
              class="shrink-0 snap-start"
              aria-hidden={i >= cards.length ? 'true' : undefined}
              {...(i >= cards.length ? {hidden: true} : {})}
            >
              <Fragment set:html={html} />
            </div>
          ))}
        </div>

        {/* Hidden like the dots until the runtime knows there is more than one
            page to move through; with no JS they could do nothing anyway. */}
        {arrows && (
          <>
            <button
              type="button"
              data-card-carousel-prev
              class="absolute -left-3 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-background shadow-sm transition-colors hover:bg-muted/30"
              aria-label={t(Astro.locals.language, 'previous')}
              hidden
            >
              <StrokeIcon name="chevron-left" class="h-4 w-4" />
            </button>
            <button
              type="button"
              data-card-carousel-next
              class="absolute -right-3 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-background shadow-sm transition-colors hover:bg-muted/30"
              aria-label={t(Astro.locals.language, 'next')}
              hidden
            >
              <StrokeIcon name="chevron-right" class="h-4 w-4" />
            </button>
          </>
        )}
      </TrackBox>

      {/* Filled by the runtime: one dot per page, and a page is however many
          cards fit at the current breakpoint. */}
      {showDots !== false && (
        <div class="mt-6 flex justify-center gap-2" data-card-carousel-dots hidden />
      )}
    </div>
  )
}

<script>
  import {initCardCarousels} from '@/lib/cardCarousel'
  initCardCarousels()
</script>
