---
/**
 * Five stars, the first `rating` of them filled, with the rating read out to
 * screen readers ("4 out of 5 stars") in the page's language.
 */
import {t} from '@/lib/i18n'

interface Props {
  rating: number
  /** The row's classes (spacing and layout). */
  class?: string
  /** Each star's size. */
  starClass: string
  /** Colors for a filled and an empty star. */
  onClass: string
  offClass: string
}

const {rating, class: className, starClass, onClass, offClass} = Astro.props

const STAR_PATH =
  'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z'
---

<div class={className} aria-label={t(Astro.locals.language, 'stars', {rating})}>
  {
    Array.from({length: 5}, (_, i) => (
      <svg
        class={`${starClass} ${i < rating ? onClass : offClass}`}
        fill="currentColor"
        viewBox="0 0 20 20"
        aria-hidden="true"
      >
        <path d={STAR_PATH} />
      </svg>
    ))
  }
</div>
