---
/**
 * Expandable rows (native <details>), shared by the Accordion and FAQ blocks.
 * They work with no JavaScript: `name` makes a group exclusive (opening one
 * closes the others). The script below only adds the motion: a browser shows
 * and hides a <details>' content instantly, so no CSS transition can run on
 * it; the script animates the panel's height instead, opening and closing.
 */
import PortableTextRenderer from '@/components/sanity/PortableTextRenderer.astro'
import SanityImage, {type SanityImageValue} from '@/components/sanity/SanityImage.astro'
import {t} from '@/lib/i18n'

export interface DisclosureItem {
  key: string
  title: string
  /** Rich text shown when open. */
  content?: Array<Record<string, unknown>> | null
  /** Optional small image before the title. */
  icon?: SanityImageValue | null
}

interface Props {
  items: DisclosureItem[]
  /** Only one row open at a time. */
  exclusive?: boolean
  /** The first row starts open. */
  firstOpen?: boolean
  /** Shown in a row with no content. */
  emptyText: string
  /**
   * cards: each row its own white card on the page background, a bold
   * question and a filled chevron circle that flips when open (Accordion).
   * roomy: one bordered box, more space, a "+" that turns into an "x" when open (FAQ).
   */
  variant?: 'cards' | 'roomy'
}

const {items, exclusive = false, firstOpen = false, emptyText, variant = 'cards'} = Astro.props

const roomy = variant === 'roomy'
// Unique per group, so two exclusive groups on a page don't close each other.
const groupName = exclusive ? `disclosure-${items[0]?.key ?? 'group'}` : undefined
const rowPadding = roomy ? 'px-6 py-5' : 'px-6 py-6 md:px-[30px] md:py-7'
const panelPadding = roomy ? 'px-6 pb-5' : 'border-t-2 border-background px-6 pt-6 pb-7 md:px-[30px] md:pt-7 md:pb-8'
// The answer: larger, airier text in a softer navy (cards only).
const answerText = roomy ? '' : 'text-[1.0625rem] leading-[1.7] text-foreground/85 md:text-[1.125rem]'
---

<div data-disclosure class={roomy ? 'divide-y divide-border rounded-xl border border-border' : 'flex flex-col gap-3'}>
  {
    items.map((item, index) => (
      <details class={`group ${roomy ? '' : 'bg-card'}`} name={groupName} open={firstOpen && index === 0 ? true : undefined}>
        <summary
          class={`flex w-full cursor-pointer list-none items-center justify-between text-left transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary ${rowPadding} ${roomy ? 'hover:bg-muted/30' : ''}`}
        >
          <span
            class={`flex items-center gap-3 pr-4 text-foreground ${roomy ? 'font-medium' : 'font-display text-lg font-semibold leading-snug md:text-[1.375rem]'}`}
          >
            {item.icon ? <SanityImage value={item.icon} width={48} class="h-6 w-6 shrink-0 object-contain" /> : null}
            {item.title || t(Astro.locals.language, 'untitled')}
          </span>
          {roomy ? (
            <span
              class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-muted"
              data-chevron="plus"
              aria-hidden="true"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 3v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <path d="M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </span>
          ) : (
            <span
              class="ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground"
              data-chevron="flip"
              aria-hidden="true"
            >
              <svg width="16" height="16" viewBox="0 0 12 12" fill="none">
                <path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          )}
        </summary>
        {/* overflow-hidden: the script animates this box's height. */}
        <div class="overflow-hidden" data-disclosure-panel>
          <div class={panelPadding}>
            {item.content && item.content.length > 0 ? (
              <div class={`prose prose-slate max-w-none ${answerText}`}>
                <PortableTextRenderer value={item.content} />
              </div>
            ) : (
              <p class="text-sm text-muted">{emptyText}</p>
            )}
          </div>
        </div>
      </details>
    ))
  }
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  /* Open: the chevron flips, the + turns into an x. A row the script is
     closing (data-closing) turns back straight away, not when its panel has
     finished shrinking. */
  [data-chevron] {
    transition: transform 0.2s ease;
  }
  details[open]:not([data-closing]) > summary [data-chevron='flip'] {
    transform: rotate(180deg);
  }
  details[open]:not([data-closing]) > summary [data-chevron='plus'] {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-chevron] {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Open and close each row smoothly (lib/collapse.ts, the same motion as the
   * Table of Contents); the chevron and + already turn with CSS. The script
   * takes over exclusivity from `name` — set, the browser would snap the other
   * row shut the moment this one opens — and closes the other row with the
   * same motion.
   */
  import {collapse, expand} from '@/lib/collapse'

  const panelOf = (details: HTMLDetailsElement) =>
    details.querySelector<HTMLElement>(':scope > [data-disclosure-panel]')

  async function setOpen(details: HTMLDetailsElement, open: boolean) {
    if (details.open === open || details.dataset.animating) return
    const panel = panelOf(details)
    details.dataset.animating = ''
    if (open) {
      details.open = true
      if (panel) await expand(panel)
    } else {
      // Turns the chevron back now rather than when the panel has finished shrinking.
      details.dataset.closing = ''
      if (panel) await collapse(panel)
      details.open = false
      delete details.dataset.closing
    }
    delete details.dataset.animating
  }

  document.querySelectorAll<HTMLElement>('[data-disclosure]').forEach((group) => {
    const rows = [...group.querySelectorAll<HTMLDetailsElement>(':scope > details')]
    const exclusive = rows.some((row) => row.hasAttribute('name'))
    rows.forEach((row) => row.removeAttribute('name'))

    rows.forEach((row) => {
      row.querySelector('summary')?.addEventListener('click', (event) => {
        event.preventDefault()
        const opening = !row.open
        if (opening && exclusive) rows.forEach((other) => other !== row && setOpen(other, false))
        setOpen(row, opening)
      })
    })
  })
</script>
