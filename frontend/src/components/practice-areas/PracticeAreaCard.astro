---
import {stegaClean} from '@sanity/client/stega'
import SanityImage from '@/components/sanity/SanityImage.astro'
import type {PracticeAreaListItem} from '@/types/sanity'
import {localizedPath} from '@/lib/i18n'

interface Props {
  area: PracticeAreaListItem
  /** Where the name sits in the bar. */
  align?: 'left' | 'center'
  /** Put each word of the name on its own line. */
  stackWords?: boolean
  /**
   * Stacked cards run the full width of a phone, where the 11:10 crop would
   * make each one taller than the screen. 'wide' gives them a banner crop
   * below 768px — the same breakpoint the carousel uses for one card per view
   * — and the usual crop from there up.
   */
  mobileAspect?: 'card' | 'wide'
  /**
   * Stretch to the height of the grid row, with the name bar taking the
   * slack — so a name that wraps to two lines doesn't leave its neighbours'
   * bars shorter and the row ragged. Only a grid needs it; a carousel's cards
   * sit in a flex row that already sizes them.
   */
  fillHeight?: boolean
}

const {area, align = 'center', stackWords = false, mobileAspect = 'card', fillHeight = false} = Astro.props
const slug = stegaClean(area.slug?.current)

/**
 * Card Title wins over Title when it is set: an editor who typed their own
 * line breaks has said exactly where the name should wrap, so One Word Per
 * Line must not fight it. Failing that, the toggle splits the title on
 * spaces. Either way whitespace-pre-line is what renders the breaks.
 */
const custom = area.cardTitle?.trim()
const label = custom
  ? custom
  : stackWords
    ? // stegaClean first: in Presentation every string carries ~900 invisible
      // characters for click-to-edit, and JS treats one of them (U+FEFF) as
      // whitespace — splitting the raw string turns two words into hundreds of
      // lines. Only this branch loses click-to-edit, and only while stacking.
      (stegaClean(area.title) ?? '').trim().split(/\s+/).join('\n')
    : area.title
---

{
  slug && (
    <a
      href={localizedPath(slug!, area.language)}
      class={`group overflow-hidden ${fillHeight ? 'flex h-full flex-col' : 'block'}`}
    >
      <div
        class={`overflow-hidden bg-foreground/10 ${
          mobileAspect === 'wide' ? 'aspect-[16/6] md:aspect-[11/10]' : 'aspect-[11/10]'
        }`}
      >
        {area.coverImage?.asset && (
          <SanityImage
            value={area.coverImage}
            alt={stegaClean(area.coverImage.alt) || ''}
            width={480}
            height={436}
            sizes="(max-width: 767px) 100vw, (max-width: 1024px) 50vw, 33vw"
            class="h-full w-full object-cover grayscale transition-[filter] duration-500 group-hover:grayscale-0 group-focus-visible:grayscale-0"
          />
        )}
      </div>
      <h2
        class={`whitespace-pre-line bg-practice-card px-6 py-3 font-display text-2xl font-semibold text-white ${
          align === 'left' ? 'text-left' : 'text-center'
        } ${fillHeight ? `flex flex-1 items-center ${align === 'left' ? 'justify-start' : 'justify-center'}` : ''}`}
      >
        {label}
      </h2>
    </a>
  )
}
