---
/**
 * A Practice Area's page: the hero, then its Page Builder sections beside the
 * sidebar, and a full-width CTA Form under both. Above the sections, who
 * reviewed the content and when it was last updated, then a Table of
 * Contents. Without a sidebar the sections take the full width rather than
 * leaving its column empty.
 */
import SectionRenderer from '@/components/page-builder/SectionRenderer.astro'
import TocBlock from '@/components/page-builder/blocks/TocBlock.astro'
import BottomForm from '@/components/forms/BottomForm.astro'
import PracticeAreaHero from './PracticeAreaHero.astro'
import PracticeAreaSidebar from './PracticeAreaSidebar.astro'
import {CONTENT_WIDTH} from '@/lib/maxWidth'
import {postDate} from '@/lib/news'
import {t, type Language} from '@/lib/i18n'
import type {PracticeAreaPageData, TocBlockData} from '@/types/sanity'

interface Props {
  page: PracticeAreaPageData
  language: Language
}

const {page, language} = Astro.props

const hasSidebar = Boolean(page.sidebarForm?.form || page.location || page.relatedPages?.some((p) => p?.slug))

const reviewedBy = page.reviewedBy
const updated = postDate(page.updatedAt, language)

// Unset counts as on: both default to on, and pages saved before the
// toggles existed have neither.
const toc = page.showToc !== false ? ({_type: 'tocBlock', title: t(language, 'tableOfContents')} as TocBlockData) : null

const bottomForm = page.showBottomForm !== false ? page.bottomForm : null
---

<PracticeAreaHero page={page} />
{/* Padding outside the 1360px box, as the header has it, so the content is
    the full 1360px and lines up with the logo. With a sidebar: 70% content,
    30% sidebar, from 1024px up; below that, the sidebar goes under. */}
<div class="px-4 py-12 md:px-8 md:py-16">
<div
  class={`mx-auto ${CONTENT_WIDTH} ${hasSidebar ? 'grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,3fr)] lg:gap-12' : ''}`}
>
  <div class="min-w-0">
    {
      (reviewedBy || updated) && (
        <div class="mb-10 flex flex-wrap items-start justify-between gap-x-8 gap-y-4 font-display text-lg text-foreground">
          {reviewedBy && (
            <p>
              {t(language, 'contentReviewedBy')}
              <span class="block font-bold">{reviewedBy}</span>
            </p>
          )}
          {updated && (
            <p class="ml-auto text-right">
              {t(language, 'dateLastUpdated')}
              <span class="block font-bold">{updated}</span>
            </p>
          )}
        </div>
      )
    }
    {
      toc && (
        <div class="mb-12">
          <TocBlock data={toc} collapsed />
        </div>
      )
    }
    <SectionRenderer sections={page.pageBuilder} documentId={page._id} documentType={page._type} />
  </div>
  {hasSidebar && <PracticeAreaSidebar page={page} language={language} />}
</div>
</div>
{bottomForm && <BottomForm cta={bottomForm} />}
