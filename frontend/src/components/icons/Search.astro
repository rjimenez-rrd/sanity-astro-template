---
/** A magnifying glass, stroked in currentColor. */
interface Props {
  class?: string
}

const {class: className} = Astro.props
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={3} aria-hidden="true">
  <circle cx="11" cy="11" r="7" />
  <path stroke-linecap="round" d="M20 20l-3.5-3.5" />
</svg>
