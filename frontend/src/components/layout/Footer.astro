---
import {stegaClean} from '@sanity/client/stega'
import SanityImage from '@/components/sanity/SanityImage.astro'
import PhoneLink from '@/components/ui/PhoneLink.astro'
import {phoneText} from '@/lib/phone'
import {SOCIAL_ICONS} from '@/lib/socialIcons'
import {CONTENT_WIDTH} from '@/lib/maxWidth'
import type {SiteSettings} from '@/types/sanity'
import {homePath, t} from '@/lib/i18n'
import {currentAttrs, navMatcher} from '@/lib/nav'

interface Props {
  settings: SiteSettings | null
}

const {settings} = Astro.props

// Same content width as the header, so the two line up.
const maxWidthClass = CONTENT_WIDTH

const siteName = settings?.siteName || 'Page Builder'
const logo = settings?.footerLogo?.asset ? settings.footerLogo : undefined
// Only a dedicated Footer Logo, shown as uploaded; without one the footer
// shows the site name instead.

// Site Settings → Branding, shared with the header and every Phone block.
const phone = settings?.phone
const phoneDisplay = phoneText({phone, phoneText: settings?.footerPhoneText})
const phoneLabel = settings?.footerPhoneLabel

const socialLinks = (settings?.socialLinks ?? []).filter(
  (link) => typeof link.platform === 'string' && link.platform.length > 0,
)
const nav = settings?.footerNav ?? []
const offices = settings?.footerOffices ?? []
const legalLinks = settings?.footerLegalLinks ?? []
// The page being viewed stays in the hover color, as in the header.
const {isCurrent} = navMatcher(Astro.originPathname)
const copyright = settings?.footerCopyright || `${siteName} © All Rights Reserved`

/** An office without its own link opens its address in Google Maps. */
const directionsHref = (office: (typeof offices)[number]) =>
  stegaClean(office.directionsUrl) ||
  (office.address
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(stegaClean(office.address) ?? '')}`
    : undefined)
---

<footer class="bg-foreground font-display text-white">
  <div class={`mx-auto ${maxWidthClass} px-4 py-12 md:px-8`}>
    {/* Stacked on phones: logo, phone, social. From tablet (md) up, one row:
        phone, logo, social — the logo's order-first only applies while
        stacked. Tablet draws the row a size smaller than desktop. */}
    <div
      class="flex flex-col items-center gap-8 text-center md:grid md:grid-cols-[1fr_auto_1fr] md:gap-6 md:text-left lg:gap-10"
    >
      <div>
        {phoneLabel && <p class="text-[15px] uppercase text-secondary-hover md:text-[13px] lg:text-[15px]">{phoneLabel}</p>}
        <PhoneLink
          phone={phone}
          text={phoneDisplay}
          class="text-3xl italic transition-colors md:text-xl lg:text-3xl"
        />
      </div>

      <a href={homePath(Astro.locals.language)} class="order-first flex w-full justify-center md:order-none md:w-auto">
        {
          logo?.asset ? (
            <SanityImage
              value={logo}
              alt={stegaClean(logo.alt) || siteName}
              width={800}
              class={`h-auto w-full md:h-8 md:w-auto lg:h-12`}
            />
          ) : (
            <span class="text-2xl font-bold">{siteName}</span>
          )
        }
      </a>

      {
        socialLinks.length > 0 && (
          <div class="flex gap-4 md:justify-end">
            {socialLinks.map((link) => {
              const platform = stegaClean(link.platform)!
              const path = SOCIAL_ICONS[platform]
              return (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={platform}
                  class="flex h-[42px] w-[42px] items-center justify-center rounded-full bg-secondary-hover text-foreground transition-colors hover:bg-white md:h-9 md:w-9 lg:h-[42px] lg:w-[42px]"
                >
                  {path ? (
                    <svg class="h-6 w-6 md:h-5 md:w-5 lg:h-6 lg:w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d={path} />
                    </svg>
                  ) : (
                    <span class="text-xs font-bold">{platform.slice(0, 2).toUpperCase()}</span>
                  )}
                </a>
              )
            })}
          </div>
        )
      }
    </div>

    {
      nav.length > 0 && (
        <nav class="mt-10 border-y border-primary py-4 lg:border-white/10" aria-label={t(Astro.locals.language, 'footer')}>
          <ul class="flex flex-wrap justify-center gap-x-5 gap-y-3 text-[15px] md:justify-around lg:justify-center lg:gap-x-20">
            {nav.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition-colors hover:text-secondary-hover data-current:text-secondary-hover"
                  {...currentAttrs(isCurrent(link.href))}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {/* Offices: one column on mobile (≤767px, the project's mobile breakpoint),
        five from there up. On tablet each address is centred vertically, so
        every Get Directions link lines up along the bottom of the row. */}
    {
      offices.length > 0 && (
        <div class="mt-10 grid grid-cols-1 gap-10 text-center md:grid-cols-5 md:text-left">
          {offices.map((office) => {
            const href = directionsHref(office)
            return (
              <div class="md:flex md:flex-col lg:block">
                <h3 class="text-xl font-semibold">{office.name}</h3>
                {office.address && (
                  <p class="mx-auto mt-4 w-fit whitespace-pre-line text-left text-[15px] hover:text-secondary-hover leading-relaxed md:mx-0 md:flex md:w-auto md:flex-1 md:items-center lg:block">
                    {office.address}
                  </p>
                )}
                {href && (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 inline-block text-[15px] text-secondary-hover transition-colors hover:text-white md:self-start"
                  >
                    {t(Astro.locals.language, 'getDirections')}
                  </a>
                )}
              </div>
            )
          })}
        </div>
      )
    }

    {
      (settings?.footerDisclaimerTitle || settings?.footerDisclaimer) && (
        <p class="mt-16 text-center text-[15px]">
          {settings.footerDisclaimerTitle && (
            <strong class="font-semibold">{settings.footerDisclaimerTitle}</strong>
          )}
          {settings.footerDisclaimerTitle && settings.footerDisclaimer && ' - '}
          {settings.footerDisclaimer}
        </p>
      )
    }

    <div
      class="mt-16 flex flex-col items-center gap-4 text-center text-[15px] md:flex-row md:justify-between md:text-left"
    >
      <p>{copyright}</p>
      {
        legalLinks.length > 0 && (
          <ul class="flex flex-wrap justify-center divide-x divide-secondary-hover/50">
            {legalLinks.map((link) => (
              <li class="px-5 first:pl-0 last:pr-0">
                <a
                  href={link.href}
                  class="transition-colors data-current:text-secondary-hover"
                  {...currentAttrs(isCurrent(link.href))}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
