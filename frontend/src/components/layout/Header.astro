---
import { stegaClean } from "@sanity/client/stega";
import SanityImage from "@/components/sanity/SanityImage.astro";
import { formatPhoneNumber } from "@/lib/formatPhoneNumber";
import type { SiteSettings, NavLink, NavDropdown } from "@/types/sanity";
import { getMaxWidthClass } from "@/lib/maxWidth";
import SearchOverlay from "@/components/search/SearchOverlay.astro";
import CaretDown from "@/components/icons/CaretDown.astro";

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;

// Same content width as the hero, so the logo and nav line up with it.
const maxWidthClass = getMaxWidthClass();

const siteName = settings?.siteName || "Page Builder";
const nav = settings?.mainNav ?? [];
const phone = settings?.phone;
// On unless an editor turned it off; older settings have no value yet.
const showSearch = settings?.headerSearch !== false;
const extraLink = settings?.headerExtraLink;

const CHEVRON_PATH = "M19 9l-7 7-7-7";
const CLOSE_PATH = "M6 18L18 6M6 6l12 12";
const BURGER_PATH = "M4 6h16M4 12h16M4 18h16";

const isDropdown = (item: (typeof nav)[number]): item is NavDropdown =>
  stegaClean(item._type) === "navDropdown";
---

<header>
  <div class="bg-header-banner py-4 flex items-center justify-center font-display text-sm sm:text-base md:text-xl font-normal uppercase leading-[30px] tracking-[0.09px] text-white flex-wrap gap-2 md:gap-4">
    <div>Free consultation 24/7</div>
    <div>
      <a href={`tel:${phone}`} class="text-md sm:text-lg md:text-2xl">
        (833) SANDERS
      </a>
    </div>
  </div>
  <div
    class="sticky top-0 z-50 border-b border-transparent bg-white backdrop-blur-md transition-all duration-200 px-4 py-2 md:px-8"
    data-header
  >
    <div
      class={`mx-auto flex h-16 ${maxWidthClass} items-center justify-between`}
    >
      {/* Logo */}
      <a href="/" class="flex items-center gap-2 font-bold text-lg">
        {settings?.logo?.asset ? (
          <SanityImage
            value={settings.logo}
            alt={stegaClean(settings.logo.alt) || siteName}
            width={300}
            quality={100}
            sizes="300px"
            priority
          />
        ) : (
          <span>{siteName}</span>
        )}
      </a>

      {/* Desktop nav. A dropdown opens on hover or keyboard focus; its label
          is a real link when it has one, and the chevron is a separate button
          so touch screens, which can't hover, can still open it. */}
      <nav class="hidden items-center gap-7 font-display lg:flex">
        {nav.map((item) =>
          isDropdown(item) ? (
            <div class="group relative" data-dropdown>
              <div class="flex items-center gap-2">
                {item.href ? (
                  <a
                    href={item.href}
                    class="py-2 text-[17px] text-foreground transition-colors hover:text-secondary-hover"
                  >
                    {item.label}
                  </a>
                ) : (
                  <span class="cursor-default py-2 text-[17px] text-foreground">{item.label}</span>
                )}
                <button
                  type="button"
                  class="p-1 text-secondary-hover"
                  data-dropdown-toggle
                  aria-expanded="false"
                  aria-label={`${stegaClean(item.label)} menu`}
                >
                  <CaretDown class="h-4 w-2.5" />
                </button>
              </div>

              {/* pt-2, not a margin: the gap stays inside the hover area, so
                  moving the pointer down to the menu doesn't close it. */}
              <div
                class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 group-data-[open]:visible group-data-[open]:opacity-100"
                data-dropdown-menu
              >
                <div class="w-64 border border-border bg-white p-2 shadow-lg">
                  {(item.items || []).map((child) => (
                    <a
                      href={child.href}
                      class="flex items-start gap-3 px-3 py-2.5 transition-colors hover:bg-foreground/5"
                    >
                      {child.icon?.asset && (
                        <SanityImage
                          value={child.icon}
                          alt=""
                          width={32}
                          height={32}
                          class="mt-0.5 h-5 w-5 shrink-0"
                        />
                      )}
                      <div>
                        <span class="block text-[15px] text-foreground">{child.label}</span>
                        {child.description && (
                          <span class="block text-xs text-muted">{child.description}</span>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={(item as NavLink).href}
              class={
                (item as NavLink).isButton
                  ? "rounded-full bg-foreground px-4 py-2 text-[15px] text-background transition-colors hover:bg-primary"
                  : "py-2 text-[17px] text-foreground transition-colors hover:text-secondary-hover"
              }
            >
              {(item as NavLink).label}
            </a>
          ),
        )}
      </nav>

      {/* Search and the extra link (e.g. Spanish) */}
      {(showSearch || extraLink?.href) && (
        <div class="hidden items-center gap-10 font-display lg:flex">
          {showSearch && (
            <button
              type="button"
              data-search-open
              aria-label="Search"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-white transition-colors hover:bg-secondary-hover"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={3} aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path stroke-linecap="round" d="M20 20l-3.5-3.5" />
              </svg>
            </button>
          )}
          {extraLink?.href && (
            <a href={extraLink.href} class="text-sm text-foreground transition-colors hover:text-secondary-hover">
              {extraLink.label}
            </a>
          )}
        </div>
      )}

      {/* Mobile toggle */}
      <div class="flex items-center gap-2 lg:hidden">
        <button
          type="button"
          class="inline-flex items-center justify-center rounded-lg p-2 text-foreground/70 hover:bg-foreground/5"
          data-mobile-toggle
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <span data-icon-burger>
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width={2}
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d={BURGER_PATH}
              />
            </svg>
          </span>
          <span data-icon-close hidden>
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width={2}
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d={CLOSE_PATH}
              />
            </svg>
          </span>
        </button>
      </div>
    </div>

    {/* Mobile nav */}
    <nav
      class="border-t border-border px-4 py-4 lg:hidden"
      data-mobile-nav
      hidden
    >
      <div class="flex flex-col gap-1">
        {nav.map((item) =>
          isDropdown(item) ? (
            <div data-mobile-dropdown>
              <div class="flex items-center justify-between">
              {item.href ? (
                <a
                  href={item.href}
                  class="flex-1 rounded-lg px-4 py-2.5 text-sm font-medium text-foreground/80 hover:bg-foreground/5"
                >
                  {item.label}
                </a>
              ) : (
                <span class="flex-1 px-4 py-2.5 text-sm font-medium text-foreground/80">{item.label}</span>
              )}
              <button
                type="button"
                class="rounded-lg p-3 text-foreground/80 hover:bg-foreground/5"
                data-mobile-dropdown-toggle
                aria-expanded="false"
                aria-label={`${stegaClean(item.label)} menu`}
              >
                <svg
                  class="h-3 w-3 transition-transform"
                  data-mobile-dropdown-chevron
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width={2}
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d={CHEVRON_PATH}
                  />
                </svg>
              </button>
              </div>
              <div
                class="ml-4 flex flex-col gap-0.5 border-l border-border pl-4"
                data-mobile-dropdown-menu
                hidden
              >
                {(item.items || []).map((child) => (
                  <a
                    href={child.href}
                    class="rounded-lg px-3 py-2 text-sm text-foreground/70 hover:bg-foreground/5 hover:text-foreground"
                  >
                    {child.label}
                    {child.description && (
                      <span class="block text-xs text-muted">
                        {child.description}
                      </span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={(item as NavLink).href}
              class={
                (item as NavLink).isButton
                  ? "rounded-full bg-foreground px-4 py-2.5 text-center text-sm font-medium text-background"
                  : "rounded-lg px-4 py-2.5 text-sm font-medium text-foreground/80 hover:bg-foreground/5"
              }
            >
              {(item as NavLink).label}
            </a>
          ),
        )}
        {showSearch && (
          <button type="button" data-search-open class="rounded-lg px-4 py-2.5 text-left text-sm font-medium text-foreground/80 hover:bg-foreground/5">
            Search
          </button>
        )}
        {extraLink?.href && (
          <a href={extraLink.href} class="rounded-lg px-4 py-2.5 text-sm font-medium text-foreground/80 hover:bg-foreground/5">
            {extraLink.label}
          </a>
        )}
      </div>
    </nav>
  </div>
</header>

{showSearch && (
  <SearchOverlay heading={settings?.searchHeading} placeholder={settings?.searchPlaceholder} />
)}

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  if (header) {
    const onScroll = () => {
      const scrolled = window.scrollY > 10;
      header.classList.toggle("border-border", scrolled);
      header.classList.toggle("bg-background/95", scrolled);
      header.classList.toggle("backdrop-blur-xl", scrolled);
      header.classList.toggle("shadow-sm", scrolled);
      header.classList.toggle("border-transparent", !scrolled);
      header.classList.toggle("bg-background/80", !scrolled);
      header.classList.toggle("backdrop-blur-md", !scrolled);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    // Mobile menu
    const mobileToggle = header.querySelector<HTMLButtonElement>(
      "[data-mobile-toggle]",
    );
    const mobileNav = header.querySelector<HTMLElement>("[data-mobile-nav]");
    const burger = header.querySelector<HTMLElement>("[data-icon-burger]");
    const close = header.querySelector<HTMLElement>("[data-icon-close]");

    mobileToggle?.addEventListener("click", () => {
      const open = mobileNav?.hidden ?? true;
      if (mobileNav) mobileNav.hidden = !open;
      if (burger) burger.toggleAttribute("hidden", open);
      if (close) close.toggleAttribute("hidden", !open);
      mobileToggle.setAttribute("aria-expanded", String(open));
    });

    // Closing the menu on navigation matters because these are real anchors,
    // not client-side routes — a back-navigation would otherwise restore it open.
    mobileNav?.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => {
        if (mobileNav) mobileNav.hidden = true;
        if (burger) burger.removeAttribute("hidden");
        if (close) close.setAttribute("hidden", "");
        mobileToggle?.setAttribute("aria-expanded", "false");
      }),
    );

    // Desktop dropdowns. Hover and focus are pure CSS; the chevron button
    // pins one open with data-open, for touch screens and keyboard users.
    const dropdowns = header.querySelectorAll<HTMLElement>("[data-dropdown]");

    const setOpen = (dropdown: HTMLElement, open: boolean) => {
      dropdown.toggleAttribute("data-open", open);
      dropdown
        .querySelector("[data-dropdown-toggle]")
        ?.setAttribute("aria-expanded", String(open));
    };
    const closeAll = (except?: HTMLElement) =>
      dropdowns.forEach((dropdown) => dropdown !== except && setOpen(dropdown, false));

    dropdowns.forEach((dropdown) => {
      dropdown
        .querySelector<HTMLButtonElement>("[data-dropdown-toggle]")
        ?.addEventListener("click", (event) => {
          event.stopPropagation();
          closeAll(dropdown);
          setOpen(dropdown, !dropdown.hasAttribute("data-open"));
        });
      // Leaving with the pointer ends a pinned-open state too, so a menu
      // opened by tap doesn't linger once hover takes over.
      dropdown.addEventListener("mouseleave", () => setOpen(dropdown, false));
    });

    document.addEventListener("mousedown", (event) => {
      if (!(event.target as HTMLElement).closest("[data-dropdown]")) closeAll();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeAll();
        (document.activeElement as HTMLElement | null)?.closest("[data-dropdown]") &&
          (document.activeElement as HTMLElement).blur();
      }
    });

    // Mobile dropdowns
    header
      .querySelectorAll<HTMLElement>("[data-mobile-dropdown]")
      .forEach((dropdown) => {
        const toggle = dropdown.querySelector<HTMLButtonElement>(
          "[data-mobile-dropdown-toggle]",
        );
        const menu = dropdown.querySelector<HTMLElement>(
          "[data-mobile-dropdown-menu]",
        );
        const chevron = dropdown.querySelector<SVGElement>(
          "[data-mobile-dropdown-chevron]",
        );

        toggle?.addEventListener("click", () => {
          const willOpen = menu?.hidden ?? true;
          if (menu) menu.hidden = !willOpen;
          toggle.setAttribute("aria-expanded", String(willOpen));
          chevron?.classList.toggle("rotate-180", willOpen);
        });
      });
  }
</script>
