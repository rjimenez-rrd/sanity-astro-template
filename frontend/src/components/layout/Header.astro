---
/**
 * The site header: the phone strip, then a sticky bar with the logo, the menu
 * (DesktopNav from lg up, MobileNav below), search and the language link.
 */
import {stegaClean} from '@sanity/client/stega'
import SanityImage from '@/components/sanity/SanityImage.astro'
import SearchOverlay from '@/components/search/SearchOverlay.astro'
import TopBar from '@/components/layout/header/TopBar.astro'
import DesktopNav from '@/components/layout/header/DesktopNav.astro'
import HeaderActions from '@/components/layout/header/HeaderActions.astro'
import MobileNav from '@/components/layout/header/MobileNav.astro'
import {CONTENT_WIDTH} from '@/lib/maxWidth'
import {DEFAULT_LANGUAGE, homePath} from '@/lib/i18n'
import type {SiteSettings} from '@/types/sanity'

interface Props {
  settings: SiteSettings | null
}

const {settings} = Astro.props

const siteName = settings?.siteName || 'Page Builder'
const nav = settings?.mainNav ?? []
// On unless an editor turned it off; older settings have no value yet.
const showSearch = settings?.headerSearch !== false
const language = Astro.locals.language ?? DEFAULT_LANGUAGE
---

<header>
  <TopBar settings={settings} />
  <div
    class="sticky top-0 z-50 border-b border-transparent bg-white backdrop-blur-md transition-all duration-200 px-4 py-2 md:px-8"
    data-header
  >
    {/* CONTENT_WIDTH, so the logo and nav line up with the page. */}
    <div class={`mx-auto flex h-16 ${CONTENT_WIDTH} items-center justify-between`}>
      <a href={homePath(language)} class="flex items-center gap-2 font-bold text-lg">
        {settings?.logo?.asset ? (
          <SanityImage
            value={settings.logo}
            alt={stegaClean(settings.logo.alt) || siteName}
            width={300}
            quality={100}
            sizes="(max-width: 639px) 190px, 300px"
            class="h-auto w-[190px] sm:w-[300px]"
            priority
          />
        ) : (
          <span>{siteName}</span>
        )}
      </a>

      <DesktopNav nav={nav} />
      <HeaderActions settings={settings} showSearch={showSearch} />
    </div>

    <MobileNav nav={nav} />
  </div>
</header>

{showSearch && (
  <SearchOverlay heading={settings?.searchHeading} placeholder={settings?.searchPlaceholder} />
)}

<script>
  // Once the page scrolls, the sticky bar gets a border, shadow and stronger blur.
  const header = document.querySelector<HTMLElement>('[data-header]')

  if (header) {
    const onScroll = () => {
      const scrolled = window.scrollY > 10
      header.classList.toggle('border-border', scrolled)
      header.classList.toggle('bg-background/95', scrolled)
      header.classList.toggle('backdrop-blur-xl', scrolled)
      header.classList.toggle('shadow-sm', scrolled)
      header.classList.toggle('border-transparent', !scrolled)
      header.classList.toggle('bg-background/80', !scrolled)
      header.classList.toggle('backdrop-blur-md', !scrolled)
    }

    window.addEventListener('scroll', onScroll, {passive: true})
    onScroll()
  }
</script>
