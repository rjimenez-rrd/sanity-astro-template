---
import {stegaClean} from '@sanity/client/stega'
import SanityImage from '@/components/sanity/SanityImage.astro'
import {formatPhoneNumber} from '@/lib/formatPhoneNumber'
import type {SiteSettings, NavLink, NavDropdown} from '@/types/sanity'

interface Props {
  settings: SiteSettings | null
}

const {settings} = Astro.props

const siteName = settings?.siteName || 'Page Builder'
const nav = settings?.mainNav ?? []
const phone = settings?.phone

const CHEVRON_PATH = 'M19 9l-7 7-7-7'
const CLOSE_PATH = 'M6 18L18 6M6 6l12 12'
const BURGER_PATH = 'M4 6h16M4 12h16M4 18h16'

const isDropdown = (item: (typeof nav)[number]): item is NavDropdown =>
  stegaClean(item._type) === 'navDropdown'
---

<header
  class="sticky top-0 z-50 border-b border-transparent bg-background/80 backdrop-blur-md transition-all duration-200"
  data-header
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    {/* Logo */}
    <a href="/" class="flex items-center gap-2 font-bold text-lg">
      {
        settings?.logo?.asset ? (
          <SanityImage
            value={settings.logo}
            alt={stegaClean(settings.logo.alt) || siteName}
            width={355}
            priority
          />
        ) : (
          <span>{siteName}</span>
        )
      }
    </a>

    {/* Desktop nav */}
    <nav class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) =>
          isDropdown(item) ? (
            <div class="relative" data-dropdown>
              <button
                type="button"
                class="flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-foreground/80 transition-colors hover:bg-foreground/5 hover:text-foreground"
                data-dropdown-toggle
                aria-expanded="false"
              >
                {item.label}
                <svg
                  class="h-3 w-3 transition-transform"
                  data-dropdown-chevron
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width={2}
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={CHEVRON_PATH} />
                </svg>
              </button>

              <div
                class="absolute left-0 top-full mt-1 w-64 rounded-xl border border-border bg-background p-2 shadow-lg"
                data-dropdown-menu
                hidden
              >
                {(item.items || []).map((child) => (
                  <a
                    href={child.href}
                    class="flex items-start gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-foreground/5"
                  >
                    {child.icon?.asset && (
                      <SanityImage
                        value={child.icon}
                        alt=""
                        width={32}
                        height={32}
                        class="mt-0.5 h-5 w-5 shrink-0"
                      />
                    )}
                    <div>
                      <span class="block text-sm font-medium text-foreground">{child.label}</span>
                      {child.description && (
                        <span class="block text-xs text-muted">{child.description}</span>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={(item as NavLink).href}
              class={
                (item as NavLink).isButton
                  ? 'ml-2 rounded-full bg-foreground px-4 py-2 text-sm font-medium text-background transition-colors hover:bg-foreground/90'
                  : 'rounded-lg px-3 py-2 text-sm font-medium text-foreground/80 transition-colors hover:bg-foreground/5 hover:text-foreground'
              }
            >
              {(item as NavLink).label}
            </a>
          ),
        )
      }
    </nav>

    {/* Mobile toggle */}
    <div class="flex items-center gap-2 md:hidden">
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-lg p-2 text-foreground/70 hover:bg-foreground/5"
        data-mobile-toggle
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span data-icon-burger>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
            <path stroke-linecap="round" stroke-linejoin="round" d={BURGER_PATH} />
          </svg>
        </span>
        <span data-icon-close hidden>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
            <path stroke-linecap="round" stroke-linejoin="round" d={CLOSE_PATH} />
          </svg>
        </span>
      </button>
    </div>
  </div>

  {/* Mobile nav */}
  <nav class="border-t border-border px-4 py-4 md:hidden" data-mobile-nav hidden>
    <div class="flex flex-col gap-1">
      {
        nav.map((item) =>
          isDropdown(item) ? (
            <div data-mobile-dropdown>
              <button
                type="button"
                class="flex w-full items-center justify-between rounded-lg px-4 py-2.5 text-sm font-medium text-foreground/80 hover:bg-foreground/5"
                data-mobile-dropdown-toggle
                aria-expanded="false"
              >
                {item.label}
                <svg
                  class="h-3 w-3 transition-transform"
                  data-mobile-dropdown-chevron
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width={2}
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={CHEVRON_PATH} />
                </svg>
              </button>
              <div
                class="ml-4 flex flex-col gap-0.5 border-l border-border pl-4"
                data-mobile-dropdown-menu
                hidden
              >
                {(item.items || []).map((child) => (
                  <a
                    href={child.href}
                    class="rounded-lg px-3 py-2 text-sm text-foreground/70 hover:bg-foreground/5 hover:text-foreground"
                  >
                    {child.label}
                    {child.description && (
                      <span class="block text-xs text-muted">{child.description}</span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={(item as NavLink).href}
              class={
                (item as NavLink).isButton
                  ? 'rounded-full bg-foreground px-4 py-2.5 text-center text-sm font-medium text-background'
                  : 'rounded-lg px-4 py-2.5 text-sm font-medium text-foreground/80 hover:bg-foreground/5'
              }
            >
              {(item as NavLink).label}
            </a>
          ),
        )
      }
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')

  if (header) {
    const onScroll = () => {
      const scrolled = window.scrollY > 10
      header.classList.toggle('border-border', scrolled)
      header.classList.toggle('bg-background/95', scrolled)
      header.classList.toggle('backdrop-blur-xl', scrolled)
      header.classList.toggle('shadow-sm', scrolled)
      header.classList.toggle('border-transparent', !scrolled)
      header.classList.toggle('bg-background/80', !scrolled)
      header.classList.toggle('backdrop-blur-md', !scrolled)
    }

    window.addEventListener('scroll', onScroll, {passive: true})
    onScroll()

    // Mobile menu
    const mobileToggle = header.querySelector<HTMLButtonElement>('[data-mobile-toggle]')
    const mobileNav = header.querySelector<HTMLElement>('[data-mobile-nav]')
    const burger = header.querySelector<HTMLElement>('[data-icon-burger]')
    const close = header.querySelector<HTMLElement>('[data-icon-close]')

    mobileToggle?.addEventListener('click', () => {
      const open = mobileNav?.hidden ?? true
      if (mobileNav) mobileNav.hidden = !open
      if (burger) burger.toggleAttribute('hidden', open)
      if (close) close.toggleAttribute('hidden', !open)
      mobileToggle.setAttribute('aria-expanded', String(open))
    })

    // Closing the menu on navigation matters because these are real anchors,
    // not client-side routes — a back-navigation would otherwise restore it open.
    mobileNav?.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        if (mobileNav) mobileNav.hidden = true
        if (burger) burger.removeAttribute('hidden')
        if (close) close.setAttribute('hidden', '')
        mobileToggle?.setAttribute('aria-expanded', 'false')
      }),
    )

    // Desktop dropdowns
    const dropdowns = header.querySelectorAll<HTMLElement>('[data-dropdown]')

    const closeAll = (except?: HTMLElement) => {
      dropdowns.forEach((dropdown) => {
        if (dropdown === except) return
        dropdown.querySelector<HTMLElement>('[data-dropdown-menu]')!.hidden = true
        dropdown.querySelector('[data-dropdown-toggle]')!.setAttribute('aria-expanded', 'false')
        dropdown.querySelector('[data-dropdown-chevron]')!.classList.remove('rotate-180')
      })
    }

    dropdowns.forEach((dropdown) => {
      const toggle = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-toggle]')
      const menu = dropdown.querySelector<HTMLElement>('[data-dropdown-menu]')
      const chevron = dropdown.querySelector<SVGElement>('[data-dropdown-chevron]')

      toggle?.addEventListener('click', (event) => {
        event.stopPropagation()
        const willOpen = menu?.hidden ?? true
        closeAll(dropdown)
        if (menu) menu.hidden = !willOpen
        toggle.setAttribute('aria-expanded', String(willOpen))
        chevron?.classList.toggle('rotate-180', willOpen)
      })
    })

    document.addEventListener('mousedown', (event) => {
      if (!(event.target as HTMLElement).closest('[data-dropdown]')) closeAll()
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAll()
    })

    // Mobile dropdowns
    header.querySelectorAll<HTMLElement>('[data-mobile-dropdown]').forEach((dropdown) => {
      const toggle = dropdown.querySelector<HTMLButtonElement>('[data-mobile-dropdown-toggle]')
      const menu = dropdown.querySelector<HTMLElement>('[data-mobile-dropdown-menu]')
      const chevron = dropdown.querySelector<SVGElement>('[data-mobile-dropdown-chevron]')

      toggle?.addEventListener('click', () => {
        const willOpen = menu?.hidden ?? true
        if (menu) menu.hidden = !willOpen
        toggle.setAttribute('aria-expanded', String(willOpen))
        chevron?.classList.toggle('rotate-180', willOpen)
      })
    })
  }
</script>
