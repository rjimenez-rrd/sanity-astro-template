---
import { stegaClean } from "@sanity/client/stega";
import SanityImage from "@/components/sanity/SanityImage.astro";
import { formatPhoneNumber } from "@/lib/formatPhoneNumber";
import type { SiteSettings, NavLink, NavDropdown } from "@/types/sanity";
import { getMaxWidthClass } from "@/lib/maxWidth";
import SearchOverlay from "@/components/search/SearchOverlay.astro";
import CaretDown from "@/components/icons/CaretDown.astro";

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;

// Same content width as the hero, so the logo and nav line up with it.
const maxWidthClass = getMaxWidthClass();

const siteName = settings?.siteName || "Page Builder";
const nav = settings?.mainNav ?? [];
const phone = settings?.phone;
// On unless an editor turned it off; older settings have no value yet.
const showSearch = settings?.headerSearch !== false;
const extraLink = settings?.headerExtraLink;

const CLOSE_PATH = "M6 18L18 6M6 6l12 12";
const BURGER_PATH = "M4 6h16M4 12h16M4 18h16";

const isDropdown = (item: (typeof nav)[number]): item is NavDropdown =>
  stegaClean(item._type) === "navDropdown";

/**
 * The page being viewed, so its menu item can stay highlighted in the hover
 * color. Trailing slashes are ignored, and only internal paths can match.
 */
const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
// originPathname, not url.pathname: a missing page is rewritten to /404, and
// the menu should still match the address the visitor actually opened.
const currentPath = normalize(Astro.originPathname);
const isCurrent = (href?: string | null) => {
  const clean = stegaClean(href);
  return Boolean(clean && clean.startsWith("/") && normalize(clean) === currentPath);
};
/**
 * A dropdown is current on its own page and on pages under its path
 * (/practice-areas/…), not merely because one of its links is open: a page
 * like /personal-injury highlights only its own link inside the dropdown.
 */
const dropdownIsCurrent = (item: NavDropdown) => {
  const own = stegaClean(item.href);
  if (!own?.startsWith("/")) return false;
  const base = normalize(own);
  return currentPath === base || (base !== "/" && currentPath.startsWith(`${base}/`));
};
/** Attributes for a current item: aria-current for links, data-current for styling. */
const current = (on: boolean, link = true) =>
  on ? { "data-current": "", ...(link ? { "aria-current": "page" as const } : {}) } : {};
---

<header>
  <div class="bg-header-banner py-4 flex items-center justify-center font-display text-sm sm:text-base md:text-xl font-normal uppercase leading-[30px] tracking-[0.09px] text-white flex-wrap gap-2 md:gap-4">
    <div>Free consultation 24/7</div>
    <div>
      <a href={`tel:${phone}`} class="text-md sm:text-lg md:text-2xl">
        (833) SANDERS
      </a>
    </div>
  </div>
  <div
    class="sticky top-0 z-50 border-b border-transparent bg-white backdrop-blur-md transition-all duration-200 px-4 py-2 md:px-8"
    data-header
  >
    <div
      class={`mx-auto flex h-16 ${maxWidthClass} items-center justify-between`}
    >
      {/* Logo */}
      <a href="/" class="flex items-center gap-2 font-bold text-lg">
        {settings?.logo?.asset ? (
          <SanityImage
            value={settings.logo}
            alt={stegaClean(settings.logo.alt) || siteName}
            width={300}
            quality={100}
            sizes="(max-width: 639px) 190px, 300px"
            class="h-auto w-[190px] sm:w-[300px]"
            priority
          />
        ) : (
          <span>{siteName}</span>
        )}
      </a>

      {/* Desktop nav. A dropdown opens on hover or keyboard focus; its label
          is a real link when it has one, and the chevron is a separate button
          so touch screens, which can't hover, can still open it. */}
      <nav class="hidden items-center gap-7 font-display lg:flex">
        {nav.map((item) =>
          isDropdown(item) ? (
            <div class="group relative" data-dropdown>
              <div class="flex items-center gap-2">
                {item.href ? (
                  <a
                    href={item.href}
                    class="py-2 text-[17px] text-foreground transition-colors hover:text-secondary-hover data-current:text-secondary-hover"
                    {...current(dropdownIsCurrent(item), isCurrent(item.href))}
                  >
                    {item.label}
                  </a>
                ) : (
                  <span
                    class="cursor-default py-2 text-[17px] text-foreground data-current:text-secondary-hover"
                    {...current(dropdownIsCurrent(item), false)}
                  >
                    {item.label}
                  </span>
                )}
                <button
                  type="button"
                  class="p-1 text-secondary-hover"
                  data-dropdown-toggle
                  aria-expanded="false"
                  aria-label={`${stegaClean(item.label)} menu`}
                >
                  <CaretDown class="h-4 w-2.5" />
                </button>
              </div>

              {/* pt-2, not a margin: the gap stays inside the hover area, so
                  moving the pointer down to the menu doesn't close it. */}
              <div
                class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 group-data-[open]:visible group-data-[open]:opacity-100"
                data-dropdown-menu
              >
                <div class="w-64 border border-border bg-white shadow-lg">
                  {(item.items || []).map((child) => (
                    <a
                      href={child.href}
                      class="group/child flex items-start gap-3 px-5 py-3 transition-colors hover:bg-header-banner data-current:bg-header-banner"
                      {...current(isCurrent(child.href))}
                    >
                      {child.icon?.asset && (
                        <SanityImage
                          value={child.icon}
                          alt=""
                          width={32}
                          height={32}
                          class="mt-0.5 h-5 w-5 shrink-0"
                        />
                      )}
                      <div>
                        <span class="block text-[15px] text-foreground transition-colors group-hover/child:text-white group-data-current/child:text-white">{child.label}</span>
                        {child.description && (
                          <span class="block text-xs text-muted transition-colors group-hover/child:text-white/80 group-data-current/child:text-white/80">{child.description}</span>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={(item as NavLink).href}
              class={
                (item as NavLink).isButton
                  ? "rounded-full bg-foreground px-4 py-2 text-[15px] text-background transition-colors hover:bg-primary"
                  : "py-2 text-[17px] text-foreground transition-colors hover:text-secondary-hover data-current:text-secondary-hover"
              }
              {...current(isCurrent((item as NavLink).href))}
            >
              {(item as NavLink).label}
            </a>
          ),
        )}
      </nav>

      {/* Right side: search and the extra link (e.g. Spanish) at every size,
          then the menu button below lg. */}
      <div class="flex items-center gap-4 sm:gap-7 lg:gap-10">
      {(showSearch || extraLink?.href) && (
        <div class="flex items-center gap-4 font-display sm:gap-7 lg:gap-10">
          {showSearch && (
            <button
              type="button"
              data-search-open
              aria-label="Search"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-white transition-colors hover:bg-secondary-hover"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={3} aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path stroke-linecap="round" d="M20 20l-3.5-3.5" />
              </svg>
            </button>
          )}
          {extraLink?.href && (
            <a href={extraLink.href} class="text-sm text-foreground transition-colors hover:text-secondary-hover sm:text-base lg:text-sm">
              {extraLink.label}
            </a>
          )}
        </div>
      )}

      {/* Mobile toggle */}
      <div class="flex items-center lg:hidden">
        <button
          type="button"
          class="-mr-2 inline-flex items-center justify-center rounded-lg p-2 text-primary transition-colors hover:text-secondary-hover"
          data-mobile-toggle
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <span data-icon-burger>
            <svg
              class="h-7 w-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width={3}
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d={BURGER_PATH}
              />
            </svg>
          </span>
          <span data-icon-close hidden>
            <svg
              class="h-7 w-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width={3}
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d={CLOSE_PATH}
              />
            </svg>
          </span>
        </button>
      </div>
      </div>
    </div>

    {/* Mobile nav: centered, one item per line. The negative margins cancel
        the header's side and bottom padding, so rows run edge to edge. Tapping
        a dropdown's row opens its links; tapping it again goes to its own Link. */}
    <nav
      class="-mx-4 -mb-2 border-t border-border py-3 font-display md:-mx-8 lg:hidden"
      data-mobile-nav
      hidden
    >
      <div class="flex flex-col items-center">
        {nav.map((item) =>
          isDropdown(item) ? (
            <div class="flex w-full flex-col items-center" data-mobile-dropdown>
              {/* The whole row is one button, edge to edge: the first tap
                  opens the links below; tapping it again while open goes to
                  the dropdown's own Link, or closes it when there is none. */}
              <button
                type="button"
                class="group/row flex w-full items-center justify-center gap-2 py-3 font-display text-[17px] text-foreground transition-colors hover:bg-header-banner hover:text-white active:bg-header-banner active:text-white aria-expanded:bg-header-banner aria-expanded:text-white data-current:bg-header-banner data-current:text-white"
                {...current(dropdownIsCurrent(item), false)}
                data-mobile-dropdown-toggle
                data-href={item.href ? stegaClean(item.href) : undefined}
                aria-expanded="false"
              >
                {item.label}
                <span
                  class="block p-1 text-secondary-hover transition-[color,transform] group-hover/row:text-white group-active/row:text-white group-aria-expanded/row:text-white group-data-current/row:text-white"
                  data-mobile-dropdown-chevron
                >
                  <CaretDown class="h-4 w-2.5" />
                </span>
              </button>
              <div
                class="flex w-full flex-col items-center bg-foreground/[0.03] py-1"
                data-mobile-dropdown-menu
                hidden
              >
                {(item.items || []).map((child) => (
                  <a
                    href={child.href}
                    class="w-full px-4 py-2.5 text-center text-[15px] text-foreground/80 transition-colors hover:bg-header-banner hover:text-white active:bg-header-banner active:text-white data-current:bg-header-banner data-current:text-white"
                    {...current(isCurrent(child.href))}
                  >
                    {child.label}
                    {child.description && (
                      <span class="block text-xs text-muted">{child.description}</span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={(item as NavLink).href}
              class={
                (item as NavLink).isButton
                  ? "my-2 rounded-full bg-foreground px-6 py-2.5 text-center text-[15px] text-background"
                  : "w-full px-4 py-3 text-center text-[17px] text-foreground transition-colors hover:bg-header-banner hover:text-white active:bg-header-banner active:text-white data-current:bg-header-banner data-current:text-white"
              }
              {...current(isCurrent((item as NavLink).href))}
            >
              {(item as NavLink).label}
            </a>
          ),
        )}
      </div>
    </nav>
  </div>
</header>

{showSearch && (
  <SearchOverlay heading={settings?.searchHeading} placeholder={settings?.searchPlaceholder} />
)}

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  if (header) {
    const onScroll = () => {
      const scrolled = window.scrollY > 10;
      header.classList.toggle("border-border", scrolled);
      header.classList.toggle("bg-background/95", scrolled);
      header.classList.toggle("backdrop-blur-xl", scrolled);
      header.classList.toggle("shadow-sm", scrolled);
      header.classList.toggle("border-transparent", !scrolled);
      header.classList.toggle("bg-background/80", !scrolled);
      header.classList.toggle("backdrop-blur-md", !scrolled);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    // Mobile menu
    const mobileToggle = header.querySelector<HTMLButtonElement>(
      "[data-mobile-toggle]",
    );
    const mobileNav = header.querySelector<HTMLElement>("[data-mobile-nav]");
    const burger = header.querySelector<HTMLElement>("[data-icon-burger]");
    const close = header.querySelector<HTMLElement>("[data-icon-close]");

    mobileToggle?.addEventListener("click", () => {
      const open = mobileNav?.hidden ?? true;
      if (mobileNav) mobileNav.hidden = !open;
      if (burger) burger.toggleAttribute("hidden", open);
      if (close) close.toggleAttribute("hidden", !open);
      mobileToggle.setAttribute("aria-expanded", String(open));
    });

    // Closing the menu on navigation matters because these are real anchors,
    // not client-side routes — a back-navigation would otherwise restore it open.
    mobileNav?.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => {
        if (mobileNav) mobileNav.hidden = true;
        if (burger) burger.removeAttribute("hidden");
        if (close) close.setAttribute("hidden", "");
        mobileToggle?.setAttribute("aria-expanded", "false");
      }),
    );

    // Desktop dropdowns. Hover and focus are pure CSS; the chevron button
    // pins one open with data-open, for touch screens and keyboard users.
    const dropdowns = header.querySelectorAll<HTMLElement>("[data-dropdown]");

    const setOpen = (dropdown: HTMLElement, open: boolean) => {
      dropdown.toggleAttribute("data-open", open);
      dropdown
        .querySelector("[data-dropdown-toggle]")
        ?.setAttribute("aria-expanded", String(open));
    };
    const closeAll = (except?: HTMLElement) =>
      dropdowns.forEach((dropdown) => dropdown !== except && setOpen(dropdown, false));

    dropdowns.forEach((dropdown) => {
      dropdown
        .querySelector<HTMLButtonElement>("[data-dropdown-toggle]")
        ?.addEventListener("click", (event) => {
          event.stopPropagation();
          closeAll(dropdown);
          setOpen(dropdown, !dropdown.hasAttribute("data-open"));
        });
      // Leaving with the pointer ends a pinned-open state too, so a menu
      // opened by tap doesn't linger once hover takes over.
      dropdown.addEventListener("mouseleave", () => setOpen(dropdown, false));
    });

    document.addEventListener("mousedown", (event) => {
      if (!(event.target as HTMLElement).closest("[data-dropdown]")) closeAll();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeAll();
        (document.activeElement as HTMLElement | null)?.closest("[data-dropdown]") &&
          (document.activeElement as HTMLElement).blur();
      }
    });

    // Mobile dropdowns
    header
      .querySelectorAll<HTMLElement>("[data-mobile-dropdown]")
      .forEach((dropdown) => {
        const toggle = dropdown.querySelector<HTMLButtonElement>(
          "[data-mobile-dropdown-toggle]",
        );
        const menu = dropdown.querySelector<HTMLElement>(
          "[data-mobile-dropdown-menu]",
        );
        const chevron = dropdown.querySelector<HTMLElement>(
          "[data-mobile-dropdown-chevron]",
        );

        toggle?.addEventListener("click", () => {
          const willOpen = menu?.hidden ?? true;
          // Already open, and the dropdown has a page of its own: go there.
          const href = toggle.dataset.href;
          if (!willOpen && href) {
            window.location.href = href;
            return;
          }
          if (menu) menu.hidden = !willOpen;
          toggle.setAttribute("aria-expanded", String(willOpen));
          chevron?.classList.toggle("rotate-180", willOpen);
        });
      });
  }
</script>
