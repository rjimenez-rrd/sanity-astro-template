---
export const prerender = false

import NewsList from '@/components/news/NewsList.astro'
import {resolveNewsList} from '@/lib/news'
import {DEFAULT_LANGUAGE} from '@/lib/i18n'

// The English News list. Spanish: es/news/index.astro.
const {page, posts, settings} = await resolveNewsList(Astro, DEFAULT_LANGUAGE)
---

<NewsList page={page} posts={posts} settings={settings} language={DEFAULT_LANGUAGE} />
