---
export const prerender = false

import Site from '@/layouts/Site.astro'
import SectionRenderer from '@/components/page-builder/SectionRenderer.astro'
import {buildSeo} from '@/lib/seo'
import NewsCard from '@/components/news/NewsCard.astro'
import {getClient} from '@/sanity/lib/client'
import {sanityFetch} from '@/sanity/lib/live'
import {NEWS_LIST_QUERY, PAGE_QUERY, SITE_SETTINGS_QUERY} from '@/sanity/lib/queries'
import {CONTENT_WIDTH} from '@/lib/maxWidth'
import {DEFAULT_LANGUAGE} from '@/lib/i18n'
import type {PAGE_QUERY_RESULT} from '@/sanity/types.generated'

const client = getClient(Astro.locals.isDraft)

const [posts, settings, newsPages] = await Promise.all([
  sanityFetch(client, Astro.locals, NEWS_LIST_QUERY),
  sanityFetch(client, Astro.locals, SITE_SETTINGS_QUERY),
  sanityFetch(client, Astro.locals, PAGE_QUERY, {slug: 'news', language: DEFAULT_LANGUAGE}),
])

const maxWidthClass = CONTENT_WIDTH

// A top-level Studio page with the slug "news" replaces this built-in listing,
// so editors can build it like any other page and link to it with Internal
// Link. Pages called "news" under a Parent Page live elsewhere, so they don't.
const page = (newsPages as PAGE_QUERY_RESULT).find((candidate) => !candidate.parents?.some(Boolean))
const seo = page ? buildSeo(page.seo, {title: page.title}) : undefined
---

{
  page ? (
    <Site settings={settings} {...seo}>
      <SectionRenderer sections={page.pageBuilder} documentId={page._id} documentType={page._type} />
    </Site>
  ) : (
    <Site settings={settings} title="News">
      <section class={`mx-auto ${maxWidthClass} px-4 py-16 md:px-8`}>
        <h1 class="font-display text-4xl font-bold text-foreground md:text-5xl">News</h1>
        {
          posts.length > 0 ? (
            <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {posts.map((post) => (
                <NewsCard post={post} />
              ))}
            </div>
          ) : (
            <p class="mt-10 text-muted">No news yet.</p>
          )
        }
      </section>
    </Site>
  )
}
