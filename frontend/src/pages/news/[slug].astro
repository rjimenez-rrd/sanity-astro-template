---
export const prerender = false

import NewsPost from '@/components/news/NewsPost.astro'
import {resolveNewsPost} from '@/lib/news'
import {DEFAULT_LANGUAGE} from '@/lib/i18n'

// An English news post. Spanish: es/news/[slug].astro.
const found = await resolveNewsPost(Astro, Astro.params.slug, DEFAULT_LANGUAGE)
if (!found) return Astro.rewrite('/404')
---

<NewsPost post={found.post} settings={found.settings} language={DEFAULT_LANGUAGE} />
