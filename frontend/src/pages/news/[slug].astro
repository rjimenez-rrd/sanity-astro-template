---
export const prerender = false

import {stegaClean} from '@sanity/client/stega'
import Site from '@/layouts/Site.astro'
import SanityImage from '@/components/sanity/SanityImage.astro'
import SectionRenderer from '@/components/page-builder/SectionRenderer.astro'
import {getClient} from '@/sanity/lib/client'
import {sanityFetch} from '@/sanity/lib/live'
import {NEWS_POST_QUERY} from '@/sanity/lib/queries'
import {getSiteSettings} from '@/lib/siteSettings'
import {buildSeo} from '@/lib/seo'
import {DEFAULT_LANGUAGE} from '@/lib/i18n'

const {slug} = Astro.params
const client = getClient(Astro.locals.isDraft)

const [post, settings] = await Promise.all([
  sanityFetch(client, Astro.locals, NEWS_POST_QUERY, {slug, language: DEFAULT_LANGUAGE}),
  getSiteSettings(Astro.locals),
])

if (!post) return Astro.rewrite('/404')

// An unset SEO description falls back to the excerpt, then to nothing.
const seo = buildSeo(post.seo, {title: post.title, description: post.excerpt ?? undefined})

// Same reasoning as the card: read the date as a date, not a moment in local
// time, or a post dated the 6th shows as the 5th west of UTC.
const dateLabel = (() => {
  const raw = stegaClean(post.publishedAt)
  const match = raw && /^(\d{4})-(\d{2})-(\d{2})/.exec(raw)
  if (!match) return undefined
  const [, y, m, d] = match
  return new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(Date.UTC(Number(y), Number(m) - 1, Number(d))))
})()
---

<Site settings={settings} {...seo}>
  {/* The header keeps a reading width; the Page Builder below sizes itself,
      the same way it does on any page. */}
  <header class="mx-auto w-full max-w-3xl px-4 pt-16 pb-10 md:px-8">
    <a href="/news" class="text-sm font-medium text-primary hover:underline">← All news</a>

    <h1 class="mt-6 text-balance font-display text-4xl font-bold leading-tight text-primary md:text-5xl">
      {post.title}
    </h1>

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-foreground">
      {dateLabel && (
        <span class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-secondary-hover" aria-hidden="true" />
          <time datetime={stegaClean(post.publishedAt) ?? undefined}>{dateLabel}</time>
        </span>
      )}
      {post.category && (
        <span class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-secondary-hover" aria-hidden="true" />
          {post.category}
        </span>
      )}
    </div>

    {post.coverImage?.asset && (
      <div class="mt-10 overflow-hidden">
        <SanityImage
          value={post.coverImage}
          alt={stegaClean(post.coverImage.alt) || ''}
          width={1200}
          sizes="(max-width: 768px) 100vw, 768px"
          class="h-auto w-full"
          priority
        />
      </div>
    )}

  </header>

  {/* Only when there is something to show: SectionRenderer's "No sections
      yet" placeholder is meant for editors, not for a published article. */}
  {post.pageBuilder && post.pageBuilder.length > 0 && (
    <SectionRenderer
      sections={post.pageBuilder}
      documentId={post._id}
      documentType={post._type}
    />
  )}
</Site>
