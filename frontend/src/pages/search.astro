---
export const prerender = false

import SearchPage from '@/components/search/SearchPage.astro'
import {resolveSearch} from '@/lib/search'
import {DEFAULT_LANGUAGE} from '@/lib/i18n'

// English search, over English content. Spanish: es/search.astro.
const {q, results, settings} = await resolveSearch(Astro, DEFAULT_LANGUAGE)
---

<SearchPage q={q} results={results} settings={settings} language={DEFAULT_LANGUAGE} />
