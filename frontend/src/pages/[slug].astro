---
export const prerender = false

import Site from '@/layouts/Site.astro'
import SectionRenderer from '@/components/page-builder/SectionRenderer.astro'
import {buildSeo} from '@/lib/seo'
import {DEFAULT_LANGUAGE} from '@/lib/i18n'
import {loadPage} from '@/lib/pageRoute'

// A page in the default language. Other languages: es/[slug].astro.
const {slug} = Astro.params
const {page, settings} = await loadPage(Astro, slug!, DEFAULT_LANGUAGE)

if (!page) return Astro.rewrite('/404')

const seo = buildSeo(page.seo, {title: page.title})
---

<Site settings={settings} {...seo}>
  <SectionRenderer
    sections={page.pageBuilder}
    documentId={page._id}
    documentType={page._type}
  />
</Site>
