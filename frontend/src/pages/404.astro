---
import Site from '@/layouts/Site.astro'
import {getSiteSettings} from '@/lib/siteSettings'
import {homePath, t} from '@/lib/i18n'

// On-demand, so the dynamic routes can Astro.rewrite() here for a missing
// slug — rewriting from an on-demand route to a prerendered one is forbidden.
export const prerender = false

// Draft-aware like every other page, so in Presentation the header and
// footer show the same unpublished settings as the page you came from; and in
// the language of the route that sent the visitor here (/es/… is Spanish).
// A route that rewrites here before loading its page (a bad /es/…/page/N),
// or a URL no route matches, hasn't set the language: take it from the
// address the visitor asked for.
const requested = Astro.originPathname ?? Astro.url.pathname
const language = Astro.locals.language ?? (/^\/es(\/|$)/.test(requested) ? 'es' : undefined)
Astro.locals.language = language
const settings = await getSiteSettings(Astro.locals, language)
Astro.response.status = 404
---

<Site settings={settings} title={t(language, 'pageNotFound')} noIndex>
  <div class="mx-auto flex min-h-[50vh] max-w-3xl flex-col items-center justify-center px-4 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-muted">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tighter text-foreground sm:text-4xl">
      {t(language, 'pageNotFound')}
    </h1>
    <p class="mt-3 text-base text-muted">
      {t(language, 'pageNotFoundText')}
    </p>
    <a
      href={homePath(language)}
      class="mt-8 inline-block rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition-colors hover:bg-foreground/90"
    >
      {t(language, 'backHome')}
    </a>
  </div>
</Site>
