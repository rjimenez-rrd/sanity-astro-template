---
export const prerender = false

import Site from '@/layouts/Site.astro'
import SectionRenderer from '@/components/page-builder/SectionRenderer.astro'
import {resolveHome} from '@/lib/pageRoute'
import {buildSeo} from '@/lib/seo'
import {DEFAULT_LANGUAGE} from '@/lib/i18n'

// The English home. Spanish: es/index.astro.
const {page, settings} = await resolveHome(Astro, DEFAULT_LANGUAGE)
const seo = buildSeo(page?.seo, {title: settings?.siteName || 'Home'})
---

<Site settings={settings} {...seo}>
  <SectionRenderer
    sections={page?.pageBuilder}
    documentId={page?._id}
    documentType={page?._type}
  />
</Site>
