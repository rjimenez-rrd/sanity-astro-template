---
export const prerender = false

import Site from '@/layouts/Site.astro'
import SectionRenderer from '@/components/page-builder/SectionRenderer.astro'
import {getClient} from '@/sanity/lib/client'
import {sanityFetch} from '@/sanity/lib/live'
import {HOME_PAGE_QUERY} from '@/sanity/lib/queries'
import {getSiteSettings} from '@/lib/siteSettings'
import {buildSeo} from '@/lib/seo'
import {DEFAULT_LANGUAGE, homePath, languageOf} from '@/lib/i18n'

// The English home. Spanish: es/index.astro.
const language = DEFAULT_LANGUAGE
const client = getClient(Astro.locals.isDraft)

const [page, settings] = await Promise.all([
  sanityFetch(client, Astro.locals, HOME_PAGE_QUERY, {language}),
  getSiteSettings(Astro.locals, language),
])

// The home in each language that has one: {en: '/', es: '/es'}.
Astro.locals.language = language
Astro.locals.alternates = Object.fromEntries(
  [language, ...(page?.translations ?? []).map((t) => languageOf(t?.language))].map((lang) => [
    lang,
    homePath(lang),
  ]),
)

const seo = buildSeo(page?.seo, {title: settings?.siteName || 'Home'})
---

<Site settings={settings} {...seo}>
  <SectionRenderer
    sections={page?.pageBuilder}
    documentId={page?._id}
    documentType={page?._type}
  />
</Site>
