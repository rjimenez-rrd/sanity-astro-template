---
export const prerender = false

import Site from '@/layouts/Site.astro'
import BlogCard from '@/components/blog/BlogCard.astro'
import {getClient} from '@/sanity/lib/client'
import {sanityFetch} from '@/sanity/lib/live'
import {BLOG_POSTS_QUERY, SITE_SETTINGS_QUERY} from '@/sanity/lib/queries'

const client = getClient(Astro.locals.isDraft)

const [posts, settings] = await Promise.all([
  sanityFetch(client, Astro.locals, BLOG_POSTS_QUERY),
  sanityFetch(client, Astro.locals, SITE_SETTINGS_QUERY),
])
---

<Site settings={settings} title="Blog" description="Latest articles and updates">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-12">
      <h1 class="text-3xl font-bold tracking-tighter text-foreground sm:text-4xl">Blog</h1>
      <p class="mt-2 text-base text-muted">Latest articles and updates</p>
    </div>

    {
      posts && posts.length > 0 ? (
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <p class="text-center text-muted">No posts yet.</p>
      )
    }
  </div>
</Site>
