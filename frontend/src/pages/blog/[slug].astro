---
export const prerender = false

import Site from '@/layouts/Site.astro'
import BlogPost from '@/components/blog/BlogPost.astro'
import {getClient} from '@/sanity/lib/client'
import {sanityFetch} from '@/sanity/lib/live'
import {BLOG_POST_QUERY, SITE_SETTINGS_QUERY} from '@/sanity/lib/queries'
import {buildSeo} from '@/lib/seo'

const {slug} = Astro.params
const client = getClient(Astro.locals.isDraft)

const [post, settings] = await Promise.all([
  sanityFetch(client, Astro.locals, BLOG_POST_QUERY, {slug}),
  sanityFetch(client, Astro.locals, SITE_SETTINGS_QUERY),
])

if (!post) return Astro.rewrite('/404')

const seo = buildSeo(post.seo, {title: post.title, description: post.excerpt})
---

<Site settings={settings} {...seo}>
  <BlogPost post={post} />
</Site>
