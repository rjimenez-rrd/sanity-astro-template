---
export const prerender = false

import Site from '@/layouts/Site.astro'
import SectionRenderer from '@/components/page-builder/SectionRenderer.astro'
import {resolveHome} from '@/lib/pageRoute'
import {buildSeo} from '@/lib/seo'

/**
 * The Spanish home: Home Page (Español), the Home Page's translation. Until
 * it exists, /es goes to the English home instead of a 404.
 */
const {page, settings} = await resolveHome(Astro, 'es')
if (!page) return Astro.redirect('/', 302)

const seo = buildSeo(page.seo, {title: settings?.siteName || 'Home'})
---

<Site settings={settings} {...seo}>
  <SectionRenderer
    sections={page.pageBuilder}
    documentId={page._id}
    documentType={page._type}
  />
</Site>
