---
/**
 * Page 2 onwards of a Spanish page's paginated card list: /es/<slug>/page/<n>.
 * Page 1 is /es/<slug> itself, served by ../../[slug].astro. English:
 * pages/[slug]/page/[page].astro, which this mirrors.
 *
 * The same page renders here; only Astro.locals.listPage differs, which the
 * list block reads to pick its slice. A path, not ?page=n, because Vercel's
 * ISR cache ignores query strings and would serve every page as page 1.
 */
export const prerender = false

import Site from '@/layouts/Site.astro'
import SectionRenderer from '@/components/page-builder/SectionRenderer.astro'
import {buildSeo} from '@/lib/seo'
import {localizedPath} from '@/lib/i18n'
import {loadPage} from '@/lib/pageRoute'
import {findPaginatedList, pageCount} from '@/lib/pagination'

const {slug, page: pageParam} = Astro.params

// Only canonical numbers: "2", never "02", "2.0" or "abc".
const n = Number(pageParam)
if (!Number.isInteger(n) || n < 1 || String(n) !== pageParam) return Astro.rewrite('/404')
// Only a real page slug (letters, numbers, hyphens) is ever redirected to,
// as in the English route.
if (!/^[a-z0-9-]+$/.test(slug ?? '')) return Astro.rewrite('/404')
// Page 1 has one address: the page's own URL.
if (n === 1) return Astro.redirect(localizedPath(slug!, 'es'), 301)

const {page, settings} = await loadPage(Astro, slug!, 'es')

// No such page, no paginated list on it, or past its last page.
const list = page ? findPaginatedList(page.pageBuilder) : undefined
if (!page || !list || n > pageCount(list.items, list.perPage)) return Astro.rewrite('/404')

Astro.locals.listPage = n

const seo = buildSeo(page.seo, {title: page.title})
// Each page gets its own title, so search results don't show five identical ones.
const title = seo.title ? `${seo.title} – Page ${n}` : `Page ${n}`
---

<Site settings={settings} {...seo} title={title}>
  <SectionRenderer
    sections={page.pageBuilder}
    documentId={page._id}
    documentType={page._type}
  />
</Site>
