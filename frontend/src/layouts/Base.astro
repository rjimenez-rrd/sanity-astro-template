---
import '@/styles/global.css'
import Animations from '@/components/layout/Animations.astro'
import {DEFAULT_LANGUAGE} from '@/lib/i18n'

interface Props {
  title?: string
  description?: string
  noIndex?: boolean
  ogImage?: string
}

const {
  title = 'Sanity Page Builder',
  description = 'The most complete open-source page builder for Sanity + Astro',
  noIndex = false,
  ogImage,
} = Astro.props

const language = Astro.locals.language ?? DEFAULT_LANGUAGE

/**
 * Only when the page exists in more than one language: tells search engines
 * each version is a translation of the others, so they show the right one per
 * visitor. x-default is the default-language version. Absolute URLs, as
 * hreflang requires.
 */
const alternates = Object.entries(Astro.locals.alternates ?? {})
const hreflang =
  alternates.length > 1
    ? [
        ...alternates.map(([lang, path]) => ({lang, href: new URL(path, Astro.site ?? Astro.url).href})),
        ...alternates
          .filter(([lang]) => lang === DEFAULT_LANGUAGE)
          .map(([, path]) => ({lang: 'x-default', href: new URL(path, Astro.site ?? Astro.url).href})),
      ]
    : []
---

<!doctype html>
<html lang={language} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {hreflang.map(({lang, href}) => <link rel="alternate" hreflang={lang} href={href} />)}
    <slot name="head" />
  </head>
  <body class="min-h-full flex flex-col bg-background text-foreground font-sans">
    <slot />
    <Animations />
  </body>
</html>
