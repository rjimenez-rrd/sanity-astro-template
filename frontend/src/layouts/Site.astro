---
import Base from './Base.astro'
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'
import VisualEditing from '@/components/sanity/VisualEditing.astro'
import SanityLive from '@/components/sanity/SanityLive.astro'
import type {SiteSettings} from '@/types/sanity'

interface Props {
  settings: SiteSettings | null
  title?: string
  description?: string
  noIndex?: boolean
  ogImage?: string
}

const {settings, ...seo} = Astro.props
const {isDraft} = Astro.locals
---

<Base {...seo}>
  <Header settings={settings} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer settings={settings} />
  {/* Drafts refresh through Presentation; published pages through the Live API. */}
  {isDraft ? <VisualEditing /> : <SanityLive tags={Astro.locals.syncTags} />}
</Base>
