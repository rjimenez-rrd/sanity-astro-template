---
/**
 * Design preview for the Rich Text block: every text style the editor offers,
 * from H1 down to Paragraph, each naming itself; then paragraphs with bold,
 * italic and a link, and a list, with hardcoded content.
 */
import Base from '@/layouts/Base.astro'
import BackToDev from '@/dev/BackToDev.astro'
import DataPanel from '@/dev/DataPanel.astro'
import RichText from '@/components/page-builder/blocks/RichText.astro'
import type {RichTextBlockData} from '@/types/sanity'

const span = (key: string, text: string, marks: string[] = []) => ({_type: 'span', _key: key, text, marks})

// Every style in the Studio's rich text (studio objects/rich-text.ts), top to bottom.
const styles = [
  ['h1', 'Heading 1 · h1'],
  ['h2', 'Heading 2 · h2'],
  ['h3', 'Heading 3 · h3'],
  ['h4', 'Heading 4 · h4'],
  ['blockquote', 'Quote · blockquote. A pulled-out line, set apart from the paragraphs around it.'],
  ['normal', 'Normal · normal. The default style for body text: a full sentence or two so the line length and spacing show.'],
  ['paragraph', 'Paragraph · paragraph. The larger body style, also used for lead-in text: a full sentence or two so the size difference from Normal shows.'],
].map(([style, text]) => ({_type: 'block', _key: `style-${style}`, style, markDefs: [], children: [span(`style-${style}-s`, text)]}))

const data = {
  _key: 'preview',
  _type: 'richTextBlock',
  content: [
    ...styles,
    {
      _type: 'block',
      _key: 'h',
      style: 'h2',
      markDefs: [],
      children: [span('h', 'Rich text, styled as prose')],
    },
    {
      _type: 'block',
      _key: 'p1',
      style: 'normal',
      markDefs: [{_type: 'link', _key: 'lnk', href: 'https://example.com'}],
      children: [
        span('a', 'Paragraphs take the prose styles. Some text is '),
        span('b', 'bold', ['strong']),
        span('c', ', some is '),
        span('d', 'italic', ['em']),
        span('e', ', and a '),
        span('f', 'link', ['lnk']),
        span('g', ' keeps its colour.'),
      ],
    },
    {
      _type: 'block',
      _key: 'h3',
      style: 'h3',
      markDefs: [],
      children: [span('h3', 'A smaller heading')],
    },
    {
      _type: 'block',
      _key: 'p2',
      style: 'normal',
      markDefs: [],
      children: [span('i', 'Lists work too, and the text wraps across the column width without any extra setup.')],
    },
    // Linked and plain items mixed, as on a practice area page.
    ...['Head-On Collision', 'Rear-End Collision', 'Vehicle Rollover', 'Taxi Cab Accidents'].map((text, i) => ({
      _type: 'block',
      _key: `li${i}`,
      style: 'normal',
      listItem: 'bullet',
      level: 1,
      markDefs: i === 1 ? [] : [{_type: 'link', _key: `l${i}`, href: '/new-york-car-accident-lawyer'}],
      children: [span(`li${i}s`, text, i === 1 ? [] : [`l${i}`])],
    })),
  ],
} as unknown as RichTextBlockData
---

<Base title="Rich Text — preview" noIndex>
  <main class="mx-auto w-full min-w-0 max-w-3xl px-4 py-16 sm:px-6">
    <BackToDev />
    <p class="mb-10 font-mono text-xs uppercase tracking-widest text-muted">
      Block preview · richTextBlock
    </p>
    <RichText data={data} />
    <DataPanel data={data} />
  </main>
</Base>
