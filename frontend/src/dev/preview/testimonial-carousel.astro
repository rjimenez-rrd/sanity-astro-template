---
/**
 * Design preview for the Testimonial Carousel block, with hardcoded content so
 * it can be worked on without editing a real page.
 *
 * Base rather than Site: it pulls in global.css and the animation runtime but
 * leaves out the header and footer, so the block is the only thing on screen.
 */
import Base from '@/layouts/Base.astro'
import BackToDev from '@/dev/BackToDev.astro'
import DataPanel from '@/dev/DataPanel.astro'
import TestimonialCarousel from '@/components/page-builder/blocks/TestimonialCarousel.astro'
import type {TestimonialCarouselData} from '@/types/sanity'

// Shaped like what GROQ returns for a testimonialCarousel once its reviews
// have been resolved from the Review documents.
const data = {
  _type: 'testimonialCarousel',
  title: 'What our clients say',
  perViewDesktop: 3,
  perViewTablet: 2,
  autoPlay: true,
  autoPlayInterval: 5,
  showDots: true,
  showArrows: true,
  // One long review per card width, so Show More appears, and one short one,
  // so it can be seen to stay hidden when the text fits.
  reviews: [
    {
      _id: 'preview-1',
      clientName: 'Karin C.',
      reviewText:
        'Always happy to work with this firm. They are caring, intelligent attorneys who fight for people’s rights. Their primary concern is to make sure their clients are treated fairly, and they kept me informed from the first call to the final settlement.',
      rating: 5,
    },
    {
      _id: 'preview-2',
      clientName: 'James O.',
      reviewText: 'Kept informed at every stage. No jargon, no chasing for updates.',
      rating: 5,
    },
    {
      _id: 'preview-3',
      clientName: 'Rachel K.',
      reviewText:
        'The insurer offered a fraction of what my injuries were worth. Sanders pushed back at every turn, took the time to explain each option, and we settled for eleven times the first offer. I cannot recommend them highly enough to anyone in a similar situation.',
      rating: 5,
    },
  ],
} as unknown as TestimonialCarouselData
---

<Base title="Testimonial Carousel — preview" noIndex>
  <main class="w-full min-w-0 px-4 py-16 sm:px-6" style="background:#eceef2">
    <div class="mx-auto max-w-6xl">
    <BackToDev />
    <p class="mb-10 font-mono text-xs uppercase tracking-widest text-muted">
      Block preview · testimonialCarousel
    </p>
    <TestimonialCarousel data={data} />
    <DataPanel data={data} open />

    </div>
  </main>
</Base>
