---
/**
 * Design preview for the Alert Notice block: one notice per type (info,
 * success, warning, error, tip), with and without a title, and one that can
 * be dismissed.
 */
import Base from '@/layouts/Base.astro'
import BackToDev from '@/dev/BackToDev.astro'
import DataPanel from '@/dev/DataPanel.astro'
import AlertNotice from '@/components/page-builder/blocks/AlertNotice.astro'
import type {AlertNoticeData} from '@/types/sanity'

const TYPES = ['info', 'success', 'warning', 'error', 'tip'] as const

const blocks = TYPES.map((type) => ({
  type,
  data: {
    _key: type,
    _type: 'alertNotice',
    type,
    title: `${type[0].toUpperCase()}${type.slice(1)} notice`,
    message: 'A short message the reader should see, in the notice’s own colours.',
  } as unknown as AlertNoticeData,
}))

const untitled = {
  _key: 'untitled',
  _type: 'alertNotice',
  type: 'info',
  message: 'A notice with no title, just the message.',
} as unknown as AlertNoticeData

const dismissible = {
  _key: 'dismissible',
  _type: 'alertNotice',
  type: 'warning',
  title: 'Dismissible',
  message: 'This one can be closed by the reader.',
  dismissible: true,
} as unknown as AlertNoticeData
---

<Base title="Alert Notice — preview" noIndex>
  <main class="mx-auto w-full min-w-0 max-w-3xl px-4 py-16 sm:px-6">
    <BackToDev />
    <p class="mb-10 font-mono text-xs uppercase tracking-widest text-muted">
      Block preview · alertNotice · one per type
    </p>
    {
      blocks.map((block) => (
        <section class="mb-12">
          <p class="mb-2 font-mono text-xs text-muted">Type: {block.type}</p>
          <AlertNotice data={block.data} />
          <DataPanel data={block.data} />
        </section>
      ))
    }
    <section class="mb-12">
      <p class="mb-2 font-mono text-xs text-muted">No title</p>
      <AlertNotice data={untitled} />
      <DataPanel data={untitled} />
    </section>
    <section class="mb-12">
      <p class="mb-2 font-mono text-xs text-muted">Dismissible</p>
      <AlertNotice data={dismissible} />
      <DataPanel data={dismissible} />
    </section>
  </main>
</Base>
