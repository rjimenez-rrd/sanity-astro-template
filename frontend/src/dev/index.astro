---
/**
 * Dev-only: the /dev index, linking every page in src/dev/routes.mjs — the
 * tools, then the block design previews. Registered with them by the
 * devRoutes integration in astro.config.mjs, so it exists only under
 * `astro dev`.
 */
export const prerender = false

import Base from '@/layouts/Base.astro'
import {DEV_PAGES} from './routes.mjs'

const groups = [
  {kind: 'tool', heading: 'Tools', intro: 'For finding your way around the code.', grid: false},
  {
    kind: 'preview',
    heading: 'Block previews',
    intro: 'Blocks rendered with hard-coded sample content, without the header and footer, to check a design without editing a real page.',
    grid: true,
  },
].map((group) => ({...group, pages: DEV_PAGES.filter((page) => page.kind === group.kind)}))
---

<Base title="Dev pages" noIndex>
  <main class="mx-auto w-full min-w-0 max-w-5xl px-4 py-16 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-widest text-muted">Local only · npm run dev</p>
    <h1 class="mt-3 font-display text-4xl font-bold">Dev pages</h1>
    <p class="mt-3 text-muted">
      These pages exist only on your dev server. Production builds leave them out. To add one, put its file in{' '}
      <code class="font-mono text-sm">src/dev/</code> and list it in{' '}
      <code class="font-mono text-sm">src/dev/routes.mjs</code>.
    </p>

    {
      groups.map((group) => (
        <section class="mt-12">
          <h2 class="font-display text-xl font-bold">{group.heading}</h2>
          <p class="mt-1 text-sm text-muted">{group.intro}</p>
          {/* Previews as a grid of equal-height cards; tools as one column. */}
          <ul class={`mt-4 grid gap-4 ${group.grid ? 'sm:grid-cols-2 lg:grid-cols-3' : ''}`}>
            {group.pages.map((page) => {
              const href = page.href ?? page.pattern
              return (
                <li class="flex min-w-0">
                  {/* Each card has its own border and background, so it can grow without
                      spilling onto its neighbours; transition-all eases the scale and
                      shadow in rather than snapping. */}
                  <a
                    href={href}
                    class="group flex w-full flex-col rounded-lg border border-border bg-card px-5 py-4 transition-all duration-200 ease-out hover:scale-[1.01] hover:border-primary/30 hover:shadow-lg focus-visible:scale-[1.01] focus-visible:shadow-lg focus-visible:outline-2 focus-visible:outline-primary motion-reduce:transition-none motion-reduce:hover:scale-100"
                  >
                    <span class="font-display font-semibold text-primary group-hover:underline">{page.title}</span>
                    <span class="mt-1 block text-sm text-foreground/80">{page.description}</span>
                    {/* mt-auto: the addresses line up along the bottom of every card in a row. */}
                    <span class="mt-auto block min-w-0 space-y-0.5 pt-4 font-mono text-xs text-muted">
                      <code class="block truncate" title={href}>{href}</code>
                      <code class="block truncate" title={`src/dev/${page.file}`}>src/dev/{page.file}</code>
                    </span>
                  </a>
                </li>
              )
            })}
          </ul>
        </section>
      ))
    }
  </main>
</Base>
