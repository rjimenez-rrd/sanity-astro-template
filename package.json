{
  "name": "sanity-page-builder",
  "description": "Page builder for Sanity + Astro \u2014 Elementor-style containers with responsive layout, style and visibility settings, 28 content blocks and visual editing.",
  "license": "MIT",
  "keywords": [
    "sanity",
    "sanity-template",
    "astro",
    "page-builder",
    "cms",
    "headless-cms",
    "visual-editing",
    "content-blocks"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:studio": "cd studio && npm run dev",
    "stop": "lsof -ti tcp:4321,3333 -sTCP:LISTEN | xargs kill 2>/dev/null; exit 0",
    "build": "npm-run-all build:*",
    "build:frontend": "cd frontend && npm run build",
    "build:studio": "cd studio && npm run build",
    "deploy:studio": "cd studio && sanity deploy",
    "validate": "sanity-template-validate",
    "seed": "cd frontend && npm run seed",
    "typegen": "cd studio && npx sanity schema extract --enforce-required-fields && npx sanity typegen generate"
  },
  "workspaces": [
    "frontend",
    "studio"
  ],
  "devDependencies": {
    "@sanity/template-validator": "^2",
    "npm-run-all": "^4.1.5",
    "vite": "^7.3.6"
  }
}
