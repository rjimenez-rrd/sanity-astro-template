{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "MIT",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "seed": "sanity dataset import seed/content.tar.gz --replace",
    "seed:export": "sanity exec scripts/seed-export.ts --with-user-token",
    "import:wp": "sanity exec scripts/import-wordpress.ts --with-user-token --",
    "import:wp:undo": "npm run import:wp -- --undo"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@portabletext/html": "^1.2.0",
    "@portabletext/sanity-bridge": "^3.2.5",
    "@sanity/color-input": "^6.0.4",
    "@sanity/document-internationalization": "^6.2.38",
    "@sanity/icons": "^3.7.4",
    "@sanity/table": "^2.0.1",
    "@sanity/ui": "^3.1.14",
    "@sanity/vision": "^5.31.1",
    "@uiw/react-codemirror": "^4.25.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^5.31.1",
    "sanity-plugin-media": "^4.1.1",
    "styled-components": "^6.3.12"
  },
  "devDependencies": {
    "@portabletext/schema": "^2.2.4",
    "@sanity/eslint-config-studio": "^5.0.1",
    "@types/react": "^19",
    "eslint": "^9.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.2",
    "typescript": "^5.1.6"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
